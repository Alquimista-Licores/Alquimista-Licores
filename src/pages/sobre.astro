---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Badge from '../components/Badge.astro';

const SECTIONS = [
  {
    title: "A Origem do Fogo",
    text: "Tudo começou com uma curiosidade genuína: como frutas, ervas e especiarias poderiam se transformar em algo que acolhe a alma? Na cozinha de casa, com um caderno de anotações e muita paciência, nasceram os primeiros experimentos.",
    image: "/assets/sobre-origem.jpg",
    alt: "Ingredientes naturais e preparo artesanal",
    reverse: false,
  },
  {
    title: "O Tempo como Ingrediente",
    text: "Não usamos atalhos. Cada poção passa por semanas — às vezes meses — de maceração e maturação lenta. O tempo não é um detalhe; é o ingrediente principal que extrai a essência pura de cada elemento.",
    image: "/assets/sobre-tempo.jpg",
    alt: "Garrafas e processo de maceração",
    reverse: true,
  },
  {
    title: "Feito à Mão, em Pequenos Lotes",
    text: "Produzimos em escala humana, em Criciúma/SC. Cada garrafa é envasada, rotulada e finalizada manualmente pelo próprio Alquimista. É assim que garantimos que nenhuma garrafa seja apenas mais uma.",
    image: "/assets/sobre-artesanal.jpg",
    alt: "Produção artesanal em pequenos lotes",
    reverse: false,
  },
];
---

<Layout
  title="O Alquimista — Nossa História & Filosofia"
  description="Conheça a história por trás dos licores artesanais do Alquimista. Produção manual, ingredientes naturais e a busca pelo extraordinário em Criciúma/SC."
>
  <div class="relative overflow-hidden">
    <!-- GLOWING ORBS IN BACKGROUND -->
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute top-[10%] left-[15%] w-96 h-96 rounded-full bg-[var(--gold)]/10 blur-3xl"></div>
      <div class="absolute top-[45%] right-[10%] w-[30rem] h-[30rem] rounded-full bg-[var(--amber-warm)]/10 blur-3xl"></div>
      <div class="absolute top-[80%] left-[20%] w-96 h-96 rounded-full bg-[var(--gold)]/10 blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto px-6 pb-24 relative">
      <PageHeader
        title="O Alquimista"
        subtitle="Ingredientes simples atravessando o ritual da transformação."
      />

      <!-- PROCESS PILLS -->
      <div class="flex flex-wrap justify-center items-center gap-3 mt-4 mb-12">
        <Badge variant="gold" symbol="🜚" tooltip="100% botânicos e ingredientes naturais">
          100% Orgânico
        </Badge>
        <Badge variant="dark" symbol="⚗" tooltip="Infusão de 40 dias sem aceleradores químicos">
          Maceração 40 Dias
        </Badge>
        <Badge variant="gold" symbol="👑" tooltip="Feito à mão em pequenos lotes numerados">
          Selo Real
        </Badge>
        <Badge variant="dark" symbol="❖" tooltip="Criciúma — Serra Catarinense">
          Serra Catarinense
        </Badge>
      </div>

      <!-- STORY SECTIONS / JORNADA -->
      <div id="jornada" class="space-y-24 md:space-y-36 mt-8 scroll-mt-28">
        {SECTIONS.map((s) => (
          <div class={`flex flex-col ${s.reverse ? "md:flex-row-reverse" : "md:flex-row"} gap-10 md:gap-16 items-center`}>
            <!-- VISUAL -->
            <div class="w-full md:w-1/2">
              <div class="overflow-hidden rounded-sm border border-[var(--gold)]/20 gold-glow bg-[var(--surface-elevated)] group">
                <img
                  src={s.image}
                  alt={s.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
                />
              </div>
            </div>

            <!-- TEXT -->
            <div class="w-full md:w-1/2 space-y-4 text-center md:text-left">
              <h2 class="text-3xl md:text-4xl text-[var(--gold)] tracking-wide font-medium">
                {s.title}
              </h2>
              <p class="font-body text-base md:text-lg leading-relaxed text-[var(--cream)]/90">
                {s.text}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- CENTERED HIGHLIGHT -->
      <div class="mt-28 md:mt-36 text-center">
        <div class="inline-block px-12 py-8 border border-[var(--gold)]/30 bg-[var(--surface)]/70 rounded-sm gold-glow">
          <p class="font-display text-3xl md:text-5xl text-[#D9C9B0] tracking-wider font-medium">
            Feito com (c)alma.
          </p>
        </div>
      </div>

      <!-- FINAL MANIFESTO -->
      <div class="mt-20 md:mt-28 mb-16 text-center max-w-3xl mx-auto">
        <div class="text-[var(--gold)]/50 text-2xl mb-6 font-serif">✦</div>
        <p class="font-sans italic text-lg md:text-2xl text-[var(--cream)]/90 leading-relaxed">
          <span class="text-[var(--gold)] text-3xl font-serif leading-none mr-1">“</span>
          No fim, talvez a alquimia não esteja na busca pelo ouro, mas na capacidade de transformar ingredientes simples em experiências memoráveis.
          <span class="text-[var(--gold)] text-3xl font-serif leading-none ml-1">”</span>
        </p>
      </div>
    </div>
  </div>
</Layout>
