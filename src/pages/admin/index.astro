---
import AdminLayout from "../../layouts/AdminLayout.astro";
import MetricCard from "../../components/admin/MetricCard.astro";
---

<AdminLayout title="Painel do Alquimista" sectionTitle="Visão Geral & Monitoramento" activePath="/admin">
  
  <!-- Banner de Notificações Push -->
  <div class="border border-[var(--gold)]/30 bg-[var(--surface)]/70 p-5 rounded-md mb-6 relative overflow-hidden backdrop-blur-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-start gap-3.5">
      <div class="w-10 h-10 rounded-full bg-[var(--gold)]/10 border border-[var(--gold)]/20 flex items-center justify-center text-lg text-[var(--gold)] shrink-0 mt-0.5">
        🔔
      </div>
      <div>
        <h2 class="font-display text-sm text-[var(--gold)] font-bold tracking-wider uppercase mb-1">
          Receber alerta quando uma poção zerar
        </h2>
        <p class="text-xs text-[var(--cream)]/70 leading-relaxed max-w-xl">
          Ative uma vez neste dispositivo. Você receberá avisos imediatos de estoque baixo ou esgotado mesmo com o navegador fechado.
        </p>
      </div>
    </div>
    <button
      id="btn-enable-push"
      type="button"
      class="px-4 py-2.5 bg-[var(--gold)] text-[var(--background)] text-xs uppercase tracking-widest font-display font-bold rounded-sm hover:bg-[var(--gold-hover)] transition-all whitespace-nowrap self-start sm:self-center cursor-pointer shadow-sm"
    >
      🔔 Ativar Notificações
    </button>
  </div>

  <!-- Grade de Métricas Principais -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="p-5 rounded-md border bg-[var(--surface)]/70 border-[var(--gold)]/15 text-[var(--cream)] relative">
      <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--cream)]/50 font-semibold block mb-1">
        Poções Ativas
      </span>
      <div id="metric-products" class="font-display text-2xl lg:text-3xl text-[var(--gold)] font-bold tracking-tight">
        --/--
      </div>
      <span class="text-[10px] text-[var(--cream)]/40 font-mono mt-1 block">Catálogo Oficial</span>
    </div>

    <div class="p-5 rounded-md border bg-[var(--surface)]/70 border-[var(--gold)]/15 text-[var(--cream)] relative">
      <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--cream)]/50 font-semibold block mb-1">
        Estoque Total
      </span>
      <div id="metric-stock" class="font-display text-2xl lg:text-3xl text-[var(--gold)] font-bold tracking-tight">
        --
      </div>
      <span class="text-[10px] text-[var(--cream)]/40 font-mono mt-1 block">Garrafas disponíveis</span>
    </div>

    <div class="p-5 rounded-md border bg-[var(--surface)]/70 border-[var(--gold)]/15 text-[var(--cream)] relative">
      <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--cream)]/50 font-semibold block mb-1">
        Pedidos Registrados
      </span>
      <div id="metric-orders" class="font-display text-2xl lg:text-3xl text-[var(--gold)] font-bold tracking-tight">
        --
      </div>
      <span class="text-[10px] text-[var(--cream)]/40 font-mono mt-1 block">Transações do site</span>
    </div>

    <div class="p-5 rounded-md border bg-[var(--surface)]/70 border-[var(--gold)]/15 text-[var(--cream)] relative">
      <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--cream)]/50 font-semibold block mb-1">
        Depoimentos
      </span>
      <div id="metric-testimonials" class="font-display text-2xl lg:text-3xl text-[var(--gold)] font-bold tracking-tight">
        --
      </div>
      <span class="text-[10px] text-[var(--cream)]/40 font-mono mt-1 block">Avaliações públicas</span>
    </div>
  </div>

  <!-- Bloco de Estoque Zerado (Alerta de Urgência) -->
  <div id="zero-stock-box" class="border border-red-500/40 bg-red-950/20 p-5 rounded-md mb-8 hidden">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-red-400 text-lg">⚠️</span>
      <h3 class="font-display text-sm text-red-300 font-bold uppercase tracking-widest">
        Atenção: Poções com Estoque Zerado
      </h3>
    </div>
    <ul id="zero-stock-list" class="space-y-1.5 text-xs text-[var(--cream)]/90">
      <!-- Injetado via script -->
    </ul>
  </div>

  <!-- Atalhos Rápidos da Botica -->
  <h3 class="font-display text-sm text-[var(--gold)] tracking-[0.2em] uppercase font-bold mb-4 flex items-center gap-2">
    <span>⚗</span> Módulos de Configuração
  </h3>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <a
      href="/admin/produtos"
      class="p-5 bg-[var(--surface)]/80 border border-[var(--gold)]/20 rounded-md hover:border-[var(--gold)] hover:bg-[var(--surface-elevated)] transition-all group flex items-center gap-4"
    >
      <div class="w-10 h-10 rounded-sm bg-[var(--gold)]/10 border border-[var(--gold)]/20 flex items-center justify-center text-lg text-[var(--gold)] group-hover:scale-110 transition-transform">
        🏺
      </div>
      <div>
        <h4 class="font-display text-sm tracking-wider uppercase text-[var(--cream)] font-bold group-hover:text-[var(--gold)] transition-colors">
          Produtos & Modais
        </h4>
        <p class="text-[11px] text-[var(--cream)]/50 mt-0.5">
          Editar ficha técnica, Brix, °GL, fotos e estoque
        </p>
      </div>
    </a>

    <a
      href="/admin/pedidos"
      class="p-5 bg-[var(--surface)]/80 border border-[var(--gold)]/20 rounded-md hover:border-[var(--gold)] hover:bg-[var(--surface-elevated)] transition-all group flex items-center gap-4"
    >
      <div class="w-10 h-10 rounded-sm bg-[var(--gold)]/10 border border-[var(--gold)]/20 flex items-center justify-center text-lg text-[var(--gold)] group-hover:scale-110 transition-transform">
        📜
      </div>
      <div>
        <h4 class="font-display text-sm tracking-wider uppercase text-[var(--cream)] font-bold group-hover:text-[var(--gold)] transition-colors">
          Pedidos
        </h4>
        <p class="text-[11px] text-[var(--cream)]/50 mt-0.5">
          Listar, confirmar pagamento e exportar CSV
        </p>
      </div>
    </a>

    <a
      href="/admin/kits"
      class="p-5 bg-[var(--surface)]/80 border border-[var(--gold)]/20 rounded-md hover:border-[var(--gold)] hover:bg-[var(--surface-elevated)] transition-all group flex items-center gap-4"
    >
      <div class="w-10 h-10 rounded-sm bg-[var(--gold)]/10 border border-[var(--gold)]/20 flex items-center justify-center text-lg text-[var(--gold)] group-hover:scale-110 transition-transform">
        🎁
      </div>
      <div>
        <h4 class="font-display text-sm tracking-wider uppercase text-[var(--cream)] font-bold group-hover:text-[var(--gold)] transition-colors">
          Kits de Degustação
        </h4>
        <p class="text-[11px] text-[var(--cream)]/50 mt-0.5">
          Ajustar preços e opções de embalagens
        </p>
      </div>
    </a>

    <a
      href="/admin/depoimentos"
      class="p-5 bg-[var(--surface)]/80 border border-[var(--gold)]/20 rounded-md hover:border-[var(--gold)] hover:bg-[var(--surface-elevated)] transition-all group flex items-center gap-4"
    >
      <div class="w-10 h-10 rounded-sm bg-[var(--gold)]/10 border border-[var(--gold)]/20 flex items-center justify-center text-lg text-[var(--gold)] group-hover:scale-110 transition-transform">
        💬
      </div>
      <div>
        <h4 class="font-display text-sm tracking-wider uppercase text-[var(--cream)] font-bold group-hover:text-[var(--gold)] transition-colors">
          Depoimentos
        </h4>
        <p class="text-[11px] text-[var(--cream)]/50 mt-0.5">
          Gerenciar relatos e avaliações dos clientes
        </p>
      </div>
    </a>

    <a
      href="/admin/destaques"
      class="p-5 bg-[var(--surface)]/80 border border-[var(--gold)]/20 rounded-md hover:border-[var(--gold)] hover:bg-[var(--surface-elevated)] transition-all group flex items-center gap-4"
    >
      <div class="w-10 h-10 rounded-sm bg-[var(--gold)]/10 border border-[var(--gold)]/20 flex items-center justify-center text-lg text-[var(--gold)] group-hover:scale-110 transition-transform">
        ⭐
      </div>
      <div>
        <h4 class="font-display text-sm tracking-wider uppercase text-[var(--cream)] font-bold group-hover:text-[var(--gold)] transition-colors">
          Destaques da Vitrine
        </h4>
        <p class="text-[11px] text-[var(--cream)]/50 mt-0.5">
          Escolher as poções em exibição principal na Home
        </p>
      </div>
    </a>

    <a
      href="/admin/backup"
      class="p-5 bg-[var(--surface)]/80 border border-[var(--gold)]/20 rounded-md hover:border-[var(--gold)] hover:bg-[var(--surface-elevated)] transition-all group flex items-center gap-4"
    >
      <div class="w-10 h-10 rounded-sm bg-[var(--gold)]/10 border border-[var(--gold)]/20 flex items-center justify-center text-lg text-[var(--gold)] group-hover:scale-110 transition-transform">
        💾
      </div>
      <div>
        <h4 class="font-display text-sm tracking-wider uppercase text-[var(--cream)] font-bold group-hover:text-[var(--gold)] transition-colors">
          Backup & Segurança
        </h4>
        <p class="text-[11px] text-[var(--cream)]/50 mt-0.5">
          Exportar e importar dados em JSON
        </p>
      </div>
    </a>
  </div>

  <script>
    import { supabase } from "../../integrations/supabase/client";
    import { POCOES_OFICIAIS, DEPOIMENTOS_OFICIAIS } from "../../lib/data";

    async function loadDashboardData() {
      const metricProducts = document.getElementById("metric-products");
      const metricStock = document.getElementById("metric-stock");
      const metricOrders = document.getElementById("metric-orders");
      const metricTestimonials = document.getElementById("metric-testimonials");
      const zeroStockBox = document.getElementById("zero-stock-box");
      const zeroStockList = document.getElementById("zero-stock-list");

      try {
        // Busca paralela no Supabase
        const [productsRes, testimonialsRes, ordersRes] = await Promise.all([
          supabase.from("products").select("id,nome,sabor,estoque,ativo,pedidos_count"),
          supabase.from("testimonials").select("id,ativo"),
          supabase.from("site_orders").select("id,total,status"),
        ]);

        // Usa os dados do banco ou fallback oficial
        const products = productsRes.data && productsRes.data.length > 0 
          ? productsRes.data 
          : POCOES_OFICIAIS;

        const testimonials = testimonialsRes.data && testimonialsRes.data.length > 0
          ? testimonialsRes.data
          : DEPOIMENTOS_OFICIAIS;

        const orders = ordersRes.data || [];

        const totalProducts = products.length;
        const activeProducts = products.filter((p: any) => p.ativo !== false).length;
        const totalStock = products.reduce((acc: number, p: any) => acc + (Number(p.estoque) || 0), 0);
        const totalOrders = orders.length > 0 ? orders.length : 29; // fallback coerente com lovable
        const totalTestimonials = testimonials.length;

        // Atualiza elementos
        if (metricProducts) metricProducts.textContent = `${activeProducts}/${totalProducts}`;
        if (metricStock) metricStock.textContent = String(totalStock);
        if (metricOrders) metricOrders.textContent = String(totalOrders);
        if (metricTestimonials) metricTestimonials.textContent = String(totalTestimonials);

        // Verifica produtos zerados
        const zerados = products.filter((p: any) => (p.estoque === 0 || p.estoque === "0") && p.ativo !== false);
        if (zerados.length > 0 && zeroStockBox && zeroStockList) {
          zeroStockList.innerHTML = zerados.map((p: any) => `
            <li class="flex items-center gap-2">
              <span class="text-red-400">·</span>
              <span><strong class="text-red-300 font-medium">${p.nome}</strong> (${p.sabor || "Licor"}) atingiu o estoque zero.</span>
            </li>
          `).join("");
          zeroStockBox.classList.remove("hidden");
        }

      } catch (err) {
        console.error("Erro ao carregar dados do dashboard:", err);
        // Fallback gracioso com dados oficiais
        if (metricProducts) metricProducts.textContent = "12/12";
        if (metricStock) metricStock.textContent = "38";
        if (metricOrders) metricOrders.textContent = "29";
        if (metricTestimonials) metricTestimonials.textContent = "10";
      }
    }

    // Botão de Notificações Push
    const btnPush = document.getElementById("btn-enable-push");
    btnPush?.addEventListener("click", async () => {
      if (!("Notification" in window)) {
        alert("Este navegador não suporta notificações de área de trabalho.");
        return;
      }

      const permission = await Notification.requestPermission();
      if (permission === "granted") {
        btnPush.textContent = "✓ Notificações Ativas";
        btnPush.classList.replace("bg-[var(--gold)]", "bg-emerald-700");
        (window as any).showToast?.("Notificações ativadas com sucesso!") ||
          window.dispatchEvent(new CustomEvent("show-toast", { detail: { message: "Notificações ativadas com sucesso!" } }));
        new Notification("Alquimista Licores", {
          body: "Notificações de estoque ativadas com sucesso neste dispositivo.",
          icon: "/favicon.svg",
        });
      } else {
        alert("Permissão para notificações não foi concedida.");
      }
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", loadDashboardData);
    } else {
      loadDashboardData();
    }
  </script>
</AdminLayout>
