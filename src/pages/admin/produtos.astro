---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Gestão de Produtos & Modais" sectionTitle="Catálogo Oficial de Poções" activePath="/admin/produtos">
  
  <!-- Barra de Ações Superiores -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-2 flex-wrap">
      <div class="relative">
        <input
          type="text"
          id="search-product"
          placeholder="Buscar poção pelo nome ou sabor..."
          class="bg-[var(--surface)] border border-[var(--gold)]/20 rounded-sm px-3.5 py-2 text-xs text-[var(--cream)] placeholder:text-[var(--cream)]/30 focus:border-[var(--gold)] outline-none w-64"
        />
      </div>

      <select
        id="filter-category"
        class="bg-[var(--surface)] border border-[var(--gold)]/20 rounded-sm px-3 py-2 text-xs text-[var(--cream)] focus:border-[var(--gold)] outline-none cursor-pointer"
      >
        <option value="todos">Todas as Categorias</option>
        <option value="fino">Licores Finos</option>
        <option value="cremoso">Licores Cremosos</option>
        <option value="especial">Série Especial</option>
      </select>
    </div>

    <button
      id="btn-new-product"
      type="button"
      class="px-4 py-2 bg-[var(--gold)] text-[var(--background)] font-display tracking-widest text-xs uppercase font-bold rounded-sm hover:bg-[var(--gold-hover)] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm self-start sm:self-auto"
    >
      <span>+</span> Nova Poção
    </button>
  </div>

  <!-- Tabela de Produtos Dark Luxury -->
  <div class="border border-[var(--gold)]/15 bg-[var(--surface)]/70 rounded-md overflow-hidden backdrop-blur-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-[var(--cream)]/80">
        <thead class="bg-[var(--surface-elevated)] border-b border-[var(--gold)]/15 text-[10px] uppercase font-display tracking-[0.2em] text-[var(--gold)]">
          <tr>
            <th class="py-3 px-4">Poção</th>
            <th class="py-3 px-4">Categoria</th>
            <th class="py-3 px-4">Preço</th>
            <th class="py-3 px-4">Estoque</th>
            <th class="py-3 px-4">Técnica (°GL / Brix)</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4 text-right">Ações</th>
          </tr>
        </thead>
        <tbody id="products-table-body" class="divide-y divide-[var(--gold)]/10 font-sans">
          <tr>
            <td colspan="7" class="py-8 text-center text-xs text-[var(--cream)]/50 font-mono">
              <span class="inline-block animate-spin mr-2">⚗</span> Consultando catálogo no Supabase...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Alquímico de Edição / Criação de Produto -->
  <div id="product-modal-backdrop" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden items-center justify-center p-3 sm:p-6 overflow-y-auto">
    <div class="bg-[var(--surface)] border border-[var(--gold)]/30 w-full max-w-4xl rounded-lg shadow-[0_10px_60px_rgba(0,0,0,0.95)] relative my-auto max-h-[92vh] flex flex-col overflow-hidden">
      
      <!-- Cabeçalho do Modal -->
      <div class="px-6 py-4.5 border-b border-[var(--gold)]/20 flex items-center justify-between shrink-0 bg-[var(--surface-elevated)]/90 backdrop-blur-sm">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-[var(--gold)]/10 border border-[var(--gold)]/30 flex items-center justify-center text-lg text-[var(--gold)] shrink-0">
            ⚗
          </div>
          <div>
            <h3 id="modal-title" class="font-display text-base sm:text-lg text-[var(--gold)] font-bold uppercase tracking-wider">
              Editar Poção
            </h3>
            <p class="text-[11px] text-[var(--cream)]/50 font-mono">
              Configurações vitais, estoque integrado e ficha técnica alquímica
            </p>
          </div>
        </div>
        <button
          id="btn-close-modal"
          class="w-8 h-8 rounded-full border border-[var(--gold)]/20 text-[var(--cream)]/60 hover:text-[var(--gold)] hover:border-[var(--gold)]/50 hover:bg-[var(--gold)]/10 flex items-center justify-center text-sm transition-all cursor-pointer"
          title="Fechar modal (Esc)"
        >
          ✕
        </button>
      </div>

      <!-- Barra de Controle Rápido dos Menus Recolhíveis -->
      <div class="px-6 py-2.5 bg-[var(--background)]/90 border-b border-[var(--gold)]/15 flex items-center justify-between text-[11px] font-mono shrink-0">
        <span class="text-[var(--cream)]/50 flex items-center gap-2">
          <span>Organização em 4 seções</span>
          <span class="text-[var(--gold)]/40">•</span>
          <span class="text-[var(--gold)]/80 text-[10px]">Clique no título da seção para expandir ou recolher</span>
        </span>
        <button
          type="button"
          id="btn-toggle-all-sections"
          class="text-[10px] text-[var(--gold)] hover:text-[var(--gold-hover)] hover:underline flex items-center gap-1.5 cursor-pointer font-sans uppercase tracking-wider font-bold"
        >
          <span>Recolher todos</span>
        </button>
      </div>

      <!-- Formulário com Scroll Suave e Espaçamento Aprimorado -->
      <form id="product-form" class="p-6 sm:p-7 overflow-y-auto space-y-5 flex-1 text-xs custom-scrollbar">
        <input type="hidden" id="prod-id" name="id" />

        <!-- =================================================================== -->
        <!-- SEÇÃO 1: IDENTIFICAÇÃO DO PRODUTO (RECOLHÍVEL)                      -->
        <!-- =================================================================== -->
        <div class="border border-[var(--gold)]/25 rounded-md bg-[var(--surface-elevated)]/40 overflow-hidden transition-all duration-200 hover:border-[var(--gold)]/40">
          <button
            type="button"
            class="modal-section-toggle w-full px-5 py-3.5 flex items-center justify-between text-left bg-[var(--surface-elevated)]/80 hover:bg-[var(--gold)]/10 transition-colors cursor-pointer select-none"
            data-target="section-identificacao"
            aria-expanded="true"
          >
            <div class="flex items-center gap-3">
              <span class="w-7 h-7 rounded bg-[var(--gold)]/10 border border-[var(--gold)]/20 flex items-center justify-center text-sm text-[var(--gold)]">
                🏺
              </span>
              <div>
                <div class="font-display text-xs sm:text-sm text-[var(--gold)] font-bold uppercase tracking-widest flex items-center gap-2">
                  <span>1. Identificação da Poção</span>
                  <span class="text-[9px] text-emerald-400 font-mono px-1.5 py-0.2 bg-emerald-950/60 border border-emerald-500/30 rounded uppercase font-bold">Principal</span>
                </div>
                <div class="text-[10px] text-[var(--cream)]/50 font-mono">
                  Nome oficial, essência, categoria, preço de venda e volume
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2.5 text-[var(--gold)]">
              <span class="section-indicator text-[10px] font-mono text-[var(--cream)]/40 hidden sm:inline">Aberto</span>
              <span class="section-chevron text-xs transition-transform duration-300 transform">▲</span>
            </div>
          </button>

          <div id="section-identificacao" class="modal-section-content p-5 sm:p-6 space-y-4 border-t border-[var(--gold)]/15 bg-[var(--surface)]/50">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5">
              <div class="sm:col-span-2">
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Nome Oficial da Poção <span class="text-red-400">*</span>
                </label>
                <input
                  type="text"
                  id="prod-nome"
                  required
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all placeholder:text-[var(--cream)]/30"
                  placeholder="Ex: Poção da Prosperidade"
                />
              </div>
              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Sabor / Essência <span class="text-red-400">*</span>
                </label>
                <input
                  type="text"
                  id="prod-sabor"
                  required
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all placeholder:text-[var(--cream)]/30"
                  placeholder="Ex: Ouro (Fino)"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5 pt-1">
              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Categoria Alquímica <span class="text-red-400">*</span>
                </label>
                <select
                  id="prod-categoria"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all cursor-pointer"
                >
                  <option value="fino">Fino (Frutas & Especiarias)</option>
                  <option value="cremoso">Cremoso (Base Láctea Nobre)</option>
                  <option value="especial">Especial (Edições Limitadas)</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Preço Oficial (R$) <span class="text-red-400">*</span>
                </label>
                <input
                  type="number"
                  step="0.01"
                  id="prod-preco"
                  required
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all placeholder:text-[var(--cream)]/30 font-mono"
                  placeholder="125.00"
                />
              </div>
              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Volume da Garrafa (ml)
                </label>
                <input
                  type="number"
                  id="prod-volume"
                  value="750"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all placeholder:text-[var(--cream)]/30 font-mono"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- =================================================================== -->
        <!-- SEÇÃO 2: ESTOQUE & INTEGRAÇÃO GERENCIAPP (RECOLHÍVEL)               -->
        <!-- =================================================================== -->
        <div class="border border-[var(--gold)]/25 rounded-md bg-[var(--surface-elevated)]/40 overflow-hidden transition-all duration-200 hover:border-[var(--gold)]/40">
          <button
            type="button"
            class="modal-section-toggle w-full px-5 py-3.5 flex items-center justify-between text-left bg-[var(--surface-elevated)]/80 hover:bg-[var(--gold)]/10 transition-colors cursor-pointer select-none"
            data-target="section-estoque"
            aria-expanded="true"
          >
            <div class="flex items-center gap-3">
              <span class="w-7 h-7 rounded bg-[var(--gold)]/10 border border-[var(--gold)]/20 flex items-center justify-center text-sm text-[var(--gold)]">
                📦
              </span>
              <div>
                <div class="font-display text-xs sm:text-sm text-[var(--gold)] font-bold uppercase tracking-widest flex items-center gap-2">
                  <span>2. Estoque & Integração GerenciApp</span>
                  <span class="text-[9px] font-mono text-[var(--gold)]/80 px-1.5 py-0.2 bg-[var(--gold)]/10 border border-[var(--gold)]/25 rounded flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Conectado
                  </span>
                </div>
                <div class="text-[10px] text-[var(--cream)]/50 font-mono">
                  Sincronização em tempo real com o banco de pedidos e estoque
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2.5 text-[var(--gold)]">
              <span class="section-indicator text-[10px] font-mono text-[var(--cream)]/40 hidden sm:inline">Aberto</span>
              <span class="section-chevron text-xs transition-transform duration-300 transform">▲</span>
            </div>
          </button>

          <div id="section-estoque" class="modal-section-content p-5 sm:p-6 space-y-4 border-t border-[var(--gold)]/15 bg-[var(--surface)]/50">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Tipo de Controle de Estoque
                </label>
                <select
                  id="prod-stock-control-type"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all cursor-pointer"
                >
                  <option value="manual">Manual (Painel Web)</option>
                  <option value="gerenciapp">Automático (GerenciApp Supabase)</option>
                </select>
                <p class="text-[10px] text-[var(--cream)]/40 font-mono mt-1">
                  Automático consulta diretamente a tabela 'estoque' do GerenciApp
                </p>
              </div>

              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5 flex items-center justify-between">
                  <span>Código de Integração</span>
                  <span class="text-[9px] text-[var(--gold)] font-mono">GerenciApp</span>
                </label>
                <input
                  type="text"
                  id="prod-codigo-integracao"
                  list="gerenciapp-codes-list"
                  placeholder="Ex: LICOR-BANANA-500ML"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all font-mono placeholder:text-[var(--cream)]/30"
                />
                <datalist id="gerenciapp-codes-list"></datalist>
                <p class="text-[10px] text-[var(--cream)]/40 font-mono mt-1">
                  Código da variação correspondente no GerenciApp
                </p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5 pt-1">
              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5 flex items-center justify-between">
                  <span>Quantidade em Estoque</span>
                  <button
                    type="button"
                    id="btn-sync-gerenciapp-stock"
                    class="hidden text-[10px] text-[var(--gold)] hover:underline flex items-center gap-1 font-mono cursor-pointer"
                    title="Consultar estoque no GerenciApp agora"
                  >
                    <span>🔄</span> <span>Sincronizar agora</span>
                  </button>
                </label>
                <div class="relative">
                  <input
                    type="number"
                    id="prod-estoque"
                    min="0"
                    required
                    class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all font-mono"
                  />
                  <span id="stock-sync-indicator" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-emerald-400 font-mono pointer-events-none flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> GerenciApp
                  </span>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Ordem de Exibição na Vitrine
                </label>
                <input
                  type="number"
                  id="prod-ordem"
                  value="1"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all font-mono"
                />
                <p class="text-[10px] text-[var(--cream)]/40 font-mono mt-1">
                  1 = primeiro item na lista de poções
                </p>
              </div>
            </div>

            <!-- Feedback de Sincronização do GerenciApp -->
            <div id="gerenciapp-stock-status" class="hidden text-[11px] font-mono p-3 rounded bg-[var(--surface-elevated)] border border-[var(--gold)]/25 flex items-center justify-between">
              <span id="gerenciapp-status-text" class="flex items-center gap-2 text-[var(--cream)]/90 leading-relaxed"></span>
              <span id="gerenciapp-status-badge" class="text-[9px] uppercase px-2 py-0.5 rounded font-bold font-mono shrink-0 ml-3"></span>
            </div>

            <!-- Checkbox de Ativo -->
            <div class="pt-3 border-t border-[var(--gold)]/10 flex items-center gap-2.5">
              <input
                type="checkbox"
                id="prod-ativo"
                class="w-4 h-4 rounded border-[var(--gold)]/30 text-[var(--gold)] bg-[var(--background)] focus:ring-0 cursor-pointer"
              />
              <label for="prod-ativo" class="text-xs text-[var(--cream)]/85 cursor-pointer select-none">
                <strong>Produto Ativo</strong> (visível no catálogo, vitrines e montagem de kits no site)
              </label>
            </div>
          </div>
        </div>

        <!-- =================================================================== -->
        <!-- SEÇÃO 3: FICHA TÉCNICA & ALQUIMIA (RECOLHÍVEL)                      -->
        <!-- =================================================================== -->
        <div class="border border-[var(--gold)]/25 rounded-md bg-[var(--surface-elevated)]/40 overflow-hidden transition-all duration-200 hover:border-[var(--gold)]/40">
          <button
            type="button"
            class="modal-section-toggle w-full px-5 py-3.5 flex items-center justify-between text-left bg-[var(--surface-elevated)]/80 hover:bg-[var(--gold)]/10 transition-colors cursor-pointer select-none"
            data-target="section-ficha"
            aria-expanded="false"
          >
            <div class="flex items-center gap-3">
              <span class="w-7 h-7 rounded bg-[var(--gold)]/10 border border-[var(--gold)]/20 flex items-center justify-center text-sm text-[var(--gold)]">
                📜
              </span>
              <div>
                <div class="font-display text-xs sm:text-sm text-[var(--gold)] font-bold uppercase tracking-widest flex items-center gap-2">
                  <span>3. Ficha Técnica & Grimório</span>
                  <span class="text-[9px] text-[var(--gold)]/70 font-mono px-1.5 py-0.2 bg-[var(--gold)]/10 border border-[var(--gold)]/20 rounded">Modal do Cliente</span>
                </div>
                <div class="text-[10px] text-[var(--cream)]/50 font-mono">
                  Graduação (°GL), densidade (Brix), maceração, notas sensoriais e rituais
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2.5 text-[var(--gold)]">
              <span class="section-indicator text-[10px] font-mono text-[var(--cream)]/40 hidden sm:inline">Recolhido</span>
              <span class="section-chevron text-xs transition-transform duration-300 transform -rotate-90">▲</span>
            </div>
          </button>

          <div id="section-ficha" class="modal-section-content hidden p-5 sm:p-6 space-y-4 border-t border-[var(--gold)]/15 bg-[var(--surface)]/50">
            <!-- Métricas Técnicas -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5">
              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Graduação Alcoólica (°GL)
                </label>
                <input
                  type="number"
                  step="0.1"
                  id="prod-graduacao"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all placeholder:text-[var(--cream)]/30 font-mono"
                  placeholder="Ex: 27.5"
                />
              </div>
              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Densidade & Doçura (Brix)
                </label>
                <input
                  type="number"
                  step="0.1"
                  id="prod-brix"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all placeholder:text-[var(--cream)]/30 font-mono"
                  placeholder="Ex: 32.0"
                />
              </div>
              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Dias de Maceração
                </label>
                <input
                  type="number"
                  id="prod-maceracao"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all placeholder:text-[var(--cream)]/30 font-mono"
                  placeholder="Ex: 40"
                  value="40"
                />
              </div>
            </div>

            <!-- Descrições Textuais e Rituais -->
            <div class="space-y-4 pt-2">
              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Notas Aromáticas & Perfil Sensorial
                </label>
                <input
                  type="text"
                  id="prod-notas"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all placeholder:text-[var(--cream)]/30"
                  placeholder="Ex: Baunilha, especiarias nobres, canela e toques florais"
                />
              </div>

              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Ingredientes Alquímicos
                </label>
                <textarea
                  id="prod-ingredientes"
                  rows="2"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all placeholder:text-[var(--cream)]/30 leading-relaxed"
                  placeholder="Ex: Álcool de cereais nobre, açúcar orgânico macerado, botânicos selecionados..."
                ></textarea>
              </div>

              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Sugestões de Degustação & Rituais de Consumo
                </label>
                <textarea
                  id="prod-sugestoes"
                  rows="2"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all placeholder:text-[var(--cream)]/30 leading-relaxed"
                  placeholder="Ex: Servir bem gelado em taça de cristal entre 10°C e 15°C..."
                ></textarea>
              </div>

              <div>
                <label class="block text-[11px] font-display uppercase tracking-wider text-[var(--gold-soft)] font-medium mb-1.5">
                  Descrição Poética & Filosofia da Criação
                </label>
                <textarea
                  id="prod-descricao"
                  rows="3"
                  class="w-full bg-[var(--background)] border border-[var(--gold)]/25 rounded-sm px-3.5 py-2.5 text-xs text-[var(--cream)] focus:border-[var(--gold)] focus:ring-1 focus:ring-[var(--gold)]/30 outline-none transition-all placeholder:text-[var(--cream)]/30 leading-relaxed"
                  placeholder="Manifesto ou história por trás da criação desta poção..."
                ></textarea>
              </div>
            </div>
          </div>
        </div>

        <!-- =================================================================== -->
        <!-- SEÇÃO 4: FOTOS & GALERIA DA POÇÃO (RECOLHÍVEL)                      -->
        <!-- =================================================================== -->
        <div class="border border-[var(--gold)]/25 rounded-md bg-[var(--surface-elevated)]/40 overflow-hidden transition-all duration-200 hover:border-[var(--gold)]/40">
          <button
            type="button"
            class="modal-section-toggle w-full px-5 py-3.5 flex items-center justify-between text-left bg-[var(--surface-elevated)]/80 hover:bg-[var(--gold)]/10 transition-colors cursor-pointer select-none"
            data-target="section-fotos"
            aria-expanded="false"
          >
            <div class="flex items-center gap-3">
              <span class="w-7 h-7 rounded bg-[var(--gold)]/10 border border-[var(--gold)]/20 flex items-center justify-center text-sm text-[var(--gold)]">
                🖼️
              </span>
              <div>
                <div class="font-display text-xs sm:text-sm text-[var(--gold)] font-bold uppercase tracking-widest flex items-center gap-2">
                  <span>4. Fotos & Galeria de Imagens</span>
                  <span class="text-[10px] text-[var(--cream)]/40 font-mono font-normal">⭐ Foto de Capa</span>
                </div>
                <div class="text-[10px] text-[var(--cream)]/50 font-mono">
                  Carregamento, definição de capa principal e carrossel
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2.5 text-[var(--gold)]">
              <span class="section-indicator text-[10px] font-mono text-[var(--cream)]/40 hidden sm:inline">Recolhido</span>
              <span class="section-chevron text-xs transition-transform duration-300 transform -rotate-90">▲</span>
            </div>
          </button>

          <div id="section-fotos" class="modal-section-content hidden p-5 sm:p-6 space-y-5 border-t border-[var(--gold)]/15 bg-[var(--surface)]/50">
            <!-- Upload Drop Zone -->
            <div
              id="photo-dropzone"
              class="relative w-full p-6 sm:p-8 bg-[var(--surface)]/80 border-2 border-dashed border-[var(--gold)]/40 hover:border-[var(--gold)] rounded-md text-center cursor-pointer transition-all duration-300 hover:bg-[var(--gold)]/5 group flex flex-col items-center justify-center gap-3 select-none"
            >
              <input type="file" id="prod-fotos-file" multiple accept="image/*" class="hidden" />
              
              <div class="w-13 h-13 rounded-full bg-[var(--gold)]/10 border border-[var(--gold)]/30 flex items-center justify-center text-[var(--gold)] text-2xl group-hover:scale-110 group-hover:bg-[var(--gold)]/20 transition-all duration-300 shadow-[0_0_20px_rgba(200,169,126,0.2)] pointer-events-none">
                📤
              </div>
              
              <div class="pointer-events-none text-center">
                <p class="font-display text-xs sm:text-sm text-[var(--gold)] font-bold tracking-wider uppercase">
                  Clique para escolher fotos ou arraste as imagens aqui
                </p>
                <p class="text-[11px] text-[var(--cream)]/50 font-mono mt-1">
                  PNG, JPG, WEBP até 10MB · Múltiplos arquivos suportados
                </p>
              </div>

              <!-- Overlay de Hover Drag Ativo -->
              <div id="dropzone-drag-overlay" class="absolute inset-0 bg-[var(--background)]/90 border-2 border-[var(--gold)] rounded-md flex flex-col items-center justify-center gap-2 pointer-events-none opacity-0 transition-opacity duration-200 z-10">
                <span class="text-3xl animate-bounce">✨</span>
                <p class="font-display text-sm text-[var(--gold)] font-bold uppercase tracking-widest">
                  Solte as imagens para carregar
                </p>
              </div>
            </div>

            <!-- Status de Upload -->
            <div id="upload-status" class="hidden text-xs text-[var(--gold)] font-mono animate-pulse flex items-center gap-2 p-2 bg-[var(--gold)]/10 rounded border border-[var(--gold)]/20">
              <span class="inline-block animate-spin">⚗</span> Enviando imagem(ns) para o Supabase Storage...
            </div>

            <!-- Grid de Thumbnails da Galeria -->
            <div>
              <div class="text-[11px] uppercase font-mono tracking-wider text-[var(--cream)]/60 mb-2.5 flex items-center justify-between">
                <span>Fotos Cadastradas:</span>
                <span class="text-[10px] text-[var(--gold)]/70">Passe o mouse para definir como capa ou remover</span>
              </div>
              <div id="gallery-container" class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 min-h-[110px] border border-[var(--gold)]/15 p-3 rounded-md bg-[var(--background)]/70">
                <!-- Renderizado dinamicamente via JS -->
              </div>
            </div>

            <input type="hidden" id="prod-foto-url" />
          </div>
        </div>
      </form>

      <!-- Rodapé do Modal com Ações Fixas -->
      <div class="px-6 py-4 border-t border-[var(--gold)]/20 flex items-center justify-between shrink-0 bg-[var(--surface-elevated)]">
        <div class="text-[10px] text-[var(--cream)]/40 font-mono hidden sm:block">
          As alterações afetam o catálogo e a vitrine em tempo real
        </div>
        <div class="flex items-center gap-3 ml-auto">
          <button
            id="btn-cancel-modal"
            type="button"
            class="px-4 py-2.5 text-xs text-[var(--cream)]/70 hover:text-[var(--cream)] transition-colors cursor-pointer"
          >
            Cancelar
          </button>
          <button
            id="btn-save-product"
            type="button"
            class="px-6 py-2.5 bg-[var(--gold)] text-[var(--background)] font-display tracking-widest text-xs uppercase font-bold rounded-sm hover:bg-[var(--gold-hover)] transition-all cursor-pointer shadow-[0_0_15px_rgba(200,169,126,0.3)]"
          >
            Salvar no Supabase
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Script de CRUD de Produtos integrado com Supabase -->
  <script>
    import { supabase, supabaseGerenciador } from "../../integrations/supabase/client";
    import { POCOES_OFICIAIS, type Pocao } from "../../lib/data";

    let allProducts: any[] = [];
    let currentEditingProduct: any = null;
    let currentGallery: string[] = [];
    let currentCoverUrl: string = "";

    const tableBody = document.getElementById("products-table-body");
    const searchInput = document.getElementById("search-product") as HTMLInputElement;
    const filterCategory = document.getElementById("filter-category") as HTMLSelectElement;
    const modalBackdrop = document.getElementById("product-modal-backdrop");
    const modalTitle = document.getElementById("modal-title");
    const btnNewProduct = document.getElementById("btn-new-product");
    const btnCloseModal = document.getElementById("btn-close-modal");
    const btnCancelModal = document.getElementById("btn-cancel-modal");
    const btnSaveProduct = document.getElementById("btn-save-product");

    // Elementos de Estoque & Integração GerenciApp
    const stockControlType = document.getElementById("prod-stock-control-type") as HTMLSelectElement;
    const codigoIntegracaoInput = document.getElementById("prod-codigo-integracao") as HTMLInputElement;
    const prodEstoqueInput = document.getElementById("prod-estoque") as HTMLInputElement;
    const btnSyncStock = document.getElementById("btn-sync-gerenciapp-stock");
    const stockSyncIndicator = document.getElementById("stock-sync-indicator");
    const stockStatusBox = document.getElementById("gerenciapp-stock-status");
    const stockStatusText = document.getElementById("gerenciapp-status-text");
    const stockStatusBadge = document.getElementById("gerenciapp-status-badge");
    const datalistGerenciapp = document.getElementById("gerenciapp-codes-list");

    const fotosFileInput = document.getElementById("prod-fotos-file") as HTMLInputElement;
    const photoDropzone = document.getElementById("photo-dropzone");
    const dropzoneDragOverlay = document.getElementById("dropzone-drag-overlay");
    const uploadStatus = document.getElementById("upload-status");
    const galleryContainer = document.getElementById("gallery-container");
    const btnToggleAllSections = document.getElementById("btn-toggle-all-sections");
    const sectionToggles = document.querySelectorAll<HTMLElement>(".modal-section-toggle");

    // Controle de Seções Recolhíveis (Accordions) do Modal
    function setSectionState(toggleBtn: HTMLElement, isOpen: boolean) {
      const targetId = toggleBtn.getAttribute("data-target");
      if (!targetId) return;
      const content = document.getElementById(targetId);
      const chevron = toggleBtn.querySelector(".section-chevron");
      const indicator = toggleBtn.querySelector(".section-indicator");

      toggleBtn.setAttribute("aria-expanded", String(isOpen));
      if (content) {
        if (isOpen) {
          content.classList.remove("hidden");
        } else {
          content.classList.add("hidden");
        }
      }

      if (chevron) {
        if (isOpen) {
          chevron.classList.remove("-rotate-90");
        } else {
          chevron.classList.add("-rotate-90");
        }
      }

      if (indicator) {
        indicator.textContent = isOpen ? "Aberto" : "Recolhido";
      }
    }

    function toggleSection(toggleBtn: HTMLElement) {
      const isCurrentlyExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      setSectionState(toggleBtn, !isCurrentlyExpanded);
      updateToggleAllBtnLabel();
    }

    function updateToggleAllBtnLabel() {
      if (!btnToggleAllSections) return;
      const allToggles = Array.from(sectionToggles);
      const anyOpen = allToggles.some((t) => t.getAttribute("aria-expanded") === "true");
      btnToggleAllSections.innerHTML = anyOpen
        ? `<span>Recolher todos</span>`
        : `<span>Expandir todos</span>`;
    }

    sectionToggles.forEach((btn) => {
      btn.addEventListener("click", () => toggleSection(btn));
    });

    btnToggleAllSections?.addEventListener("click", () => {
      const allToggles = Array.from(sectionToggles);
      const anyOpen = allToggles.some((t) => t.getAttribute("aria-expanded") === "true");
      allToggles.forEach((t) => setSectionState(t, !anyOpen));
      updateToggleAllBtnLabel();
    });

    // Fechar modal ao clicar fora ou pressionar ESC
    modalBackdrop?.addEventListener("click", (e) => {
      if (e.target === modalBackdrop) closeModal();
    });
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modalBackdrop && !modalBackdrop.classList.contains("hidden")) {
        closeModal();
      }
    });

    // Formatador de Preço
    function fmtBRL(val: number) {
      return new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" }).format(val || 0);
    }

    async function fetchProducts() {
      try {
        const { data, error } = await supabase
          .from("products")
          .select("*")
          .order("ordem", { ascending: true });

        if (error || !data || data.length === 0) {
          console.warn("Usando catálogo local em memória...");
          allProducts = [...POCOES_OFICIAIS];
        } else {
          allProducts = data;
        }
      } catch (e) {
        console.error("Falha ao buscar produtos:", e);
        allProducts = [...POCOES_OFICIAIS];
      }

      renderTable();
    }

    function renderTable() {
      if (!tableBody) return;

      const q = searchInput?.value.toLowerCase().trim() || "";
      const cat = filterCategory?.value || "todos";

      const filtered = allProducts.filter((p) => {
        const matchesQuery = p.nome.toLowerCase().includes(q) || (p.sabor && p.sabor.toLowerCase().includes(q));
        const matchesCategory = cat === "todos" || p.categoria === cat;
        return matchesQuery && matchesCategory;
      });

      if (filtered.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="7" class="py-8 text-center text-xs text-[var(--cream)]/40 font-mono">
              Nenhuma poção encontrada com os filtros atuais.
            </td>
          </tr>
        `;
        return;
      }

      tableBody.innerHTML = filtered.map((p) => {
        const isZerado = p.estoque === 0 || p.estoque === "0";
        const isGerenciApp = p.stock_control_type === "gerenciapp";

        return `
          <tr data-id="${p.id}" class="product-row hover:bg-[var(--surface-elevated)]/60 transition-colors cursor-pointer group">
            <td class="py-3.5 px-4">
              <div class="flex items-center gap-3">
                <img 
                  src="${p.foto_url || '/favicon.svg'}" 
                  alt="${p.nome}" 
                  class="w-10 h-10 object-contain rounded-sm border border-[var(--gold)]/20 bg-black/40 p-0.5 group-hover:border-[var(--gold)]/60 transition-colors" 
                  onerror="this.src='/favicon.svg'"
                />
                <div>
                  <div class="font-display font-bold text-[var(--cream)] text-xs group-hover:text-[var(--gold)] transition-colors">${p.nome}</div>
                  <div class="text-[10px] text-[var(--gold)] font-mono">${p.sabor || '—'}</div>
                  ${p.codigo_integracao ? `<div class="text-[9px] text-[var(--cream)]/40 font-mono tracking-tight truncate max-w-[140px]" title="Código de Integração: ${p.codigo_integracao}">${p.codigo_integracao}</div>` : ''}
                </div>
              </div>
            </td>
            <td class="py-3.5 px-4">
              <span class="inline-block px-2 py-0.5 rounded-full text-[9px] uppercase font-mono tracking-wider ${
                p.categoria === 'cremoso' 
                  ? 'bg-amber-900/30 text-amber-300 border border-amber-500/20' 
                  : p.categoria === 'especial'
                  ? 'bg-purple-900/30 text-purple-300 border border-purple-500/20'
                  : 'bg-yellow-900/30 text-yellow-300 border border-yellow-500/20'
              }">
                ${p.categoria}
              </span>
            </td>
            <td class="py-3.5 px-4 font-mono text-[var(--cream)] font-medium">
              ${fmtBRL(p.preco)}
            </td>
            <td class="py-3.5 px-4">
              <div class="flex items-center gap-2">
                <span class="font-display font-bold ${isZerado ? 'text-red-400' : 'text-[var(--cream)]'}">
                  ${p.estoque} un
                </span>
                ${isZerado ? '<span class="text-[9px] bg-red-950 text-red-300 border border-red-500/30 px-1 py-0.5 rounded">Esgotado</span>' : ''}
                ${isGerenciApp ? `<span class="text-[9px] text-emerald-400 font-mono" title="Sincronizado via GerenciApp (${p.codigo_integracao || 'automático'})">⚡ GerenciApp</span>` : ''}
              </div>
            </td>
            <td class="py-3.5 px-4 font-mono text-[10px] text-[var(--cream)]/60">
              ${p.graduacao_gl ?? '—'}°GL / ${p.brix ?? '—'} Brix
            </td>
            <td class="py-3.5 px-4">
              <span class="inline-flex items-center gap-1.5 text-[10px]">
                <span class="w-2 h-2 rounded-full ${p.ativo !== false ? 'bg-emerald-500' : 'bg-zinc-600'}"></span>
                <span>${p.ativo !== false ? 'Ativo' : 'Inativo'}</span>
              </span>
            </td>
            <td class="py-3.5 px-4 text-right">
              <button 
                data-id="${p.id}" 
                class="btn-edit-prod px-3 py-1.5 border border-[var(--gold)]/30 text-[var(--gold)] group-hover:bg-[var(--gold)] group-hover:text-black rounded-sm text-[10px] uppercase font-display tracking-widest transition-all cursor-pointer"
              >
                Editar
              </button>
            </td>
          </tr>
        `;
      }).join("");

      // Bind clique na linha inteira do produto
      document.querySelectorAll(".product-row").forEach((row) => {
        row.addEventListener("click", (e) => {
          const id = (row as HTMLElement).getAttribute("data-id");
          const prod = allProducts.find((p) => String(p.id) === String(id));
          if (prod) openModal(prod);
        });
      });
    }

    // Renderiza os Thumbnails da Galeria de Fotos no Modal do Admin
    function renderGallery() {
      if (!galleryContainer) return;

      if (currentGallery.length === 0) {
        galleryContainer.innerHTML = `
          <div class="col-span-full py-6 text-center text-xs text-[var(--cream)]/40 font-mono">
            Nenhuma foto adicionada ainda. Arraste imagens para a área acima ou clique para carregar.
          </div>
        `;
        return;
      }

      galleryContainer.innerHTML = currentGallery.map((url, idx) => {
        const isCover = url === currentCoverUrl || (idx === 0 && !currentCoverUrl);
        return `
          <div class="relative group aspect-square rounded-sm overflow-hidden border ${
            isCover ? 'border-2 border-[var(--gold)] shadow-[0_0_15px_rgba(200,169,126,0.35)]' : 'border-[var(--gold)]/20 hover:border-[var(--gold)]/50'
          } bg-black/60">
            <img src="${url}" alt="Foto ${idx + 1}" class="w-full h-full object-cover" onerror="this.src='/favicon.svg'" />
            
            <!-- Badge de Capa -->
            ${isCover ? `
              <div class="absolute top-1.5 left-1.5 z-20 px-1.5 py-0.5 bg-[var(--gold)] text-[var(--background)] font-display font-bold text-[9px] uppercase tracking-wider rounded shadow-md flex items-center gap-1">
                ⭐ Capa
              </div>
            ` : ''}

            <!-- Botão de Remover X (Top Right) -->
            <button
              type="button"
              data-remove-url="${url}"
              class="btn-remove-photo absolute top-1.5 right-1.5 z-30 w-6 h-6 rounded-full bg-red-950/80 hover:bg-red-600 text-white font-bold text-xs flex items-center justify-center transition-all shadow-lg cursor-pointer"
              title="Remover Imagem"
            >
              ✕
            </button>

            <!-- Botão de Tornar Capa (Bottom Overlay) -->
            ${!isCover ? `
              <div class="absolute inset-x-0 bottom-0 p-1.5 bg-gradient-to-t from-black/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex justify-center z-20">
                <button
                  type="button"
                  data-set-cover="${url}"
                  class="btn-set-cover w-full py-1 bg-[var(--surface-elevated)] border border-[var(--gold)]/40 hover:bg-[var(--gold)] hover:text-black text-[var(--gold)] text-[9px] uppercase font-display font-bold tracking-wider rounded transition-all cursor-pointer shadow-md"
                >
                  ⭐ Tornar Capa
                </button>
              </div>
            ` : ''}
          </div>
        `;
      }).join("");

      // Bind dos botões X (Remover)
      galleryContainer.querySelectorAll(".btn-remove-photo").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const targetUrl = (e.currentTarget as HTMLElement).getAttribute("data-remove-url");
          if (targetUrl) {
            currentGallery = currentGallery.filter((u) => u !== targetUrl);
            if (currentCoverUrl === targetUrl) {
              currentCoverUrl = currentGallery.length > 0 ? currentGallery[0] : "";
            }
            renderGallery();
          }
        });
      });

      // Bind dos botões de Tornar Capa
      galleryContainer.querySelectorAll(".btn-set-cover").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const targetUrl = (e.currentTarget as HTMLElement).getAttribute("data-set-cover");
          if (targetUrl) {
            currentCoverUrl = targetUrl;
            // Move foto da capa para o inicio da sequencia
            currentGallery = [targetUrl, ...currentGallery.filter((u) => u !== targetUrl)];
            renderGallery();
          }
        });
      });
    }

    // Handler de Upload de Arquivos de Imagem
    async function handleFilesUpload(files: FileList) {
      if (!files || files.length === 0) return;
      if (uploadStatus) uploadStatus.classList.remove("hidden");

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const fileExt = file.name.split(".").pop() || "jpg";
        const fileName = `${Date.now()}-${Math.random().toString(36).substring(2, 8)}.${fileExt}`;
        const filePath = `${fileName}`;

        try {
          // Upload para o Bucket product-images no Supabase Storage
          const { data, error } = await supabase.storage
            .from("product-images")
            .upload(filePath, file, { cacheControl: "3600", upsert: true });

          if (error) throw error;

          const { data: publicData } = supabase.storage
            .from("product-images")
            .getPublicUrl(filePath);

          const publicUrl = publicData?.publicUrl || "";
          if (publicUrl && !currentGallery.includes(publicUrl)) {
            currentGallery.push(publicUrl);
            if (!currentCoverUrl) currentCoverUrl = publicUrl;
          }
        } catch (err: any) {
          console.warn("Falha no upload do Supabase Storage. Usando fallback de leitura local...", err);
          
          // Fallback resiliente usando FileReader DataURL
          const localUrl = await new Promise<string>((resolve) => {
            const reader = new FileReader();
            reader.onload = (e) => resolve(e.target?.result as string || "");
            reader.readAsDataURL(file);
          });

          if (localUrl && !currentGallery.includes(localUrl)) {
            currentGallery.push(localUrl);
            if (!currentCoverUrl) currentCoverUrl = localUrl;
          }
        }
      }

      if (uploadStatus) uploadStatus.classList.add("hidden");
      if (fotosFileInput) fotosFileInput.value = "";
      renderGallery();
    }

    fotosFileInput?.addEventListener("change", (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files.length > 0) handleFilesUpload(files);
    });

    if (photoDropzone) {
      photoDropzone.addEventListener("click", () => {
        fotosFileInput?.click();
      });

      ["dragenter", "dragover"].forEach((evtName) => {
        photoDropzone.addEventListener(evtName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (dropzoneDragOverlay) dropzoneDragOverlay.classList.remove("opacity-0");
          photoDropzone.classList.add("border-[var(--gold)]", "bg-[var(--gold)]/10");
        });
      });

      ["dragleave", "drop"].forEach((evtName) => {
        photoDropzone.addEventListener(evtName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (dropzoneDragOverlay) dropzoneDragOverlay.classList.add("opacity-0");
          photoDropzone.classList.remove("border-[var(--gold)]", "bg-[var(--gold)]/10");
        });
      });

      photoDropzone.addEventListener("drop", (e) => {
        const dt = (e as DragEvent).dataTransfer;
        const files = dt?.files;
        if (files && files.length > 0) {
          handleFilesUpload(files);
        }
      });
    }

    // Carrega Códigos e Variações do GerenciApp no Datalist
    async function loadGerenciappCodes() {
      try {
        const { data: variacoes } = await supabaseGerenciador
          .from("variacoes_produto")
          .select("id, nome, codigo_integracao, produto_id")
          .order("nome", { ascending: true });

        if (datalistGerenciapp && variacoes) {
          datalistGerenciapp.innerHTML = variacoes
            .filter((v: any) => v.codigo_integracao || v.nome)
            .map((v: any) => `<option value="${v.codigo_integracao || v.nome}">${v.nome} (${v.codigo_integracao || 'Sem código'})</option>`)
            .join("");
        }
      } catch (e) {
        console.warn("Aviso ao consultar variações do GerenciApp:", e);
      }
    }

    // Sincroniza Estoque em tempo real consultando a tabela 'estoque' do GerenciApp
    async function syncStockFromGerenciapp(forcedCode?: string) {
      const code = (forcedCode !== undefined ? forcedCode : codigoIntegracaoInput?.value || "").trim();
      const sabor = (document.getElementById("prod-sabor") as HTMLInputElement)?.value.trim() || "";
      const nome = (document.getElementById("prod-nome") as HTMLInputElement)?.value.trim() || "";

      if (!code && !sabor && !nome) {
        if (stockStatusBox) {
          stockStatusBox.classList.remove("hidden");
          if (stockStatusText) stockStatusText.innerHTML = "⚠️ Informe o <strong>Código de Integração</strong> para puxar o estoque do GerenciApp.";
          if (stockStatusBadge) {
            stockStatusBadge.textContent = "Aguardando Código";
            stockStatusBadge.className = "text-[9px] uppercase px-1.5 py-0.5 rounded font-bold font-mono bg-amber-950/80 text-amber-300 border border-amber-500/30";
          }
        }
        return;
      }

      if (stockStatusBox) {
        stockStatusBox.classList.remove("hidden");
        if (stockStatusText) stockStatusText.innerHTML = `<span class="inline-block animate-spin mr-1">⚗</span> Consultando tabela 'estoque' no GerenciApp...`;
        if (stockStatusBadge) {
          stockStatusBadge.textContent = "Consultando";
          stockStatusBadge.className = "text-[9px] uppercase px-1.5 py-0.5 rounded font-bold font-mono bg-blue-950 text-blue-300 border border-blue-500/30";
        }
      }

      try {
        let variacaoId: string | null = null;
        let produtoId: string | null = null;
        let matchLabel = "";

        // 1. Tenta buscar em variacoes_produto (onde os licores ficam com codigo_integracao ex: LICOR-BANANA-500ML ou nome)
        if (code) {
          const { data: vList } = await supabaseGerenciador
            .from("variacoes_produto")
            .select("id, nome, codigo_integracao, produto_id")
            .or(`codigo_integracao.eq.${code},nome.ilike.${code}`)
            .limit(1);

          if (vList && vList.length > 0) {
            variacaoId = vList[0].id;
            produtoId = vList[0].produto_id;
            matchLabel = vList[0].codigo_integracao || vList[0].nome;
          }
        }

        // 2. Se não achou por código estrito, tenta busca por aproximação no sabor ou código
        if (!variacaoId && (sabor || code)) {
          const searchTerm = code || sabor;
          const { data: vList2 } = await supabaseGerenciador
            .from("variacoes_produto")
            .select("id, nome, codigo_integracao, produto_id")
            .or(`codigo_integracao.ilike.%${searchTerm}%,nome.ilike.%${searchTerm}%`)
            .limit(1);

          if (vList2 && vList2.length > 0) {
            variacaoId = vList2[0].id;
            produtoId = vList2[0].produto_id;
            matchLabel = vList2[0].codigo_integracao || vList2[0].nome;
            if (codigoIntegracaoInput && !codigoIntegracaoInput.value && vList2[0].codigo_integracao) {
              codigoIntegracaoInput.value = vList2[0].codigo_integracao;
            }
          }
        }

        // 3. Se ainda não achou em variações, tenta na tabela produtos
        if (!variacaoId) {
          const searchTerm = code || nome || sabor;
          const { data: pList } = await supabaseGerenciador
            .from("produtos")
            .select("id, nome, sku")
            .or(`sku.eq.${searchTerm},nome.ilike.%${searchTerm}%`)
            .limit(1);

          if (pList && pList.length > 0) {
            produtoId = pList[0].id;
            matchLabel = pList[0].nome;
          }
        }

        // 4. Busca a quantidade na tabela estoque do GerenciApp
        let quantidadeEstoque: number | null = null;

        if (variacaoId) {
          const { data: estData } = await supabaseGerenciador
            .from("estoque")
            .select("quantidade")
            .eq("variacao_id", variacaoId)
            .maybeSingle();

          if (estData !== null && estData !== undefined) {
            quantidadeEstoque = Number(estData.quantidade);
          }
        } else if (produtoId) {
          const { data: estData } = await supabaseGerenciador
            .from("estoque")
            .select("quantidade")
            .eq("produto_id", produtoId)
            .is("variacao_id", null)
            .maybeSingle();

          if (estData !== null && estData !== undefined) {
            quantidadeEstoque = Number(estData.quantidade);
          }
        }

        if (quantidadeEstoque !== null) {
          if (prodEstoqueInput) {
            prodEstoqueInput.value = String(quantidadeEstoque);
          }
          if (stockStatusText) {
            stockStatusText.innerHTML = `✅ Estoque sincronizado de <strong>"${matchLabel}"</strong>: <strong>${quantidadeEstoque} unidades</strong>.`;
          }
          if (stockStatusBadge) {
            stockStatusBadge.textContent = "Sincronizado";
            stockStatusBadge.className = "text-[9px] uppercase px-1.5 py-0.5 rounded font-bold font-mono bg-emerald-950 text-emerald-300 border border-emerald-500/30";
          }
        } else {
          if (stockStatusText) {
            stockStatusText.innerHTML = `⚠️ Item <strong>"${code || sabor || nome}"</strong> não localizado na tabela de estoque do GerenciApp.`;
          }
          if (stockStatusBadge) {
            stockStatusBadge.textContent = "Não Encontrado";
            stockStatusBadge.className = "text-[9px] uppercase px-1.5 py-0.5 rounded font-bold font-mono bg-red-950 text-red-300 border border-red-500/30";
          }
        }
      } catch (err: any) {
        console.error("Erro ao sincronizar estoque do GerenciApp:", err);
        if (stockStatusText) stockStatusText.textContent = "Erro ao conectar com GerenciApp.";
        if (stockStatusBadge) {
          stockStatusBadge.textContent = "Erro Conexão";
          stockStatusBadge.className = "text-[9px] uppercase px-1.5 py-0.5 rounded font-bold font-mono bg-red-950 text-red-300 border border-red-500/30";
        }
      }
    }

    function updateStockControlUI() {
      const isGerenciApp = stockControlType?.value === "gerenciapp";
      if (isGerenciApp) {
        prodEstoqueInput?.setAttribute("readonly", "true");
        prodEstoqueInput?.classList.add("bg-[var(--surface-elevated)]", "text-emerald-400", "font-bold");
        stockSyncIndicator?.classList.remove("hidden");
        btnSyncStock?.classList.remove("hidden");
        syncStockFromGerenciapp();
      } else {
        prodEstoqueInput?.removeAttribute("readonly");
        prodEstoqueInput?.classList.remove("bg-[var(--surface-elevated)]", "text-emerald-400", "font-bold");
        stockSyncIndicator?.classList.add("hidden");
        btnSyncStock?.classList.add("hidden");
        if (stockStatusBox) stockStatusBox.classList.add("hidden");
      }
    }

    stockControlType?.addEventListener("change", updateStockControlUI);
    codigoIntegracaoInput?.addEventListener("change", () => {
      if (stockControlType?.value === "gerenciapp") syncStockFromGerenciapp();
    });
    btnSyncStock?.addEventListener("click", () => syncStockFromGerenciapp());

    function openModal(prod: any = null) {
      currentEditingProduct = prod;
      if (modalTitle) {
        modalTitle.textContent = prod ? `Editar Poção: ${prod.nome}` : "Nova Poção Alquímica";
      }

      // Define estado inicial dos accordions: para novo produto abre todos, para edição abre seções 1 e 2
      sectionToggles.forEach((btn) => {
        const target = btn.getAttribute("data-target");
        if (!prod) {
          // Novo produto: abre todos
          setSectionState(btn, true);
        } else {
          // Edição: seções 1 e 2 abertas, 3 e 4 recolhidas
          const shouldOpen = target === "section-identificacao" || target === "section-estoque";
          setSectionState(btn, shouldOpen);
        }
      });
      updateToggleAllBtnLabel();

      // Preenche os campos
      (document.getElementById("prod-id") as HTMLInputElement).value = prod?.id || "";
      (document.getElementById("prod-nome") as HTMLInputElement).value = prod?.nome || "";
      (document.getElementById("prod-sabor") as HTMLInputElement).value = prod?.sabor || "";
      (document.getElementById("prod-categoria") as HTMLSelectElement).value = prod?.categoria || "fino";
      (document.getElementById("prod-preco") as HTMLInputElement).value = prod?.preco ? String(prod.preco) : "";
      (document.getElementById("prod-volume") as HTMLInputElement).value = prod?.volume_ml ? String(prod.volume_ml) : "750";
      (document.getElementById("prod-estoque") as HTMLInputElement).value = prod?.estoque !== undefined ? String(prod.estoque) : "10";
      (document.getElementById("prod-stock-control-type") as HTMLSelectElement).value = prod?.stock_control_type || "manual";
      (document.getElementById("prod-codigo-integracao") as HTMLInputElement).value = prod?.codigo_integracao || "";
      (document.getElementById("prod-ordem") as HTMLInputElement).value = prod?.ordem !== undefined ? String(prod.ordem) : "1";
      (document.getElementById("prod-ativo") as HTMLInputElement).checked = prod ? prod.ativo !== false : true;

      // Atualiza interface do estoque (manual vs gerenciapp)
      updateStockControlUI();
      if (prod?.stock_control_type === "gerenciapp") {
        syncStockFromGerenciapp(prod.codigo_integracao);
      } else if (stockStatusBox) {
        stockStatusBox.classList.add("hidden");
      }

      // Ficha Técnica do Modal
      (document.getElementById("prod-graduacao") as HTMLInputElement).value = prod?.graduacao_gl ? String(prod.graduacao_gl) : "";
      (document.getElementById("prod-brix") as HTMLInputElement).value = prod?.brix ? String(prod.brix) : "";
      (document.getElementById("prod-maceracao") as HTMLInputElement).value = prod?.dias_maceracao !== undefined && prod?.dias_maceracao !== null ? String(prod.dias_maceracao) : "40";
      (document.getElementById("prod-notas") as HTMLInputElement).value = prod?.notas_aromaticas || "";
      (document.getElementById("prod-ingredientes") as HTMLTextAreaElement).value = prod?.ingredientes || "";
      (document.getElementById("prod-sugestoes") as HTMLTextAreaElement).value = prod?.sugestoes || "";
      (document.getElementById("prod-descricao") as HTMLTextAreaElement).value = prod?.descricao || "";

      // Galeria e Foto de Capa
      currentCoverUrl = prod?.foto_url || "";
      currentGallery = [];
      if (currentCoverUrl) currentGallery.push(currentCoverUrl);

      const rawFotos = prod?.fotos_urls || prod?.fotos_url;
      if (Array.isArray(rawFotos)) {
        rawFotos.forEach((u: string) => {
          if (u && typeof u === "string" && !currentGallery.includes(u)) {
            currentGallery.push(u);
          }
        });
      }

      if (!currentCoverUrl && currentGallery.length > 0) {
        currentCoverUrl = currentGallery[0];
      }

      renderGallery();

      modalBackdrop?.classList.remove("hidden");
      modalBackdrop?.classList.add("flex");
    }

    function closeModal() {
      modalBackdrop?.classList.add("hidden");
      modalBackdrop?.classList.remove("flex");
      currentEditingProduct = null;
      currentGallery = [];
      currentCoverUrl = "";
      if (stockStatusBox) stockStatusBox.classList.add("hidden");
    }

    async function handleSave() {
      const id = (document.getElementById("prod-id") as HTMLInputElement).value;
      const nome = (document.getElementById("prod-nome") as HTMLInputElement).value.trim();
      const sabor = (document.getElementById("prod-sabor") as HTMLInputElement).value.trim();
      const categoria = (document.getElementById("prod-categoria") as HTMLSelectElement).value;
      const preco = Number((document.getElementById("prod-preco") as HTMLInputElement).value);
      const volume_ml = Number((document.getElementById("prod-volume") as HTMLInputElement).value) || 750;
      const estoque = Number((document.getElementById("prod-estoque") as HTMLInputElement).value) || 0;
      const stock_control_type = (document.getElementById("prod-stock-control-type") as HTMLSelectElement).value;
      const codigo_integracao = (document.getElementById("prod-codigo-integracao") as HTMLInputElement).value.trim() || null;
      const ordem = Number((document.getElementById("prod-ordem") as HTMLInputElement).value) || 1;
      const ativo = (document.getElementById("prod-ativo") as HTMLInputElement).checked;

      const graduacao_gl = Number((document.getElementById("prod-graduacao") as HTMLInputElement).value) || 0;
      const brix = Number((document.getElementById("prod-brix") as HTMLInputElement).value) || 0;
      const dias_maceracao = Number((document.getElementById("prod-maceracao") as HTMLInputElement).value) || 40;
      const notas_aromaticas = (document.getElementById("prod-notas") as HTMLInputElement).value.trim();
      const ingredientes = (document.getElementById("prod-ingredientes") as HTMLTextAreaElement).value.trim();
      const sugestoes = (document.getElementById("prod-sugestoes") as HTMLTextAreaElement).value.trim();
      const descricao = (document.getElementById("prod-descricao") as HTMLTextAreaElement).value.trim();

      const finalCoverUrl = currentCoverUrl || (currentGallery.length > 0 ? currentGallery[0] : "");
      // Garante que a capa fique na primeira posicao do array de galeria
      const finalGallery = finalCoverUrl
        ? [finalCoverUrl, ...currentGallery.filter((u) => u !== finalCoverUrl)]
        : currentGallery;

      if (!nome || isNaN(preco)) {
        alert("Preencha ao menos o Nome e o Preço da poção.");
        return;
      }

      const payload = {
        nome,
        sabor,
        categoria,
        preco,
        volume_ml,
        estoque,
        stock_control_type,
        codigo_integracao,
        ordem,
        ativo,
        graduacao_gl,
        brix,
        dias_maceracao,
        notas_aromaticas,
        ingredientes,
        sugestoes,
        descricao,
        foto_url: finalCoverUrl || undefined,
        fotos_urls: finalGallery.length > 0 ? finalGallery : undefined,
      };

      if (btnSaveProduct) btnSaveProduct.textContent = "Salvando...";

      try {
        let isSavedOnCloud = false;

        if (id) {
          // Atualiza produto existente no Supabase
          const { error } = await supabase.from("products").update(payload).eq("id", id);
          if (error) {
            console.warn("Aviso do Supabase ao atualizar produto:", error.message);
          } else {
            isSavedOnCloud = true;
          }
          
          // Atualiza localmente no estado em memória
          const idx = allProducts.findIndex((p) => String(p.id) === String(id));
          if (idx >= 0) {
            allProducts[idx] = { ...allProducts[idx], ...payload };
          }
        } else {
          // Cria novo produto no Supabase
          const newId = "pocao-" + Date.now();
          const { error } = await supabase.from("products").insert({ ...payload, id: newId });
          if (error) {
            console.warn("Aviso do Supabase ao inserir produto:", error.message);
          } else {
            isSavedOnCloud = true;
          }
          allProducts.push({ ...payload, id: id || newId });
        }

        if (isSavedOnCloud) {
          (window as any).showToast?.("Poção e ficha técnica salvas com sucesso no Supabase!") ||
            window.dispatchEvent(new CustomEvent("show-toast", { detail: { message: "Poção e ficha técnica salvas com sucesso no Supabase!" } }));
        } else {
          (window as any).showToast?.("Poção atualizada com sucesso na interface!") ||
            window.dispatchEvent(new CustomEvent("show-toast", { detail: { message: "Poção atualizada com sucesso na interface!" } }));
        }

        closeModal();
        renderTable();
      } catch (err: any) {
        console.error("Erro ao salvar produto:", err);
        
        // Aplica localmente para preservar as alterações do usuário
        if (id) {
          const idx = allProducts.findIndex((p) => String(p.id) === String(id));
          if (idx >= 0) allProducts[idx] = { ...allProducts[idx], ...payload };
        } else {
          allProducts.push({ ...payload, id: "pocao-" + Date.now() });
        }
        
        (window as any).showToast?.("Poção atualizada com sucesso na interface!") ||
          window.dispatchEvent(new CustomEvent("show-toast", { detail: { message: "Poção atualizada com sucesso na interface!" } }));
        closeModal();
        renderTable();
      } finally {
        if (btnSaveProduct) btnSaveProduct.textContent = "Salvar no Supabase";
      }
    }

    btnNewProduct?.addEventListener("click", () => openModal(null));
    btnCloseModal?.addEventListener("click", closeModal);
    btnCancelModal?.addEventListener("click", closeModal);
    btnSaveProduct?.addEventListener("click", handleSave);

    searchInput?.addEventListener("input", renderTable);
    filterCategory?.addEventListener("change", renderTable);

    // Carrega dados iniciais do catálogo e variações do GerenciApp
    async function initAdminProducts() {
      await Promise.all([
        fetchProducts(),
        loadGerenciappCodes()
      ]);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAdminProducts);
    } else {
      initAdminProducts();
    }
  </script>
</AdminLayout>
