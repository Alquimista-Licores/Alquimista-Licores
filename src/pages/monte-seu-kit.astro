---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Badge from '../components/Badge.astro';
import { fetchProducts, fetchKitPrices, needsPrep } from '../lib/data';

const products = await fetchProducts();
const kitPrices = await fetchKitPrices();
---

<Layout
  title="Monte seu Kit — Alquimista Licores"
  description="Monte seu kit Degustação ou Presenteável de licores artesanais e adicione ao caldeirão."
>
  <div class="max-w-4xl mx-auto px-6 pb-20">
    <!-- MODE SELECTOR VIEW (DEFAULT IF NO QUERY) -->
    <div id="view-mode-select">
      <PageHeader title="Monte seu Kit" subtitle="Escolha o caminho da sua poção." />

      <div class="grid sm:grid-cols-2 gap-6 mt-6">
        <button
          type="button"
          id="pick-degustacao-btn"
          class="kit-mode-card p-6 border border-[var(--gold)]/30 rounded-md hover:border-[var(--gold)] hover:bg-[var(--gold)]/5 transition-all text-left gold-glow-hover group bg-[var(--surface)]/40 flex flex-col justify-between"
        >
          <div>
            <div class="aspect-[4/3] mb-4 overflow-hidden rounded-md bg-[var(--surface-elevated)] border border-[var(--gold)]/10">
              <img
                src="/assets/kits-degustacao.jpg"
                alt="Kit Degustação"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <h2 class="font-display text-[var(--gold)] tracking-widest uppercase text-2xl md:text-3xl font-medium">
              Kit Degustação
            </h2>
            <p class="font-sans text-[var(--text-soft)] text-sm mt-2 leading-relaxed">
              Três mini-poções de 50ml para descobrir o universo do Alquimista. Ideal para experimentar antes de escolher seu favorito.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--gold)]/15 flex items-baseline justify-between">
            <span class="font-mono text-xs uppercase tracking-wider text-[var(--text-faded)]">apenas</span>
            <span class="font-display text-xl text-[var(--gold)] font-bold">R$ 20</span>
          </div>
        </button>

        <button
          type="button"
          id="pick-presenteavel-btn"
          class="kit-mode-card p-6 border border-[var(--gold)]/30 rounded-md hover:border-[var(--gold)] hover:bg-[var(--gold)]/5 transition-all text-left gold-glow-hover group bg-[var(--surface)]/40 flex flex-col justify-between"
        >
          <div>
            <div class="aspect-[4/3] mb-4 overflow-hidden rounded-md bg-[var(--surface-elevated)] border border-[var(--gold)]/10">
              <img
                src="/assets/kits-caixa-premium.jpg"
                alt="Kit Presenteável"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <h2 class="font-display text-[var(--gold)] tracking-widest uppercase text-2xl md:text-3xl font-medium">
              Kit Presenteável
            </h2>
            <p class="font-sans text-[var(--text-soft)] text-sm mt-2 leading-relaxed">
              Um presente completo: Garrafa de 500ml à escolha acompanhada de doce artesanal, tacinha de vidro, chaveiro exclusivo e embalagem personalizada.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--gold)]/15 flex items-baseline justify-between">
            <span class="font-mono text-xs uppercase tracking-wider text-[var(--text-faded)]">a partir de</span>
            <span class="font-display text-xl text-[var(--gold)] font-bold">R$ 110</span>
          </div>
        </button>
      </div>
    </div>

    <!-- WIZARD CONTAINER -->
    <div id="view-wizard" class="hidden">
      <div class="text-center pt-20 pb-6">
        <h2 id="wizard-title" class="text-3xl md:text-5xl font-medium tracking-wide text-[var(--gold)]"></h2>
        <button id="wizard-switch-mode" class="text-xs text-[var(--text-faded)] underline hover:text-[var(--gold)] mt-3">
          ← Trocar tipo de kit
        </button>
      </div>

      <!-- STEP INDICATOR -->
      <div id="stepper" class="flex items-center justify-center gap-3 my-8"></div>

      <!-- DEGUSTAÇÃO FLOW -->
      <div id="flow-degustacao" class="hidden space-y-8">
        <!-- DEG STEP 1: SABORES -->
        <div id="deg-step-1" class="space-y-6">
          <p class="font-sans italic text-[var(--text-soft)] text-center text-sm md:text-base max-w-xl mx-auto leading-relaxed">
            Três mini-poções de 50ml para descobrir o universo do Alquimista. Ideal para experimentar antes de escolher seu favorito. Escolha 3 sabores (pode repetir):
          </p>

          <div id="deg-counter" class="text-center text-sm md:text-base text-[var(--gold)] font-display tracking-widest uppercase font-bold transition-all">
            Você escolheu 0 de 3
          </div>

          <div id="deg-selected-chips" class="flex flex-wrap gap-2 justify-center min-h-[2rem]"></div>

          <!-- FULL PRODUCTS GRID (Visible when < 3 selected, normal size) -->
          <div id="deg-products-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 transition-all duration-200">
            {products.map((p) => {
              const hasPrep = needsPrep(p);
              const isOutOfStock = p.estoque <= 0;
              return (
                <button
                  type="button"
                  class={`deg-product-pick group p-3 border rounded-md text-left transition-all relative ${
                    isOutOfStock
                      ? "opacity-60 cursor-not-allowed border-[var(--border)] pointer-events-none select-none"
                      : "border-[var(--gold)]/20 hover:border-[var(--gold)] bg-[var(--surface)]/40 hover:bg-[var(--gold)]/5"
                  }`}
                  data-id={p.id}
                  data-name={p.nome}
                  data-sabor={p.sabor}
                  data-foto={p.foto_url || ""}
                  data-stock={p.estoque}
                  disabled={isOutOfStock}
                  tabindex={isOutOfStock ? "-1" : "0"}
                  aria-disabled={isOutOfStock ? "true" : "false"}
                >
                  <div class="aspect-square bg-[var(--surface-elevated)] rounded-md overflow-hidden mb-2 relative">
                    {p.foto_url ? (
                      <img src={p.foto_url} alt={p.nome} class="w-full h-full object-cover" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-2xl text-[var(--gold)]/30">⚗</div>
                    )}
                  </div>

                  {/* Top Right "Sob Encomenda" Badge */}
                  {hasPrep && !isOutOfStock && (
                    <div class="absolute top-2 right-2 z-20 pointer-events-none">
                      <Badge
                        variant="ember"
                        size="sm"
                        class="!text-[9px] sm:!text-[9.5px] !py-0.5 !px-1.5 shadow-md font-bold uppercase tracking-wider text-center"
                      >
                        Sob Encomenda
                      </Badge>
                    </div>
                  )}

                  {/* Contextual Tooltip on Hover */}
                  {hasPrep && !isOutOfStock && (
                    <div class="pointer-events-none absolute -top-11 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 group-hover:-translate-y-1 transition-all duration-200 z-40 px-2.5 py-1.5 bg-[var(--background)]/95 border border-[var(--gold)] text-[var(--gold-soft)] font-mono text-[10.5px] leading-tight text-center rounded-sm whitespace-nowrap shadow-2xl backdrop-blur-md">
                      Preparado sob demanda<br />
                      <span class="text-[9.5px] text-[var(--cream)]/85">(2 dias de maceração)</span>
                    </div>
                  )}

                  <h3 class="font-display font-bold text-xs md:text-sm text-[var(--gold)] uppercase truncate">{p.nome}</h3>
                  <div class="font-body text-xs text-[var(--text-soft)] italic truncate">{p.sabor}</div>

                  {isOutOfStock && (
                    <div class="absolute inset-0 z-20 flex items-center justify-center bg-black/40 backdrop-blur-[0.5px] rounded-md p-1.5 pointer-events-none">
                      <Badge variant="ember" size="sm" class="!text-[10px] !py-0.5 !px-2 shadow-2xl font-bold uppercase tracking-wider text-center scale-95 sm:scale-100">
                        Lote Esgotado
                      </Badge>
                    </div>
                  )}
                </button>
              );
            })}
          </div>

          <!-- TRIO SELECTED VIEW (Visible when 3 selected, slightly smaller cards with X button) -->
          <div id="deg-selected-trio-view" class="hidden transition-all duration-200">
            <div id="deg-trio-container" class="grid grid-cols-3 gap-3 max-w-lg mx-auto"></div>
            <p class="text-center text-xs text-[var(--text-faded)] mt-3 font-sans italic">
              Clique no ✕ para alterar qualquer uma das poções escolhidas.
            </p>
          </div>

          <div class="flex justify-end pt-4">
            <button
              id="deg-next-btn"
              disabled
              class="btn-primary w-full sm:w-auto !px-8 !py-3 !text-xs font-bold"
            >
              <span>Continuar →</span>
            </button>
          </div>
        </div>

        <!-- DEG STEP 2: RESUMO -->
        <div id="deg-step-2" class="hidden space-y-6">
          <div class="p-6 border border-[var(--gold)]/30 rounded-md bg-[var(--surface)]/60 space-y-4">
            <h3 class="font-display tracking-widest uppercase text-base text-[var(--gold)] font-bold">
              Resumo do Kit Degustação
            </h3>
            <ul id="deg-summary-list" class="space-y-2 text-sm text-[var(--cream)]"></ul>
            <div class="flex justify-between items-baseline pt-4 border-t border-[var(--gold)]/20 text-base font-display">
              <span>Total do Kit</span>
              <span class="text-3xl text-[var(--gold)] font-bold">R$ 20,00</span>
            </div>
          </div>

          <div class="flex gap-3">
            <button id="deg-prev-btn" class="btn-outline flex-1 !py-3 !text-xs font-bold">
              <span>← Voltar</span>
            </button>
            <button id="deg-add-cart-btn" class="btn-primary flex-1 !py-3 !text-xs font-bold">
              <span>Adicionar ao Caldeirão</span>
            </button>
          </div>
        </div>
      </div>

      <!-- PRESENTEÁVEL FLOW -->
      <div id="flow-presenteavel" class="hidden space-y-8">
        <!-- PRES STEP 1: LICOR 500ML -->
        <div id="pres-step-1" class="space-y-6">
          <p class="font-sans italic text-[var(--text-soft)] text-center text-sm md:text-base max-w-xl mx-auto leading-relaxed">
            Um presente completo com garrafa de 500ml, doce artesanal, taça de vidro, chaveiro exclusivo e caixa personalizada. Escolha a poção central:
          </p>

          <!-- FULL PRODUCTS GRID (Visible when no flavor chosen, normal size) -->
          <div id="pres-products-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 transition-all duration-200">
            {products.map((p) => {
              const hasPrep = needsPrep(p);
              const isOutOfStock = p.estoque <= 0;
              return (
                <button
                  type="button"
                  class={`pres-liquor-pick group p-3 border rounded-md text-left transition-all relative ${
                    isOutOfStock
                      ? "opacity-60 cursor-not-allowed border-[var(--border)] pointer-events-none select-none"
                      : "border-[var(--gold)]/20 hover:border-[var(--gold)] bg-[var(--surface)]/40 hover:bg-[var(--gold)]/5"
                  }`}
                  data-id={p.id}
                  data-name={p.nome}
                  data-sabor={p.sabor}
                  data-foto={p.foto_url || ""}
                  data-cat={p.categoria}
                  data-stock={p.estoque}
                  disabled={isOutOfStock}
                  tabindex={isOutOfStock ? "-1" : "0"}
                  aria-disabled={isOutOfStock ? "true" : "false"}
                >
                  <div class="aspect-square bg-[var(--surface-elevated)] rounded-md overflow-hidden mb-2 relative">
                    {p.foto_url ? (
                      <img src={p.foto_url} alt={p.nome} class="w-full h-full object-cover" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-2xl text-[var(--gold)]/30">⚗</div>
                    )}
                  </div>

                  {/* Top Right "Sob Encomenda" Badge */}
                  {hasPrep && !isOutOfStock && (
                    <div class="absolute top-2 right-2 z-20 pointer-events-none">
                      <Badge
                        variant="ember"
                        size="sm"
                        class="!text-[9px] sm:!text-[9.5px] !py-0.5 !px-1.5 shadow-md font-bold uppercase tracking-wider text-center"
                      >
                        Sob Encomenda
                      </Badge>
                    </div>
                  )}

                  {/* Contextual Tooltip on Hover */}
                  {hasPrep && !isOutOfStock && (
                    <div class="pointer-events-none absolute -top-11 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 group-hover:-translate-y-1 transition-all duration-200 z-40 px-2.5 py-1.5 bg-[var(--background)]/95 border border-[var(--gold)] text-[var(--gold-soft)] font-mono text-[10.5px] leading-tight text-center rounded-sm whitespace-nowrap shadow-2xl backdrop-blur-md">
                      Preparado sob demanda<br />
                      <span class="text-[9.5px] text-[var(--cream)]/85">(2 dias de maceração)</span>
                    </div>
                  )}

                  <h3 class="font-display font-bold text-xs md:text-sm text-[var(--gold)] uppercase truncate">{p.nome}</h3>
                  <div class="font-body text-xs text-[var(--text-soft)] italic truncate">{p.sabor}</div>

                  {isOutOfStock && (
                    <div class="absolute inset-0 z-20 flex items-center justify-center bg-black/40 backdrop-blur-[0.5px] rounded-md p-1.5 pointer-events-none">
                      <Badge variant="ember" size="sm" class="!text-[10px] !py-0.5 !px-2 shadow-2xl font-bold uppercase tracking-wider text-center scale-95 sm:scale-100">
                        Lote Esgotado
                      </Badge>
                    </div>
                  )}
                </button>
              );
            })}
          </div>

          <!-- SINGLE SELECTED VIEW (Visible when flavor selected, slightly smaller card with X button) -->
          <div id="pres-selected-single-view" class="hidden transition-all duration-200">
            <div id="pres-single-container" class="max-w-[220px] sm:max-w-[240px] mx-auto"></div>
            <p class="text-center text-xs text-[var(--text-faded)] mt-3 font-sans italic">
              Clique no ✕ para alterar o sabor escolhido.
            </p>
          </div>

          <div class="flex justify-end pt-4">
            <button
              id="pres-next-1"
              disabled
              class="btn-primary w-full sm:w-auto !px-8 !py-3 !text-xs font-bold"
            >
              <span>Continuar →</span>
            </button>
          </div>
        </div>

        <!-- PRES STEP 2: ACOMPANHAMENTO -->
        <div id="pres-step-2" class="hidden space-y-6">
          <p class="font-sans italic text-[var(--text-soft)] text-center text-sm md:text-base">
            Escolha o acompanhamento doce (incluso no kit).
          </p>

          <div class="grid grid-cols-2 gap-4">
            <button
              type="button"
              class="pres-acomp-pick p-5 border border-[var(--gold)]/25 rounded-md text-center transition-all hover:border-[var(--gold)] bg-[var(--surface)]/40"
              data-id="brownies"
              data-label="3 Brownies Artesanais"
            >
              <div class="aspect-square mb-3 overflow-hidden rounded-md bg-[var(--surface-elevated)]">
                <img src="/assets/kits-brownies.jpg" alt="3 Brownies" class="w-full h-full object-cover" />
              </div>
              <h3 class="font-display tracking-widest uppercase text-sm md:text-base text-[var(--gold)] font-bold">
                3 Brownies
              </h3>
            </button>

            <button
              type="button"
              class="pres-acomp-pick p-5 border border-[var(--gold)]/25 rounded-md text-center transition-all hover:border-[var(--gold)] bg-[var(--surface)]/40"
              data-id="paes-mel"
              data-label="3 Pães de Mel Artesanais"
            >
              <div class="aspect-square mb-3 overflow-hidden rounded-md bg-[var(--surface-elevated)]">
                <img src="/assets/kits-paes-mel.jpg" alt="3 Pães de Mel" class="w-full h-full object-cover" />
              </div>
              <h3 class="font-display tracking-widest uppercase text-sm md:text-base text-[var(--gold)] font-bold">
                3 Pães de Mel
              </h3>
            </button>
          </div>

          <div class="flex gap-3 pt-4">
            <button id="pres-prev-2" class="btn-outline flex-1 !py-3 !text-xs font-bold">
              <span>← Voltar</span>
            </button>
            <button id="pres-next-2" disabled class="btn-primary flex-1 !py-3 !text-xs font-bold">
              <span>Continuar →</span>
            </button>
          </div>
        </div>

        <!-- PRES STEP 3: EMBALAGEM / CAIXA -->
        <div id="pres-step-3" class="hidden space-y-6">
          <p class="font-sans italic text-[var(--text-soft)] text-center text-sm md:text-base">
            Escolha o tipo de embalagem para presentear.
          </p>

          <div class="grid grid-cols-2 gap-4">
            <button
              type="button"
              class="pres-box-pick p-5 border border-[var(--gold)]/25 rounded-md text-center transition-all hover:border-[var(--gold)] bg-[var(--surface)]/40"
              data-id="mdf"
              data-label="Box MDF Artesanal"
            >
              <div class="aspect-square mb-3 overflow-hidden rounded-md bg-[var(--surface-elevated)]">
                <img src="/assets/kits-mdf.jpg" alt="Box MDF" class="w-full h-full object-cover" />
              </div>
              <h3 class="font-display tracking-widest uppercase text-sm md:text-base text-[var(--gold)] font-bold">
                Box MDF
              </h3>
              <div id="price-mdf-label" class="text-xs text-[var(--text-soft)] mt-1.5"></div>
            </button>

            <button
              type="button"
              class="pres-box-pick p-5 border border-[var(--gold)]/25 rounded-md text-center transition-all hover:border-[var(--gold)] bg-[var(--surface)]/40"
              data-id="acrilico"
              data-label="Box Premium Luxo"
            >
              <div class="aspect-square mb-3 overflow-hidden rounded-md bg-[var(--surface-elevated)]">
                <img src="/assets/kits-caixa-premium.jpg" alt="Box Premium" class="w-full h-full object-cover" />
              </div>
              <h3 class="font-display tracking-widest uppercase text-sm md:text-base text-[var(--gold)] font-bold">
                Box Premium
              </h3>
              <div id="price-acrilico-label" class="text-xs text-[var(--text-soft)] mt-1.5"></div>
            </button>
          </div>

          <div class="flex gap-3 pt-4">
            <button id="pres-prev-3" class="btn-outline flex-1 !py-3 !text-xs font-bold">
              <span>← Voltar</span>
            </button>
            <button id="pres-next-3" disabled class="btn-primary flex-1 !py-3 !text-xs font-bold">
              <span>Continuar →</span>
            </button>
          </div>
        </div>

        <!-- PRES STEP 4: RESUMO & DEDICATÓRIA -->
        <div id="pres-step-4" class="hidden space-y-6">
          <div class="p-6 border border-[var(--gold)]/30 rounded-md bg-[var(--surface)]/60 space-y-4">
            <h3 class="font-display tracking-widest uppercase text-base text-[var(--gold)] font-bold">
              Resumo do Kit Presenteável
            </h3>
            <ul id="pres-summary-list" class="space-y-2 text-sm text-[var(--cream)]"></ul>
            
            <div class="pt-2">
              <label class="block text-xs uppercase tracking-wider text-[var(--gold)]/80 mb-1">
                Dedicatória personalizada (opcional):
              </label>
              <textarea
                id="pres-dedicatoria"
                rows="2"
                placeholder="Escreva uma mensagem especial para quem vai receber o presente..."
                class="w-full bg-[var(--background)] border border-[var(--gold)]/30 px-3 py-2 text-xs rounded-md focus:border-[var(--gold)] outline-none text-[var(--cream)] resize-none"
              ></textarea>
            </div>

            <div class="flex justify-between items-baseline pt-4 border-t border-[var(--gold)]/20 text-base font-display">
              <span>Total do Kit</span>
              <span id="pres-total-price" class="text-3xl text-[var(--gold)] font-bold">R$ 0,00</span>
            </div>
          </div>

          <div class="flex gap-3">
            <button id="pres-prev-4" class="btn-outline flex-1 !py-3 !text-xs font-bold">
              <span>← Voltar</span>
            </button>
            <button id="pres-add-cart-btn" class="btn-primary flex-1 !py-3 !text-xs font-bold">
              <span>Adicionar ao Caldeirão</span>
            </button>
          </div>
        </div>
      </div>

      <!-- POST-ADD CTA -->
      <div id="post-add-cta" class="hidden mt-8 p-6 border border-[var(--gold)]/35 rounded-md bg-[var(--gold)]/5 text-center space-y-4 gold-glow">
        <div class="text-[var(--gold)] font-display tracking-widest uppercase text-sm font-bold">
          ✦ Kit adicionado com sucesso ao seu caldeirão!
        </div>
        <p class="text-sm text-[var(--text-soft)] font-sans italic">
          Deseja adicionar mais poções ou já deseja finalizar seu pedido?
        </p>
        <div class="grid sm:grid-cols-3 gap-3 pt-2">
          <button id="post-add-new-btn" class="btn-outline !py-3 !text-xs font-bold">
            <span>Montar outro kit</span>
          </button>
          <a href="/pocoes" class="btn-outline !py-3 !text-xs font-bold text-center">
            <span>Ver as poções</span>
          </a>
          <button id="post-add-open-cart-btn" class="btn-primary !py-3 !text-xs font-bold">
            <span>Ir para o caldeirão</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .kit-mode-card,
  .deg-product-pick,
  .deg-trio-card,
  .pres-liquor-pick,
  .pres-acomp-pick,
  .pres-box-pick {
    transform-style: preserve-3d;
    will-change: transform, box-shadow;
  }

  @media (hover: hover) and (pointer: fine) {
    .kit-mode-card:hover,
    .deg-product-pick:hover:not([disabled]),
    .deg-trio-card:hover,
    .pres-liquor-pick:hover:not([disabled]),
    .pres-acomp-pick:hover,
    .pres-box-pick:hover {
      transition: transform 0.12s ease-out, box-shadow 0.12s ease-out, border-color 0s !important;
    }
  }

  .kit-mode-card img,
  .deg-product-pick img,
  .deg-trio-card img,
  .pres-liquor-pick img,
  .pres-acomp-pick img,
  .pres-box-pick img {
    will-change: transform;
    transition: transform 0.12s ease-out;
  }

  #deg-products-grid,
  #deg-selected-trio-view,
  #pres-products-grid,
  #pres-selected-single-view {
    transition: opacity 0.2s cubic-bezier(0.2, 0, 0.2, 1), transform 0.2s cubic-bezier(0.2, 0, 0.2, 1);
  }
</style>

<script define:vars={{ kitPrices }}>
  function setupMonteKit() {
    const viewModeSelect = document.getElementById("view-mode-select");
    const viewWizard = document.getElementById("view-wizard");
    const wizardTitle = document.getElementById("wizard-title");
    const switchModeBtn = document.getElementById("wizard-switch-mode");
    const stepper = document.getElementById("stepper");
    const postAddCta = document.getElementById("post-add-cta");

    const flowDegustacao = document.getElementById("flow-degustacao");
    const flowPresenteavel = document.getElementById("flow-presenteavel");

    const pickDegBtn = document.getElementById("pick-degustacao-btn");
    const pickPresBtn = document.getElementById("pick-presenteavel-btn");

    // Degustação state
    let degSelected = [];
    const degCounter = document.getElementById("deg-counter");
    const degChips = document.getElementById("deg-selected-chips");
    const degNextBtn = document.getElementById("deg-next-btn");
    const degPrevBtn = document.getElementById("deg-prev-btn");
    const degAddCartBtn = document.getElementById("deg-add-cart-btn");
    const degStep1 = document.getElementById("deg-step-1");
    const degStep2 = document.getElementById("deg-step-2");
    const degSummaryList = document.getElementById("deg-summary-list");
    const degProductsGrid = document.getElementById("deg-products-grid");
    const degTrioView = document.getElementById("deg-selected-trio-view");
    const degTrioContainer = document.getElementById("deg-trio-container");

    // Presenteavel state
    let presProduct = null;
    let presAcomp = null;
    let presBox = null;
    const presStep1 = document.getElementById("pres-step-1");
    const presStep2 = document.getElementById("pres-step-2");
    const presStep3 = document.getElementById("pres-step-3");
    const presStep4 = document.getElementById("pres-step-4");
    const presProductsGrid = document.getElementById("pres-products-grid");
    const presSingleView = document.getElementById("pres-selected-single-view");
    const presSingleContainer = document.getElementById("pres-single-container");
    const presNext1 = document.getElementById("pres-next-1");
    const presNext2 = document.getElementById("pres-next-2");
    const presNext3 = document.getElementById("pres-next-3");
    const presPrev2 = document.getElementById("pres-prev-2");
    const presPrev3 = document.getElementById("pres-prev-3");
    const presPrev4 = document.getElementById("pres-prev-4");
    const presAddCartBtn = document.getElementById("pres-add-cart-btn");
    const presSummaryList = document.getElementById("pres-summary-list");
    const presTotalPrice = document.getElementById("pres-total-price");
    const presDedicatoria = document.getElementById("pres-dedicatoria");
    const priceMdfLabel = document.getElementById("price-mdf-label");
    const priceAcrilicoLabel = document.getElementById("price-acrilico-label");

    let currentMode = "";
    let currentStep = 1;

    function initKitParallax() {
      if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;

      // 1. Main Mode Cards (Kit Degustação & Kit Presenteável)
      const mainCards = document.querySelectorAll(".kit-mode-card, #pick-degustacao-btn, #pick-presenteavel-btn");
      mainCards.forEach((card) => {
        if (card.dataset.parallaxInit === "true") return;
        card.dataset.parallaxInit = "true";

        const img = card.querySelector("img");
        let rafId = 0;

        function onMouseMove(e) {
          cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            const rect = card.getBoundingClientRect();
            if (rect.width === 0 || rect.height === 0) return;
            const normX = (e.clientX - rect.left) / rect.width - 0.5;
            const normY = (e.clientY - rect.top) / rect.height - 0.5;

            const rotX = (-normY * 5).toFixed(2);
            const rotY = (normX * 5).toFixed(2);

            card.style.borderColor = "#B28C46";
            card.style.transform = `perspective(800px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-4px)`;
            card.style.boxShadow = `${(-normX * 12).toFixed(1)}px ${(-normY * 12 + 10).toFixed(1)}px 24px -4px rgba(0, 0, 0, 0.6), 0 0 16px rgba(178, 140, 70, 0.35)`;

            if (img) {
              img.style.transform = `translate3d(${(-normX * 6).toFixed(1)}px, ${(-normY * 6).toFixed(1)}px, 0px) scale(1.05)`;
            }
          });
        }

        function onMouseEnter() {
          card.style.borderColor = "#B28C46";
          card.style.boxShadow = "0 0 16px rgba(178, 140, 70, 0.35)";
          card.style.transition = "transform 0.12s ease-out, box-shadow 0.12s ease-out, border-color 0s";
          if (img) img.style.transition = "transform 0.12s ease-out";
        }

        function onMouseLeave() {
          cancelAnimationFrame(rafId);
          card.style.transition = "transform 0.5s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.5s cubic-bezier(0.2, 0, 0.2, 1), border-color 0.4s ease";
          card.style.transform = "perspective(800px) rotateX(0deg) rotateY(0deg) translateY(0)";
          card.style.boxShadow = "";
          card.style.borderColor = "";

          if (img) {
            img.style.transition = "transform 0.5s cubic-bezier(0.2, 0, 0.2, 1)";
            img.style.transform = "translate3d(0, 0, 0) scale(1)";
          }
        }

        card.addEventListener("mousemove", onMouseMove);
        card.addEventListener("mouseenter", onMouseEnter);
        card.addEventListener("mouseleave", onMouseLeave);
      });

      // 2. Mini product/item cards in wizard steps
      const miniCards = document.querySelectorAll(".deg-product-pick, .deg-trio-card, .pres-liquor-pick, .pres-single-card, .pres-acomp-pick, .pres-box-pick");
      miniCards.forEach((card) => {
        if (card.dataset.parallaxInit === "true") return;
        if (card.hasAttribute("disabled") || card.disabled) return;
        card.dataset.parallaxInit = "true";

        const img = card.querySelector("img");
        let rafId = 0;

        function onMouseMove(e) {
          if (card.disabled) return;
          cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            const rect = card.getBoundingClientRect();
            if (rect.width === 0 || rect.height === 0) return;
            const normX = (e.clientX - rect.left) / rect.width - 0.5;
            const normY = (e.clientY - rect.top) / rect.height - 0.5;

            const rotX = (-normY * 3.5).toFixed(2);
            const rotY = (normX * 3.5).toFixed(2);

            card.style.borderColor = "#B28C46";
            card.style.transform = `perspective(600px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-2px)`;
            card.style.boxShadow = `${(-normX * 8).toFixed(1)}px ${(-normY * 8 + 6).toFixed(1)}px 16px -3px rgba(0, 0, 0, 0.5), 0 0 10px rgba(178, 140, 70, 0.25)`;

            if (img) {
              img.style.transform = `translate3d(${(-normX * 4).toFixed(1)}px, ${(-normY * 4).toFixed(1)}px, 0px) scale(1.04)`;
            }
          });
        }

        function onMouseEnter() {
          if (card.disabled) return;
          card.style.borderColor = "#B28C46";
          card.style.boxShadow = "0 0 10px rgba(178, 140, 70, 0.25)";
          card.style.transition = "transform 0.12s ease-out, box-shadow 0.12s ease-out, border-color 0s";
          if (img) img.style.transition = "transform 0.12s ease-out";
        }

        function onMouseLeave() {
          cancelAnimationFrame(rafId);
          card.style.transition = "transform 0.4s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.4s cubic-bezier(0.2, 0, 0.2, 1), border-color 0.4s ease";
          card.style.transform = "perspective(600px) rotateX(0deg) rotateY(0deg) translateY(0)";
          card.style.boxShadow = "";
          card.style.borderColor = "";

          if (img) {
            img.style.transition = "transform 0.4s cubic-bezier(0.2, 0, 0.2, 1)";
            img.style.transform = "translate3d(0, 0, 0) scale(1)";
          }
        }

        card.addEventListener("mousemove", onMouseMove);
        card.addEventListener("mouseenter", onMouseEnter);
        card.addEventListener("mouseleave", onMouseLeave);
      });
    }

    function renderStepper(total, current, labels) {
      if (!stepper) return;
      stepper.innerHTML = "";
      for (let i = 1; i <= total; i++) {
        const active = i === current;
        const done = i < current;
        const item = document.createElement("div");
        item.className = "flex items-center gap-2";
        item.innerHTML = `
          <div class="flex flex-col items-center">
            <div class="w-8 h-8 md:w-9 md:h-9 flex items-center justify-center rounded-full border text-xs font-bold ${
              active
                ? "bg-[var(--gold)] text-[var(--background)] border-[var(--gold)] scale-110 shadow-md"
                : done
                ? "bg-[var(--gold)]/20 border-[var(--gold)] text-[var(--gold)]"
                : "border-[var(--gold)]/30 text-[var(--text-faded)]"
            }">
              ${done ? "✓" : i}
            </div>
            <div class="text-[10px] mt-1 tracking-widest uppercase ${active ? "text-[var(--gold)] font-bold" : "text-[var(--text-faded)]"}">
              ${labels[i - 1] || ""}
            </div>
          </div>
          ${i < total ? `<div class="w-6 h-px ${done ? "bg-[var(--gold)]" : "bg-[var(--gold)]/20"}"></div>` : ""}
        `;
        stepper.appendChild(item);
      }
    }

    function setMode(mode) {
      currentMode = mode;
      currentStep = 1;
      postAddCta?.classList.add("hidden");

      if (!mode) {
        viewModeSelect?.classList.remove("hidden");
        viewWizard?.classList.add("hidden");
        history.replaceState(null, "", "/monte-seu-kit");
        initKitParallax();
        return;
      }

      viewModeSelect?.classList.add("hidden");
      viewWizard?.classList.remove("hidden");
      history.replaceState(null, "", `/monte-seu-kit?kit=${mode}`);

      if (mode === "degustacao") {
        if (wizardTitle) wizardTitle.textContent = "Kit Degustação";
        flowDegustacao?.classList.remove("hidden");
        flowPresenteavel?.classList.add("hidden");
        showDegStep(1);
      } else if (mode === "presenteavel") {
        if (wizardTitle) wizardTitle.textContent = "Kit Presenteável";
        flowDegustacao?.classList.add("hidden");
        flowPresenteavel?.classList.remove("hidden");
        showPresStep(1);
      }
      initKitParallax();
    }

    pickDegBtn?.addEventListener("click", () => setMode("degustacao"));
    pickPresBtn?.addEventListener("click", () => setMode("presenteavel"));
    switchModeBtn?.addEventListener("click", () => setMode(""));

    // DEGUSTAÇÃO LOGIC
    function renderTrioView() {
      if (!degTrioContainer) return;
      degTrioContainer.innerHTML = "";
      degSelected.forEach((item, idx) => {
        const card = document.createElement("div");
        card.className = "deg-trio-card relative p-2.5 sm:p-3 border border-[var(--gold)]/50 rounded-md bg-[var(--surface-elevated)]/80 text-left transition-all gold-glow-hover flex flex-col justify-between";
        card.innerHTML = `
          <button
            type="button"
            class="deg-remove-trio-btn absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-black/85 border border-[var(--gold)]/60 text-[var(--gold)] hover:border-red-400 hover:text-red-400 hover:bg-red-950/50 text-xs font-bold flex items-center justify-center transition-all shadow-md z-30"
            data-idx="${idx}"
            title="Remover ${item.name}"
            aria-label="Remover ${item.name}"
          >✕</button>
          <div>
            <div class="aspect-square bg-[var(--surface)] rounded-md overflow-hidden mb-2 border border-[var(--gold)]/10">
              ${item.foto ? `<img src="${item.foto}" alt="${item.name}" class="w-full h-full object-cover" />` : `<div class="w-full h-full flex items-center justify-center text-xl text-[var(--gold)]/30">⚗</div>`}
            </div>
            <div class="text-[9px] font-mono uppercase tracking-wider text-[var(--gold)]/80 mb-0.5">Poção 0${idx + 1}</div>
            <h3 class="font-display font-bold text-xs text-[var(--gold)] uppercase truncate">${item.name}</h3>
            <div class="font-body text-[11px] text-[var(--text-soft)] italic truncate">${item.sabor}</div>
          </div>
        `;

        card.querySelector(".deg-remove-trio-btn")?.addEventListener("click", (e) => {
          e.stopPropagation();
          degSelected.splice(idx, 1);
          updateDegChips();
        });

        degTrioContainer.appendChild(card);
      });
      initKitParallax();
    }

    function updateDegChips() {
      const count = degSelected.length;

      if (degCounter) {
        if (count === 3) {
          degCounter.textContent = "✦ 3 Sabores Escolhidos ✦";
        } else {
          degCounter.textContent = `Você escolheu ${count} de 3`;
        }
      }

      if (degNextBtn) {
        degNextBtn.disabled = count !== 3;
      }

      // Update chips when < 3
      if (degChips) {
        degChips.innerHTML = "";
        if (count < 3) {
          degChips.classList.remove("hidden");
          degSelected.forEach((item, idx) => {
            const chip = document.createElement("span");
            chip.className = "inline-flex items-center gap-2 px-3 py-1 bg-[var(--gold)]/15 border border-[var(--gold)]/40 rounded-sm text-xs text-[var(--gold)] font-medium";
            chip.innerHTML = `${item.name} <button type="button" class="hover:text-red-400 font-bold ml-1" data-idx="${idx}">✕</button>`;
            chip.querySelector("button")?.addEventListener("click", () => {
              degSelected.splice(idx, 1);
              updateDegChips();
            });
            degChips.appendChild(chip);
          });
        } else {
          degChips.classList.add("hidden");
        }
      }

      // Smooth Switch between full grid (< 3) and trio view (=== 3)
      if (count === 3) {
        if (degProductsGrid && !degProductsGrid.classList.contains("hidden")) {
          degProductsGrid.style.opacity = "0";
          degProductsGrid.style.transform = "scale(0.96)";
          setTimeout(() => {
            degProductsGrid.classList.add("hidden");
            renderTrioView();
            if (degTrioView) {
              degTrioView.classList.remove("hidden");
              degTrioView.style.opacity = "0";
              degTrioView.style.transform = "scale(0.96)";
              requestAnimationFrame(() => {
                degTrioView.style.opacity = "1";
                degTrioView.style.transform = "scale(1)";
              });
            }
          }, 180);
        } else if (degTrioView && degTrioView.classList.contains("hidden")) {
          renderTrioView();
          degTrioView.classList.remove("hidden");
          degTrioView.style.opacity = "1";
          degTrioView.style.transform = "scale(1)";
          if (degProductsGrid) degProductsGrid.classList.add("hidden");
        } else {
          renderTrioView();
        }
      } else {
        if (degTrioView && !degTrioView.classList.contains("hidden")) {
          degTrioView.style.opacity = "0";
          degTrioView.style.transform = "scale(0.96)";
          setTimeout(() => {
            degTrioView.classList.add("hidden");
            if (degProductsGrid) {
              degProductsGrid.classList.remove("hidden");
              degProductsGrid.style.opacity = "0";
              degProductsGrid.style.transform = "scale(0.96)";
              requestAnimationFrame(() => {
                degProductsGrid.style.opacity = "1";
                degProductsGrid.style.transform = "scale(1)";
              });
            }
            initKitParallax();
          }, 180);
        } else {
          if (degTrioView) degTrioView.classList.add("hidden");
          if (degProductsGrid) {
            degProductsGrid.classList.remove("hidden");
            degProductsGrid.style.opacity = "1";
            degProductsGrid.style.transform = "scale(1)";
          }
        }
      }
    }

    document.querySelectorAll(".deg-product-pick").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.hasAttribute("disabled") || btn.disabled || btn.getAttribute("data-stock") === "0") return;
        if (degSelected.length < 3) {
          const id = btn.getAttribute("data-id");
          const name = btn.getAttribute("data-name");
          const sabor = btn.getAttribute("data-sabor");
          const foto = btn.getAttribute("data-foto") || "";
          degSelected.push({ id, name, sabor, foto });
          updateDegChips();
        }
      });
    });

    function showDegStep(step) {
      currentStep = step;
      renderStepper(2, step, ["Sabores", "Resumo"]);
      if (step === 1) {
        degStep1?.classList.remove("hidden");
        degStep2?.classList.add("hidden");
        updateDegChips();
      } else {
        degStep1?.classList.add("hidden");
        degStep2?.classList.remove("hidden");
        if (degSummaryList) {
          degSummaryList.innerHTML = degSelected.map((s, idx) => `
            <li class="flex justify-between py-1 border-b border-[var(--gold)]/10">
              <span>Garrafinha ${idx + 1}: <strong>${s.name}</strong> (${s.sabor})</span>
              <span class="text-[var(--text-soft)]">50ml</span>
            </li>
          `).join("");
        }
      }
      initKitParallax();
    }

    degNextBtn?.addEventListener("click", () => showDegStep(2));
    degPrevBtn?.addEventListener("click", () => showDegStep(1));

    degAddCartBtn?.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("add-to-cart", {
        detail: {
          tipo: "kit-degustacao",
          id: `kit-degustacao-${Date.now()}`,
          nome: "Kit Degustação",
          preco: 20,
          qty: 1,
          saboresIds: degSelected.map(s => s.id),
          saboresLabels: degSelected.map(s => ({ nome: s.name, sabor: s.sabor }))
        }
      }));
      flowDegustacao?.classList.add("hidden");
      postAddCta?.classList.remove("hidden");
    });

    // PRESENTEÁVEL LOGIC
    function renderSinglePresView() {
      if (!presSingleContainer || !presProduct) return;
      presSingleContainer.innerHTML = `
        <div class="pres-single-card relative p-2.5 sm:p-3 border border-[var(--gold)]/50 rounded-md bg-[var(--surface-elevated)]/80 text-left transition-all gold-glow-hover flex flex-col justify-between">
          <button
            type="button"
            class="pres-remove-single-btn absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-black/85 border border-[var(--gold)]/60 text-[var(--gold)] hover:border-red-400 hover:text-red-400 hover:bg-red-950/50 text-xs font-bold flex items-center justify-center transition-all shadow-md z-30"
            title="Remover ${presProduct.name}"
            aria-label="Remover ${presProduct.name}"
          >✕</button>
          <div>
            <div class="aspect-square bg-[var(--surface)] rounded-md overflow-hidden mb-2 border border-[var(--gold)]/10">
              ${presProduct.foto ? `<img src="${presProduct.foto}" alt="${presProduct.name}" class="w-full h-full object-cover" />` : `<div class="w-full h-full flex items-center justify-center text-xl text-[var(--gold)]/30">⚗</div>`}
            </div>
            <div class="text-[9px] font-mono uppercase tracking-wider text-[var(--gold)]/80 mb-0.5">Poção Selecionada</div>
            <h3 class="font-display font-bold text-xs sm:text-sm text-[var(--gold)] uppercase truncate">${presProduct.name}</h3>
            <div class="font-body text-[11px] sm:text-xs text-[var(--text-soft)] italic truncate">${presProduct.sabor}</div>
          </div>
        </div>
      `;

      presSingleContainer.querySelector(".pres-remove-single-btn")?.addEventListener("click", (e) => {
        e.stopPropagation();
        deselectPresProduct();
      });

      initKitParallax();
    }

    function selectPresProduct(product) {
      presProduct = product;
      if (presNext1) presNext1.disabled = false;

      if (presProductsGrid && !presProductsGrid.classList.contains("hidden")) {
        presProductsGrid.style.opacity = "0";
        presProductsGrid.style.transform = "scale(0.96)";
        setTimeout(() => {
          presProductsGrid.classList.add("hidden");
          renderSinglePresView();
          if (presSingleView) {
            presSingleView.classList.remove("hidden");
            presSingleView.style.opacity = "0";
            presSingleView.style.transform = "scale(0.96)";
            requestAnimationFrame(() => {
              presSingleView.style.opacity = "1";
              presSingleView.style.transform = "scale(1)";
            });
          }
        }, 180);
      } else if (presSingleView && presSingleView.classList.contains("hidden")) {
        renderSinglePresView();
        presSingleView.classList.remove("hidden");
        presSingleView.style.opacity = "1";
        presSingleView.style.transform = "scale(1)";
        if (presProductsGrid) presProductsGrid.classList.add("hidden");
      } else {
        renderSinglePresView();
      }
    }

    function deselectPresProduct() {
      presProduct = null;
      if (presNext1) presNext1.disabled = true;

      // Unhighlight all grid buttons
      document.querySelectorAll(".pres-liquor-pick").forEach(b => b.classList.remove("border-[var(--gold)]", "bg-[var(--gold)]/15"));

      if (presSingleView && !presSingleView.classList.contains("hidden")) {
        presSingleView.style.opacity = "0";
        presSingleView.style.transform = "scale(0.96)";
        setTimeout(() => {
          presSingleView.classList.add("hidden");
          if (presProductsGrid) {
            presProductsGrid.classList.remove("hidden");
            presProductsGrid.style.opacity = "0";
            presProductsGrid.style.transform = "scale(0.96)";
            requestAnimationFrame(() => {
              presProductsGrid.style.opacity = "1";
              presProductsGrid.style.transform = "scale(1)";
            });
          }
          initKitParallax();
        }, 180);
      } else {
        if (presSingleView) presSingleView.classList.add("hidden");
        if (presProductsGrid) {
          presProductsGrid.classList.remove("hidden");
          presProductsGrid.style.opacity = "1";
          presProductsGrid.style.transform = "scale(1)";
        }
      }
    }

    function showPresStep(step) {
      currentStep = step;
      renderStepper(4, step, ["Licor", "Acomp.", "Caixa", "Resumo"]);
      presStep1?.classList.toggle("hidden", step !== 1);
      presStep2?.classList.toggle("hidden", step !== 2);
      presStep3?.classList.toggle("hidden", step !== 3);
      presStep4?.classList.toggle("hidden", step !== 4);

      if (step === 1) {
        if (presProduct) {
          if (presProductsGrid) presProductsGrid.classList.add("hidden");
          if (presSingleView) {
            presSingleView.classList.remove("hidden");
            presSingleView.style.opacity = "1";
            presSingleView.style.transform = "scale(1)";
          }
          renderSinglePresView();
          if (presNext1) presNext1.disabled = false;
        } else {
          if (presSingleView) presSingleView.classList.add("hidden");
          if (presProductsGrid) {
            presProductsGrid.classList.remove("hidden");
            presProductsGrid.style.opacity = "1";
            presProductsGrid.style.transform = "scale(1)";
          }
          if (presNext1) presNext1.disabled = true;
        }
      }

      if (step === 3 && presProduct) {
        const cat = presProduct.cat;
        const priceMdf = kitPrices.find(k => k.kit_type === 'presenteavel' && k.licor_categoria === cat && k.embalagem === 'mdf')?.preco || 110;
        const priceAcrilico = kitPrices.find(k => k.kit_type === 'presenteavel' && k.licor_categoria === cat && k.embalagem === 'acrilico')?.preco || 130;
        if (priceMdfLabel) priceMdfLabel.textContent = `Total: R$ ${priceMdf},00`;
        if (priceAcrilicoLabel) priceAcrilicoLabel.textContent = `Total: R$ ${priceAcrilico},00`;
      }

      if (step === 4 && presProduct && presAcomp && presBox) {
        const cat = presProduct.cat;
        const finalPrice = kitPrices.find(k => k.kit_type === 'presenteavel' && k.licor_categoria === cat && k.embalagem === presBox.id)?.preco || 120;
        if (presSummaryList) {
          presSummaryList.innerHTML = `
            <li class="py-1">✦ Licor 500ml: <strong>${presProduct.name}</strong> (${presProduct.sabor})</li>
            <li class="py-1">✦ Acompanhamento: <strong>${presAcomp.label}</strong></li>
            <li class="py-1">✦ Embalagem: <strong>${presBox.label}</strong></li>
          `;
        }
        if (presTotalPrice) {
          presTotalPrice.textContent = `R$ ${finalPrice},00`;
        }
      }
      initKitParallax();
    }

    document.querySelectorAll(".pres-liquor-pick").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.hasAttribute("disabled") || btn.disabled || btn.getAttribute("data-stock") === "0") return;
        const id = btn.getAttribute("data-id");
        const name = btn.getAttribute("data-name");
        const sabor = btn.getAttribute("data-sabor");
        const foto = btn.getAttribute("data-foto") || "";
        const cat = btn.getAttribute("data-cat");
        selectPresProduct({ id, name, sabor, foto, cat });
      });
    });

    document.querySelectorAll(".pres-acomp-pick").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".pres-acomp-pick").forEach(b => b.classList.remove("border-[var(--gold)]", "bg-[var(--gold)]/15"));
        btn.classList.add("border-[var(--gold)]", "bg-[var(--gold)]/15");
        presAcomp = {
          id: btn.getAttribute("data-id"),
          label: btn.getAttribute("data-label")
        };
        if (presNext2) presNext2.disabled = false;
      });
    });

    document.querySelectorAll(".pres-box-pick").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".pres-box-pick").forEach(b => b.classList.remove("border-[var(--gold)]", "bg-[var(--gold)]/15"));
        btn.classList.add("border-[var(--gold)]", "bg-[var(--gold)]/15");
        presBox = {
          id: btn.getAttribute("data-id"),
          label: btn.getAttribute("data-label")
        };
        if (presNext3) presNext3.disabled = false;
      });
    });

    presNext1?.addEventListener("click", () => showPresStep(2));
    presPrev2?.addEventListener("click", () => showPresStep(1));
    presNext2?.addEventListener("click", () => showPresStep(3));
    presPrev3?.addEventListener("click", () => showPresStep(2));
    presNext3?.addEventListener("click", () => showPresStep(4));
    presPrev4?.addEventListener("click", () => showPresStep(3));

    presAddCartBtn?.addEventListener("click", () => {
      if (!presProduct || !presAcomp || !presBox) return;
      const cat = presProduct.cat;
      const finalPrice = kitPrices.find(k => k.kit_type === 'presenteavel' && k.licor_categoria === cat && k.embalagem === presBox.id)?.preco || 120;
      const ded = presDedicatoria ? presDedicatoria.value.trim() : "";

      window.dispatchEvent(new CustomEvent("add-to-cart", {
        detail: {
          tipo: "kit-presenteavel",
          id: `kit-presenteavel-${Date.now()}`,
          nome: "Kit Presenteável",
          preco: finalPrice,
          qty: 1,
          licor: { id: presProduct.id, nome: presProduct.name, sabor: presProduct.sabor },
          acompanhamento: presAcomp.label,
          embalagem: presBox.label,
          dedicatoria: ded
        }
      }));

      flowPresenteavel?.classList.add("hidden");
      postAddCta?.classList.remove("hidden");
    });

    // POST-ADD BUTTONS
    document.getElementById("post-add-new-btn")?.addEventListener("click", () => {
      degSelected = [];
      updateDegChips();
      presProduct = null;
      presAcomp = null;
      presBox = null;
      deselectPresProduct();
      setMode("");
    });

    document.getElementById("post-add-open-cart-btn")?.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("open-cart"));
    });

    // Initial Parallax Setup
    initKitParallax();

    // Check initial search param
    const params = new URLSearchParams(window.location.search);
    const initialKit = params.get("kit") || params.get("modo");
    if (initialKit === "degustacao" || initialKit === "presenteavel") {
      setMode(initialKit);
    }
  }

  setupMonteKit();
  document.addEventListener("astro:page-load", setupMonteKit);
</script>
