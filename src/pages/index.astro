---
import Layout from '../layouts/Layout.astro';
import HeroCinematic from '../components/HeroCinematic.astro';
import ProductCard from '../components/ProductCard.astro';
import RituaisDegustacao from '../components/RituaisDegustacao.astro';
import InfiniteMarquee from '../components/InfiniteMarquee.astro';
import Button from '../components/Button.astro';
import { fetchProducts, fetchTestimonials, fetchFeaturedProducts } from '../lib/data';

const products = await fetchProducts();
const testimonials = await fetchTestimonials();
const featured = await fetchFeaturedProducts();

const doubledTestimonials = [...testimonials, ...testimonials];
---

<Layout title="Alquimista Licores — Licores artesanais de Criciúma">
  <div>
    <!-- HERO SECTION (CINEMATIC SCROLL-DRIVEN VIDEO) -->
    <HeroCinematic />

    <!-- INFINITE MARQUEE BAR -->
    <InfiniteMarquee />

    <!-- FEATURED POTIONS SECTION -->
    <section id="pocoes" class="max-w-7xl mx-auto px-6 lg:px-10 py-16 relative z-10 scroll-mt-24">
      <div class="text-center mb-12">
        <div class="text-[var(--gold)]/50 text-sm mb-2 font-serif">✦</div>
        <h2 class="text-3xl md:text-5xl font-medium text-[var(--cream)] tracking-wide">
          Poções em destaque
        </h2>
        <div class="w-16 h-px bg-[var(--gold)]/40 mx-auto mt-4"></div>
        <p class="font-sans italic text-base md:text-lg text-[var(--text-soft)] mt-3">
          As favoritas de quem já provou
        </p>
      </div>

      <div id="featured-potions-grid" class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
        {featured.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </section>

    <!-- RITUAIS DE DEGUSTAÇÃO (GRIMÓRIO INTERATIVO // 100% TRANSPARENTE) -->
    <RituaisDegustacao />

    <!-- DIVISÓRIA FINA DE UMA PONTA À OUTRA -->
    <div class="w-full h-px bg-[var(--gold)]/20 relative z-10" aria-hidden="true"></div>

    <!-- KITS FIXED BACKGROUND REVEAL SECTION -->
    <section class="relative z-10 w-full min-h-[60vh] md:min-h-[75vh] flex items-center justify-center overflow-hidden [clip-path:inset(0)]">
      <!-- Fixed Background Window (Permanece fixo no viewport enquanto o scroll revela a dobra) -->
      <div class="fixed inset-0 w-full h-full pointer-events-none z-0">
        <img
          src="/assets/caixa-premium.png"
          alt="Kits artesanais Alquimista para ocasiões especiais"
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
        <!-- Atmospheric Dark Overlay for Contrast -->
        <div class="absolute inset-0 bg-black/60"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_transparent_30%,_rgba(0,0,0,0.6)_100%)]"></div>
      </div>

      <!-- Content Layer -->
      <div class="relative z-10 max-w-3xl mx-auto px-6 py-20 md:py-28 text-center flex flex-col items-center justify-center">
        <h2 class="font-serif italic text-2xl sm:text-3xl md:text-5xl text-[var(--cream)] leading-snug md:leading-tight mb-8 md:mb-10 drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)] max-w-2xl">
          Para quem merece algo raro.<br class="hidden sm:inline" /> Kits artesanais para ocasiões especiais.
        </h2>

        <Button
          href="/monte-seu-kit"
          variant="outline"
          size="lg"
          class="bg-transparent hover:bg-[var(--gold)]/15 border-[var(--gold)]/60 text-[var(--cream)] hover:text-[var(--gold-bright)] transition-all"
        >
          <span>Monte seu kit</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7l7 7-7 7"/></svg>
        </Button>
      </div>
    </section>

    <!-- TESTIMONIALS CAROUSEL -->
    <section class="py-20 overflow-hidden border-y border-[var(--gold)]/15 bg-[var(--surface)]/40 relative z-10">
      <div class="text-center mb-10 px-6">
        <h2 class="text-3xl md:text-4xl font-medium text-[var(--cream)] uppercase tracking-[0.12em]">
          O que dizem nossos apreciadores
        </h2>
        <div class="w-16 h-px bg-[var(--gold)]/40 mx-auto mt-4"></div>
      </div>

      <div class="testi-track-wrap" id="testiTrackWrap">
        <div class="testi-track" id="testiTrack">
          {doubledTestimonials.map((t, idx) => (
            <div class="testi-card" key={`${t.id}-${idx}`}>
              <div class="testi-card-inner p-3 md:p-4 bg-transparent">
                <div class="font-display text-2xl text-[var(--gold)] leading-none mb-1.5">“</div>
                <p class="font-sans italic text-sm md:text-[15px] text-[var(--cream)]/90 leading-relaxed min-h-[3.6rem]">
                  {t.texto}
                </p>
                <div class="testi-stars flex gap-1 mt-3 text-[var(--gold)] text-xs origin-left transition-all duration-300">
                  <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                </div>
                <h3 class="font-display text-xs md:text-sm tracking-widest uppercase text-[var(--gold)] mt-2 font-bold">
                  — {t.nome}
                </h3>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="text-center mt-12 px-6">
        <p class="font-body font-normal text-base md:text-lg text-[var(--text-soft)] mb-4">
          Compartilhe sua experiência e apareça aqui.
        </p>
        <Button
          href="https://g.page/r/CWzwaZr9lnaDEAE/review"
          target="_blank"
          rel="noreferrer"
          variant="shimmer"
          size="md"
        >
          <span>Deixar minha avaliação</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </Button>
      </div>
    </section>

    <!-- STORY QUOTE (FEITO COM (C)ALMA) -->
    <section class="py-24 md:py-32 px-6 text-center relative z-10">
      <div class="max-w-3xl mx-auto reveal">
        <p class="font-body italic text-xl md:text-2xl text-[var(--text-soft)] leading-relaxed mb-4 md:mb-5">
          <span class="text-[var(--gold)]/60 font-serif text-2xl md:text-3xl leading-none select-none align-middle mr-1 font-normal">“</span>Na alquimia, transformar o simples em extraordinário é arte.<br class="hidden sm:inline" /> Cada garrafa carrega intenção, ingredientes naturais e cuidado,<br class="hidden sm:inline" /> pois aqui tudo é
        </p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium text-[var(--cream)] mb-8 md:mb-10 uppercase tracking-widest font-display">
          Feito com (c)alma.
        </h2>
        <Button
          href="/sobre"
          variant="ghost"
          size="md"
          class="hover:text-[var(--gold-bright)] text-[var(--gold-light)] border border-transparent hover:border-[var(--gold)]/30 transition-all"
        >
          <span>Conheça a história do Alquimista</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7l7 7-7 7"/></svg>
        </Button>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupTestimonialsCenterGlow() {
    const wrap = document.getElementById("testiTrackWrap");
    if (!wrap) return;

    const cards = wrap.querySelectorAll<HTMLElement>(".testi-card");
    let isIntersecting = false;
    let rafId = 0;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isIntersecting = entry.isIntersecting;
          if (isIntersecting) {
            startLoop();
          } else {
            cancelAnimationFrame(rafId);
          }
        });
      },
      { threshold: 0.05 }
    );

    observer.observe(wrap);

    function tick() {
      if (!isIntersecting) return;
      const wrapRect = wrap!.getBoundingClientRect();
      const centerX = wrapRect.left + wrapRect.width / 2;
      const maxDist = wrapRect.width * 0.30;

      cards.forEach((card) => {
        const inner = card.querySelector<HTMLElement>(".testi-card-inner");
        const stars = card.querySelector<HTMLElement>(".testi-stars");
        if (!inner) return;

        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const dist = Math.abs(cardCenter - centerX);

        if (dist < maxDist) {
          // Smooth cosine curve from 0 to 1 at the center
          const factor = Math.cos((dist / maxDist) * (Math.PI / 2));
          const scale = 1 + factor * 0.22;
          inner.style.transform = `scale(${scale})`;
          inner.style.opacity = `${0.75 + factor * 0.25}`;

          if (stars) {
            stars.style.transformOrigin = "left center";
            stars.style.filter = `drop-shadow(0 0 ${factor * 8}px rgba(212, 178, 58, ${factor * 1}))`;
            stars.style.transform = `scale(${1 + factor * 0.15})`;
          }
        } else {
          inner.style.transform = "scale(1)";
          inner.style.opacity = "0.75";
          if (stars) {
            stars.style.transformOrigin = "left center";
            stars.style.filter = "none";
            stars.style.transform = "scale(1)";
          }
        }
      });

      rafId = requestAnimationFrame(tick);
    }

    function startLoop() {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(tick);
    }
  }

  import { fetchFeaturedProducts, fmtPrice, categoriaLabel, needsPrep } from '../lib/data';

  async function syncFeaturedPotions() {
    const grid = document.getElementById("featured-potions-grid");
    if (!grid) return;

    try {
      const freshFeatured = await fetchFeaturedProducts();
      if (!Array.isArray(freshFeatured) || freshFeatured.length === 0) return;

      const currentCards = Array.from(grid.querySelectorAll<HTMLElement>(".product-card"));
      const currentIds = currentCards
        .map((el) => {
          try {
            return JSON.parse(el.dataset.product || "{}")?.id;
          } catch {
            return null;
          }
        })
        .filter(Boolean);

      const freshIds = freshFeatured.map((p) => p.id);

      // Re-renderiza se os IDs, ordem, estoque ou preço mudaram
      const hasChanged = currentCards.length !== freshFeatured.length || freshFeatured.some((freshP, idx) => {
        try {
          const currentP = JSON.parse(currentCards[idx]?.dataset.product || "{}");
          return (
            currentP.id !== freshP.id || 
            Number(currentP.estoque ?? 0) !== Number(freshP.estoque ?? 0) || 
            Number(currentP.preco) !== Number(freshP.preco)
          );
        } catch {
          return true;
        }
      });
      if (!hasChanged) return;

      grid.innerHTML = freshFeatured.map((p) => {
        const isOutOfStock = (p.estoque || 0) <= 0;
        const hasPrep = needsPrep(p);

        return `
          <div
            class="product-card group relative flex flex-col md:block aspect-auto md:aspect-[4/5] bg-[var(--surface)] border border-[rgba(178,140,70,0.2)] rounded-md overflow-hidden hover:border-[#B28C46] cursor-pointer select-none"
            data-product='${JSON.stringify(p)}'
          >
            <div class="product-glare pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 rounded-md z-30"></div>
            
            <div class="relative w-full aspect-square md:absolute md:inset-x-0 md:top-0 md:h-[70%] md:aspect-auto md:w-auto bg-gradient-to-b from-[var(--surface-elevated)] to-[var(--background)] overflow-hidden transition-[height,opacity] duration-700 ease-out md:group-hover:h-full md:group-hover:opacity-35 ${isOutOfStock ? 'opacity-80' : ''}">
              <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 bg-[radial-gradient(circle_at_50%_0%,_rgba(184,111,42,0.35)_0%,_transparent_60%)] z-10"></div>
              ${p.foto_url 
                ? `<img src="${p.foto_url}" alt="${p.nome}" loading="lazy" decoding="async" class="product-img w-full h-full object-cover transition-transform duration-700" />` 
                : `<div class="w-full h-full flex items-center justify-center text-[var(--gold)]/30 text-7xl">⚗</div>`
              }
              <div class="hidden md:flex absolute top-3 left-3 z-20 gap-1.5 pointer-events-none">
                <span class="badge-pill-gold text-[11px] py-1 px-2.5">${categoriaLabel(p.categoria)}</span>
              </div>
              ${hasPrep && !isOutOfStock ? `<div class="absolute top-3 right-3 z-20 pointer-events-none"><span class="badge-pill-ember text-[11px] py-1 px-2.5">Sob Encomenda</span></div>` : ''}
              ${isOutOfStock ? `<div class="absolute inset-0 z-20 flex items-center justify-center bg-black/35 backdrop-blur-[0.5px]"><span class="badge-pill-ember text-xs py-1.5 px-3.5 shadow-2xl font-bold uppercase tracking-widest scale-105">Lote Esgotado</span></div>` : ''}
              <div class="md:hidden absolute inset-x-0 bottom-0 pt-8 px-3 pb-2 bg-gradient-to-t from-black/90 via-black/60 to-transparent pointer-events-none">
                <div class="font-mono text-[10px] text-[var(--gold)] tracking-widest uppercase">${categoriaLabel(p.categoria)}</div>
                <div class="font-serif text-sm text-[var(--cream)] mt-0.5 leading-tight font-medium">${p.sabor || ''}</div>
              </div>
            </div>

            <div class="md:hidden relative h-11 px-3 flex items-center justify-between bg-[var(--surface)] border-t border-[var(--gold)]/15">
              <div class="font-display font-semibold text-sm sm:text-base text-[var(--gold)]">${fmtPrice(p.preco)}</div>
              ${!isOutOfStock ? `
                <button type="button" class="quick-add-btn w-7.5 h-7.5 flex items-center justify-center border border-[var(--gold)]/40 text-[var(--gold)] hover:bg-[var(--gold)] hover:text-[var(--background)] transition-colors rounded-md" title="Adicionar ao caldeirão" aria-label="Adicionar ao caldeirão" data-id="${p.id}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 52.84 57.18" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M6.1 15.27l-4.47 -10.93c-0.31,-0.77 0.06,-1.66 0.83,-1.97l3.59 -1.47c0.77,-0.31 1.66,0.06 1.97,0.83l4.47 10.93c0.25,0.01 0.51,0.04 0.76,0.07 -0.05,-0.95 0.66,-1.79 1.62,-1.87l14.21 -1.3 3.38 -8.44c0.36,-0.91 1.41,-1.36 2.32,-0.99l16.95 6.79c0.91,0.36 1.36,1.41 0.99,2.32l-6.25 15.62 3.06 0c0.99,0 1.79,0.8 1.79,1.79 0,0.99 -0.8,1.79 -1.79,1.79l-1.16 0c1.59,3.64 2.04,7.66 1.07,11.54 -1.14,4.58 -4.04,8.32 -7.82,11.05l2.44 3.33c0.58,0.79 0.41,1.91 -0.38,2.49 -0.79,0.58 -1.91,0.41 -2.49,-0.38l-2.66 -3.62c-4,1.84 -8.48,2.71 -12.88,2.71 -4.39,0 -8.87,-0.87 -12.88,-2.71l-2.66 3.62c-0.58,0.79 -1.7,0.97 -2.49,0.38 -0.79,-0.58 -0.97,-1.7 -0.38,-2.49l2.44 -3.33c-3.78,-2.73 -6.68,-6.47 -7.82,-11.05 -0.96,-3.88 -0.52,-7.9 1.07,-11.54l-1.16 0c-0.99,0 -1.79,-0.8 -1.79,-1.79 0,-0.99 0.8,-1.79 1.79,-1.79l3.15 0 -0.43 -1.04c-0.02,-0.05 -0.04,-0.1 -0.06,-0.15 -1.08,-2.88 -0.44,-6.13 1.65,-8.39zm7.43 0.61c-0.62,-0.18 -1.27,-0.24 -1.91,-0.18 -0.66,0.06 -1.29,-0.32 -1.54,-0.93l-4.29 -10.49 -0.79 0.32 4.29 10.49c0.25,0.62 0.07,1.32 -0.44,1.75 -1.73,1.41 -2.33,3.74 -1.54,5.83l0.01 0.03c0,0 0,0.01 0,0.01l0.1 0.25 6.51 -2.66 -0.4 -4.42zm0.69 7.56l-3.44 1.41 3.57 0 -0.13 -1.41zm3.7 1.41l13.45 0 -1.08 -11.83 -13.34 1.22 0.97 10.61zm17.03 0l7.67 0 6.12 -15.29 -13.64 -5.46 -2.2 5.51 0.07 0.05 0.09 0.07 0.06 0.06 0.06 0.06 0.06 0.06 0.05 0.06 0.05 0.07 0.05 0.07 0.05 0.07 0.04 0.08 0.06 0.12 0.04 0.1 0.03 0.08 0.03 0.09 0.02 0.09 0.02 0.09 0.01 0.09 1.27 13.95zm-28.04 3.57c-1.81,3.28 -2.5,7.02 -1.59,10.69 1.05,4.24 4.02,7.55 7.66,9.83l0.16 0.1c3.8,2 8.23,2.93 12.51,2.93 4.29,0 8.71,-0.92 12.51,-2.92l0.16 -0.1c3.64,-2.28 6.6,-5.59 7.66,-9.83 0.91,-3.67 0.23,-7.4 -1.59,-10.69l-37.47 0z"/></svg>
                </button>
              ` : ''}
            </div>

            <div class="hidden md:block absolute inset-x-0 bottom-0 p-4 pt-2.5 bg-[var(--surface)] transition-colors duration-700 md:group-hover:bg-transparent">
              <h3 class="font-display font-semibold text-base lg:text-lg text-[var(--gold)] tracking-wider leading-tight">${p.nome}</h3>
              <div class="font-serif italic text-sm text-[var(--gold-soft)] mt-0.5 font-medium">${p.sabor || ''}</div>
              <div class="flex items-end justify-between mt-2 pt-2 border-t border-[var(--gold)]/15">
                <div class="font-display font-bold text-lg lg:text-xl text-[var(--gold)]">${fmtPrice(p.preco)}</div>
                ${!isOutOfStock ? `
                  <button type="button" class="quick-add-btn w-8.5 h-8.5 flex items-center justify-center border border-[var(--gold)]/40 text-[var(--gold)] bg-[var(--surface)]/80 hover:bg-[var(--gold)] hover:text-[var(--background)] transition-colors rounded-md backdrop-blur-sm shadow-md" title="Adicionar ao caldeirão" aria-label="Adicionar ao caldeirão" data-id="${p.id}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 52.84 57.18" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M6.1 15.27l-4.47 -10.93c-0.31,-0.77 0.06,-1.66 0.83,-1.97l3.59 -1.47c0.77,-0.31 1.66,0.06 1.97,0.83l4.47 10.93c0.25,0.01 0.51,0.04 0.76,0.07 -0.05,-0.95 0.66,-1.79 1.62,-1.87l14.21 -1.3 3.38 -8.44c0.36,-0.91 1.41,-1.36 2.32,-0.99l16.95 6.79c0.91,0.36 1.36,1.41 0.99,2.32l-6.25 15.62 3.06 0c0.99,0 1.79,0.8 1.79,1.79 0,0.99 -0.8,1.79 -1.79,1.79l-1.16 0c1.59,3.64 2.04,7.66 1.07,11.54 -1.14,4.58 -4.04,8.32 -7.82,11.05l2.44 3.33c0.58,0.79 0.41,1.91 -0.38,2.49 -0.79,0.58 -1.91,0.41 -2.49,-0.38l-2.66 -3.62c-4,1.84 -8.48,2.71 -12.88,2.71 -4.39,0 -8.87,-0.87 -12.88,-2.71l-2.66 3.62c-0.58,0.79 -1.7,0.97 -2.49,0.38 -0.79,-0.58 -0.97,-1.7 -0.38,-2.49l2.44 -3.33c-3.78,-2.73 -6.68,-6.47 -7.82,-11.05 -0.96,-3.88 -0.52,-7.9 1.07,-11.54l-1.16 0c-0.99,0 -1.79,-0.8 -1.79,-1.79 0,-0.99 0.8,-1.79 1.79,-1.79l3.15 0 -0.43 -1.04c-0.02,-0.05 -0.04,-0.1 -0.06,-0.15 -1.08,-2.88 -0.44,-6.13 1.65,-8.39zm7.43 0.61c-0.62,-0.18 -1.27,-0.24 -1.91,-0.18 -0.66,0.06 -1.29,-0.32 -1.54,-0.93l-4.29 -10.49 -0.79 0.32 4.29 10.49c0.25,0.62 0.07,1.32 -0.44,1.75 -1.73,1.41 -2.33,3.74 -1.54,5.83l0.01 0.03c0,0 0,0.01 0,0.01l0.1 0.25 6.51 -2.66 -0.4 -4.42zm0.69 7.56l-3.44 1.41 3.57 0 -0.13 -1.41zm3.7 1.41l13.45 0 -1.08 -11.83 -13.34 1.22 0.97 10.61zm17.03 0l7.67 0 6.12 -15.29 -13.64 -5.46 -2.2 5.51 0.07 0.05 0.09 0.07 0.06 0.06 0.06 0.06 0.06 0.06 0.05 0.06 0.05 0.07 0.05 0.07 0.05 0.07 0.04 0.08 0.06 0.12 0.04 0.1 0.03 0.08 0.03 0.09 0.02 0.09 0.02 0.09 0.01 0.09 1.27 13.95zm-28.04 3.57c-1.81,3.28 -2.5,7.02 -1.59,10.69 1.05,4.24 4.02,7.55 7.66,9.83l0.16 0.1c3.8,2 8.23,2.93 12.51,2.93 4.29,0 8.71,-0.92 12.51,-2.92l0.16 -0.1c3.64,-2.28 6.6,-5.59 7.66,-9.83 0.91,-3.67 0.23,-7.4 -1.59,-10.69l-37.47 0z"/></svg>
                  </button>
                ` : ''}
              </div>
            </div>
          </div>
        `;
      }).join("");

      window.dispatchEvent(new CustomEvent("products-rendered"));
    } catch (e) {
      console.warn("Erro ao sincronizar destaques:", e);
    }
  }

  function initInteractiveEffects() {
    setupTestimonialsCenterGlow();
    syncFeaturedPotions();
  }

  initInteractiveEffects();
  document.addEventListener("astro:page-load", initInteractiveEffects);
</script>
