---
import Layout from '../layouts/Layout.astro';
import HeroCinematic from '../components/HeroCinematic.astro';
import ProductCard from '../components/ProductCard.astro';
import RituaisDegustacao from '../components/RituaisDegustacao.astro';
import InfiniteMarquee from '../components/InfiniteMarquee.astro';
import Button from '../components/Button.astro';
import { fetchProducts, fetchTestimonials } from '../lib/data';

const products = await fetchProducts();
const testimonials = await fetchTestimonials();

// Get top 4 featured potions (either by orders count or first 4 active)
const featured = [...products]
  .sort((a, b) => (b.pedidos_count || 0) - (a.pedidos_count || 0))
  .slice(0, 4);

const doubledTestimonials = [...testimonials, ...testimonials];
---

<Layout title="Alquimista Licores — Licores artesanais de Criciúma">
  <div>
    <!-- HERO SECTION (CINEMATIC SCROLL-DRIVEN VIDEO) -->
    <HeroCinematic />

    <!-- INFINITE MARQUEE BAR -->
    <InfiniteMarquee />

    <!-- STORY QUOTE -->
    <section class="py-28 md:py-36 px-6 text-center relative z-10">
      <div class="max-w-3xl mx-auto reveal">
        <p class="font-sans italic text-xl md:text-2xl text-[var(--text-soft)] leading-relaxed mb-8">
          Na alquimia, transformar o simples em extraordinário é arte. Cada garrafa que sai daqui carrega intenção, ingredientes naturais e cuidado especial.
        </p>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-medium text-[var(--cream)] mb-12">
          Feito com (c)alma.
        </h2>
        <Button
          href="/sobre"
          variant="outline"
          size="md"
          class="gold-glow-hover"
        >
          <span>Conheça a história do Alquimista</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7l7 7-7 7"/></svg>
        </Button>
      </div>
    </section>

    <!-- FEATURED POTIONS SECTION -->
    <section id="pocoes" class="max-w-7xl mx-auto px-6 lg:px-10 py-16 relative z-10 scroll-mt-24">
      <div class="text-center mb-12">
        <div class="text-[var(--gold)]/50 text-sm mb-2 font-serif">✦</div>
        <h2 class="text-3xl md:text-5xl font-medium text-[var(--cream)] tracking-wide">
          Poções em destaque
        </h2>
        <div class="w-16 h-px bg-[var(--gold)]/40 mx-auto mt-4"></div>
        <p class="font-sans italic text-base md:text-lg text-[var(--text-soft)] mt-3">
          Os preferidos do Alquimista.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
        {featured.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>

      <div class="text-center mt-12">
        <Button
          href="/pocoes"
          variant="outline"
          size="md"
        >
          <span>Ver todas as poções</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7l7 7-7 7"/></svg>
        </Button>
      </div>
    </section>

    <!-- RITUAIS DE DEGUSTAÇÃO (GRIMÓRIO INTERATIVO // 100% TRANSPARENTE) -->
    <RituaisDegustacao />

    <!-- KITS BANNER (3D SCROLL PARALLAX: BACKGROUND, TEXT, BUTTON) -->
    <section class="px-6 py-20 relative z-10" id="kitsParallaxSection">
      <div
        id="kitsBannerCard"
        class="max-w-6xl mx-auto relative overflow-hidden rounded-md border border-[var(--gold)]/30 p-12 md:p-24 text-center gold-glow shadow-2xl"
        style="perspective: 1000px; transform-style: preserve-3d;"
      >
        <!-- Background Layer (Deep Z, moves gently slower on scroll) -->
        <div
          id="kitsParallaxBg"
          class="absolute -inset-[20%] w-[140%] h-[140%] bg-cover bg-center pointer-events-none will-change-transform"
          style="background-image: url('/assets/kits-banner.png'); transform: translate3d(0px, 0px, -15px) scale(1.15);"
        ></div>

        <!-- Atmospheric overlays -->
        <div class="absolute inset-0 bg-[var(--background)]/75 pointer-events-none"></div>
        <div class="absolute inset-0 opacity-25 bg-[radial-gradient(circle_at_30%_30%,_var(--gold)_0%,_transparent_65%)] pointer-events-none"></div>
        
        <!-- Content Container with 3D Preservation -->
        <div class="relative z-10 max-w-3xl mx-auto pointer-events-auto" style="transform-style: preserve-3d;">
          <!-- Text Layer (Mid Z, rises gently on scroll) -->
          <div
            id="kitsParallaxText"
            class="will-change-transform"
            style="transform: translate3d(0px, 0px, 15px);"
          >
            <h2 class="font-sans italic text-2xl md:text-4xl text-[var(--cream)] leading-relaxed mb-10 drop-shadow-[0_4px_12px_rgba(0,0,0,0.8)]">
              Para quem merece algo raro.<br />Kits artesanais para ocasiões especiais.
            </h2>
          </div>

          <!-- Button Layer (Front Z, rises gently on scroll) -->
          <div
            id="kitsParallaxBtn"
            class="will-change-transform"
            style="transform: translate3d(0px, 0px, 30px);"
          >
            <Button
              href="/kits"
              variant="primary"
              size="lg"
            >
              <span>Explorar Kits</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7l7 7-7 7"/></svg>
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS CAROUSEL -->
    <section class="py-20 overflow-hidden border-y border-[var(--gold)]/15 bg-[var(--surface)]/40 relative z-10">
      <div class="text-center mb-10 px-6">
        <h2 class="text-3xl md:text-4xl font-medium text-[var(--cream)] uppercase tracking-[0.12em]">
          O que dizem nossos apreciadores
        </h2>
        <div class="w-16 h-px bg-[var(--gold)]/40 mx-auto mt-4"></div>
      </div>

      <div class="testi-track-wrap" id="testiTrackWrap">
        <div class="testi-track" id="testiTrack">
          {doubledTestimonials.map((t, idx) => (
            <div class="testi-card" key={`${t.id}-${idx}`}>
              <div class="testi-card-inner p-3 md:p-4 bg-transparent">
                <div class="font-display text-2xl text-[var(--gold)] leading-none mb-1.5">“</div>
                <p class="font-sans italic text-sm md:text-[15px] text-[var(--cream)]/90 leading-relaxed min-h-[3.6rem]">
                  {t.texto}
                </p>
                <div class="testi-stars flex gap-1 mt-3 text-[var(--gold)] text-xs origin-left transition-all duration-300">
                  <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                </div>
                <h3 class="font-display text-xs md:text-sm tracking-widest uppercase text-[var(--gold)] mt-2 font-bold">
                  — {t.nome}
                </h3>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="text-center mt-12 px-6">
        <p class="font-sans italic text-base md:text-lg text-[var(--text-soft)] mb-4">
          Compartilhe sua experiência e apareça aqui.
        </p>
        <a
          href="https://g.page/r/CWzwaZr9lnaDEAE/review"
          target="_blank"
          rel="noreferrer"
          class="inline-block px-10 py-4 bg-transparent border border-[var(--gold)]/60 text-[var(--gold)] font-sans font-bold tracking-[0.2em] uppercase hover:bg-[var(--gold)] hover:text-[var(--background)] transition-all rounded-sm text-xs"
        >
          Deixar minha avaliação
        </a>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupTestimonialsCenterGlow() {
    const wrap = document.getElementById("testiTrackWrap");
    if (!wrap) return;

    const cards = wrap.querySelectorAll<HTMLElement>(".testi-card");
    let isIntersecting = false;
    let rafId = 0;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isIntersecting = entry.isIntersecting;
          if (isIntersecting) {
            startLoop();
          } else {
            cancelAnimationFrame(rafId);
          }
        });
      },
      { threshold: 0.05 }
    );

    observer.observe(wrap);

    function tick() {
      if (!isIntersecting) return;
      const wrapRect = wrap!.getBoundingClientRect();
      const centerX = wrapRect.left + wrapRect.width / 2;
      const maxDist = wrapRect.width * 0.30;

      cards.forEach((card) => {
        const inner = card.querySelector<HTMLElement>(".testi-card-inner");
        const stars = card.querySelector<HTMLElement>(".testi-stars");
        if (!inner) return;

        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const dist = Math.abs(cardCenter - centerX);

        if (dist < maxDist) {
          // Smooth cosine curve from 0 to 1 at the center
          const factor = Math.cos((dist / maxDist) * (Math.PI / 2));
          const scale = 1 + factor * 0.22;
          inner.style.transform = `scale(${scale})`;
          inner.style.opacity = `${0.75 + factor * 0.25}`;

          if (stars) {
            stars.style.transformOrigin = "left center";
            stars.style.filter = `drop-shadow(0 0 ${factor * 8}px rgba(212, 178, 58, ${factor * 1}))`;
            stars.style.transform = `scale(${1 + factor * 0.15})`;
          }
        } else {
          inner.style.transform = "scale(1)";
          inner.style.opacity = "0.75";
          if (stars) {
            stars.style.transformOrigin = "left center";
            stars.style.filter = "none";
            stars.style.transform = "scale(1)";
          }
        }
      });

      rafId = requestAnimationFrame(tick);
    }

    function startLoop() {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(tick);
    }
  }

  function setupKitsParallax() {
    const card = document.getElementById("kitsBannerCard");
    const bg = document.getElementById("kitsParallaxBg");
    const text = document.getElementById("kitsParallaxText");
    const btn = document.getElementById("kitsParallaxBtn");

    if (!card || !bg || !text || !btn) return;

    let rafId = 0;
    let isIntersecting = false;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isIntersecting = entry.isIntersecting;
          if (isIntersecting) {
            startParallaxLoop();
          } else {
            cancelAnimationFrame(rafId);
          }
        });
      },
      { threshold: 0.02 }
    );

    observer.observe(card);

    function updateParallax() {
      if (!isIntersecting) return;

      const rect = card!.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // When the card is within or near the viewport
      if (rect.bottom >= -150 && rect.top <= windowHeight + 150) {
        const bannerCenter = rect.top + rect.height / 2;
        const viewportCenter = windowHeight / 2;
        // Offset in pixels from the screen center
        const offset = bannerCenter - viewportCenter;

        // 1. Fundo (Background Image): deslocamento suave e sutil (fundo em 3D)
        const bgY = offset * 0.08;
        bg!.style.transform = `translate3d(0px, ${bgY.toFixed(1)}px, -15px) scale(1.15)`;

        // 2. Texto Poético: deslocamento suave intermediário
        const textY = offset * -0.05;
        text!.style.transform = `translate3d(0px, ${textY.toFixed(1)}px, 15px)`;

        // 3. Botão Dourado: deslocamento suave no primeiro plano
        const btnY = offset * -0.10;
        btn!.style.transform = `translate3d(0px, ${btnY.toFixed(1)}px, 30px)`;
      }

      rafId = requestAnimationFrame(updateParallax);
    }

    function startParallaxLoop() {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(updateParallax);
    }

    // Direct scroll event listener for instant response
    window.addEventListener("scroll", updateParallax, { passive: true });
  }

  function initInteractiveEffects() {
    setupTestimonialsCenterGlow();
    setupKitsParallax();
  }

  initInteractiveEffects();
  document.addEventListener("astro:page-load", initInteractiveEffects);
</script>
