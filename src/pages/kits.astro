---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
---

<Layout
  title="Kits & Presentes — Alquimista Licores"
  description="Kits artesanais para presentear: Degustação com 3 mini-poções ou Presenteável em caixa de madeira MDF ou Acrílico Premium."
>
  <div class="max-w-5xl mx-auto px-6 pb-20">
    <PageHeader
      title="Kits & Presentes"
      subtitle="Combinações pensadas para quem quer presentear, conhecer ou se permitir."
    />

    <div class="grid md:grid-cols-2 gap-8">
      <!-- KIT DEGUSTAÇÃO -->
      <div class="p-8 border border-[var(--gold)]/20 rounded-md bg-[var(--surface)]/50 hover:border-[var(--gold)] transition-all duration-300 gold-glow-hover flex flex-col justify-between group">
        <div>
          <div class="aspect-[4/3] mb-6 overflow-hidden rounded-md bg-[var(--surface-elevated)] border border-[var(--gold)]/10 relative">
            <img
              src="/assets/kits-degustacao.jpg"
              alt="Kit Degustação"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute top-3 left-3 flex gap-2">
              <Badge variant="gold" symbol="⚗" tooltip="3 frascos alquímicos de 50ml">
                3 Mini-Poções
              </Badge>
            </div>
          </div>
          
          <div class="flex items-center gap-2 mb-2">
            <Badge variant="dark" symbol="🜚">100% Artesanal</Badge>
          </div>

          <h2 class="text-2xl md:text-3xl text-[var(--gold)] tracking-wide font-medium">
            Kit Degustação
          </h2>
          <p class="font-sans italic text-[var(--text-soft)] mt-3 leading-relaxed text-sm md:text-base">
            Três mini-poções de 50ml para descobrir o universo do Alquimista. Ideal para experimentar antes de escolher seu favorito.
          </p>
        </div>

        <div class="mt-8 pt-6 border-t border-[var(--gold)]/15 flex items-center justify-between">
          <div class="text-[var(--gold)] font-display text-2xl font-bold tracking-wider">
            apenas R$ 20
          </div>
          <Button
            href="/monte-seu-kit?kit=degustacao"
            variant="primary"
            size="md"
          >
            <span>Montar Degustação</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7l7 7-7 7"/></svg>
          </Button>
        </div>
      </div>

      <!-- KIT PRESENTEÁVEL -->
      <div class="p-8 border border-[var(--gold)]/20 rounded-md bg-[var(--surface)]/50 hover:border-[var(--gold)] transition-all duration-300 gold-glow-hover flex flex-col justify-between group">
        <div>
          <div class="aspect-[4/3] mb-6 overflow-hidden rounded-md bg-[var(--surface-elevated)] border border-[var(--gold)]/10 relative">
            <img
              src="/assets/kits-caixa-premium.jpg"
              alt="Kit Presenteável"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute top-3 left-3 flex gap-2">
              <Badge variant="gold" symbol="👑" tooltip="Embalagem especial selada com laço e brasão">
                Selo Real
              </Badge>
            </div>
          </div>

          <div class="flex items-center gap-2 mb-2">
            <Badge variant="dark" symbol="❖">MDF ou Acrílico</Badge>
          </div>

          <h2 class="text-2xl md:text-3xl text-[var(--gold)] tracking-wide font-medium">
            Kit Presenteável
          </h2>
          <p class="font-sans italic text-[var(--text-soft)] mt-3 leading-relaxed text-sm md:text-base">
            Um presente completo: Garrafa de 500ml à escolha acompanhada de doce artesanal, tacinha de vidro, chaveiro exclusivo e embalagem personalizada.
          </p>
        </div>

        <div class="mt-8 pt-6 border-t border-[var(--gold)]/15 flex items-center justify-between">
          <div class="text-[var(--gold)] font-display text-2xl font-bold tracking-wider">
            A partir de R$ 110
          </div>
          <Button
            href="/monte-seu-kit?kit=presenteavel"
            variant="primary"
            size="md"
          >
            <span>Montar Presente</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7l7 7-7 7"/></svg>
          </Button>
        </div>
      </div>
    </div>

    <!-- AVULSOS LINK -->
    <div class="text-center mt-16">
      <Button
        href="/pocoes"
        variant="ghost"
        size="md"
      >
        <span>Quero apenas garrafas avulsas</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7l7 7-7 7"/></svg>
      </Button>
    </div>
  </div>
</Layout>
