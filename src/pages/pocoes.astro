---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProductCard from '../components/ProductCard.astro';
import { fetchProducts } from '../lib/data';

const products = await fetchProducts();

const TABS = [
  { id: "all", label: "Todas as Poções", symbol: "🜚" },
  { id: "fino", label: "Licores Finos", symbol: "⚗" },
  { id: "cremoso", label: "Licores Cremosos", symbol: "✦" },
  { id: "especial", label: "Edições Especiais", symbol: "👑" },
];
---

<Layout
  title="As Poções — Alquimista Licores"
  description="Licores artesanais finos, cremosos e especiais. Cada poção do Alquimista é feita à mão, em pequenos lotes, em Criciúma/SC."
>
  <div class="max-w-7xl mx-auto px-6 lg:px-10 pb-20">
    <PageHeader title="As Poções" subtitle="Cada garrafa carrega um ritual." />

    <!-- SECTION TITLE (ACCESSIBLE HIERARCHY) -->
    <h2 class="sr-only">Nossas Poções Artesanais</h2>

    <!-- FILTER TABS (BADGE PILLS DESIGN SYSTEM) -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      {TABS.map((t) => (
        <button
          type="button"
          class={`filter-tab-btn px-4 py-2 rounded-sm text-xs font-mono tracking-wider transition-all duration-300 font-semibold cursor-pointer flex items-center gap-2 ${
            t.id === "all"
              ? "bg-[var(--gold)] text-[var(--background)] shadow-lg border border-[var(--gold)]"
              : "bg-[var(--surface)]/80 border border-[var(--gold)]/25 text-[var(--gold-soft)] hover:border-[var(--gold)] hover:bg-[var(--gold)]/10"
          }`}
          data-category={t.id}
        >
          <span class="leading-none">{t.symbol}</span>
          <span>{t.label}</span>
        </button>
      ))}
    </div>

    <!-- PRODUCTS GRID -->
    <div id="products-grid" class="grid grid-cols-2 md:grid-cols-3 gap-5 lg:gap-7">
      {products.map((p) => (
        <div class="product-item-wrap" data-category={p.categoria}>
          <ProductCard product={p} />
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  function setupFilterTabs() {
    const tabs = document.querySelectorAll(".filter-tab-btn");
    const items = document.querySelectorAll(".product-item-wrap");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const cat = tab.getAttribute("data-category");

        // Update active tab styles
        tabs.forEach((t) => {
          t.classList.remove("bg-[var(--gold)]", "text-[var(--background)]", "shadow-lg", "scale-105");
          t.classList.add("bg-[var(--surface)]/80", "border-[var(--gold)]/25", "text-[var(--gold-soft)]");
        });
        tab.classList.add("bg-[var(--gold)]", "text-[var(--background)]", "shadow-lg", "scale-105");
        tab.classList.remove("bg-[var(--surface)]/80", "border-[var(--gold)]/25", "text-[var(--gold-soft)]");

        // Filter product items
        items.forEach((item) => {
          const itemCat = item.getAttribute("data-category");
          if (cat === "all" || itemCat === cat) {
            (item as HTMLElement).style.display = "";
          } else {
            (item as HTMLElement).style.display = "none";
          }
        });
      });
    });
  }

  setupFilterTabs();
  document.addEventListener("astro:page-load", setupFilterTabs);
</script>
