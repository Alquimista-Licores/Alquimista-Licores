---
// Interactive Golden Embers Background Particles (3-Layer Alchemical Depth)
---

<canvas
  id="background-particles-canvas"
  class="pointer-events-none fixed inset-0 z-0 opacity-90"
  aria-hidden="true"
></canvas>

<script>
  let currentAnimId: number | null = null;
  let cleanupListeners: (() => void) | null = null;

  function setupBackgroundParticles() {
    // Clean up any prior animation frame or listeners on page navigation
    if (currentAnimId !== null) {
      cancelAnimationFrame(currentAnimId);
      currentAnimId = null;
    }
    if (cleanupListeners) {
      cleanupListeners();
      cleanupListeners = null;
    }

    const canvas = document.getElementById("background-particles-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    const isTouchDevice = window.matchMedia("(hover: none), (pointer: coarse)").matches;
    const isReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (isReducedMotion) return;

    let mouseX = -9999;
    let mouseY = -9999;
    let isMouseOver = false;

    const handleResize = () => {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    };

    const handleMouseMove = (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      isMouseOver = true;
    };

    const handleMouseLeave = () => {
      isMouseOver = false;
    };

    window.addEventListener("resize", handleResize, { passive: true });
    window.addEventListener("mousemove", handleMouseMove, { passive: true });
    document.addEventListener("mouseleave", handleMouseLeave, { passive: true });

    cleanupListeners = () => {
      window.removeEventListener("resize", handleResize);
      window.removeEventListener("mousemove", handleMouseMove);
      document.removeEventListener("mouseleave", handleMouseLeave);
    };

    // 3-Tier Alchemical Depth Ember Particle:
    // 1. Foreground: Larger soft bokeh orbs, floating slowly with heavy/slow fluid mouse inertia
    // 2. Midground: Crisp, balanced golden embers, medium speed and responsive mouse reaction
    // 3. Background: Discreet small luminous embers with soft atmospheric halo, slow ascent
    class DepthEmberParticle {
      x = 0;
      y = 0;
      layer: 1 | 2 | 3 = 2; // 1 = Foreground, 2 = Midground, 3 = Background
      size = 1;
      speedY = -0.3;
      vx = 0;
      targetVx = 0;
      maxDrift = 0.18;
      driftInterval = 90;
      driftTimer = 0;
      alpha = 0.5;
      baseAlpha = 0.5;
      repulsionRadius = 120;
      repulsionForce = 0.9;
      pushEase = 0.06;
      hue = 38;
      pushX = 0;
      pushY = 0;
      targetPushX = 0;
      targetPushY = 0;

      constructor() {
        this.reset(true);
      }

      reset(initial = false) {
        this.x = Math.random() * width;
        this.y = initial ? Math.random() * height : height + Math.random() * 30;

        const rand = Math.random();
        if (rand < 0.20) {
          // --- 1. PRIMEIRO PLANO (Foreground) ---
          // Partículas maiores, mais desfocadas (bokeh suave), subindo lentamente e com reação lenta/pesada ao mouse
          this.layer = 1;
          this.size = Math.random() * 6.5 + 7.5; // 7.5px - 14.0px (bokeh mais amplo e cinematográfico)
          this.speedY = -(Math.random() * 0.16 + 0.18); // -0.18 a -0.34 (movimento lento e majestoso)
          this.maxDrift = 0.08; // Deslocamento horizontal muito suave
          this.alpha = Math.random() * 0.14 + 0.16; // 0.16 a 0.30 (translúcido e elegante, sem poluir)
          this.baseAlpha = this.alpha;
          this.repulsionRadius = 160;
          this.repulsionForce = 0.95;
          this.pushEase = 0.038; // Reação lenta e com inércia fluida ao mouse
          this.driftInterval = Math.floor(Math.random() * 140 + 100);
        } else if (rand < 0.68) {
          // --- 2. PLANO MÉDIO (Midground) ---
          // Partículas nítidas, equilibradas, com brilho dourado refinado
          this.layer = 2;
          this.size = Math.random() * 1.5 + 1.6; // 1.6px - 3.1px
          this.speedY = -(Math.random() * 0.25 + 0.30); // -0.30 a -0.55
          this.maxDrift = 0.20;
          this.alpha = Math.random() * 0.25 + 0.40; // 0.40 a 0.65 (brilho nítido e discreto)
          this.baseAlpha = this.alpha;
          this.repulsionRadius = 115;
          this.repulsionForce = 0.9;
          this.pushEase = 0.08;
          this.driftInterval = Math.floor(Math.random() * 90 + 60);
        } else {
          // --- 3. PLANO DE FUNDO (Background) ---
          // Partículas menores, suaves, com leve aura atmosférica
          this.layer = 3;
          this.size = Math.random() * 0.9 + 0.9; // 0.9px - 1.8px
          this.speedY = -(Math.random() * 0.10 + 0.12); // -0.12 a -0.22
          this.maxDrift = 0.14;
          this.alpha = Math.random() * 0.20 + 0.22; // 0.22 a 0.42 (suave e sutil)
          this.baseAlpha = this.alpha;
          this.repulsionRadius = 75;
          this.repulsionForce = 0.4;
          this.pushEase = 0.035;
          this.driftInterval = Math.floor(Math.random() * 140 + 80);
        }

        this.vx = (Math.random() - 0.5) * this.maxDrift;
        this.targetVx = this.vx;
        this.hue = Math.random() > 0.30 ? 38 : 28; // 38 = Ouro nobre suave, 28 = Âmbar quente
        this.pushX = 0;
        this.pushY = 0;
        this.targetPushX = 0;
        this.targetPushY = 0;
        this.driftTimer = Math.floor(Math.random() * this.driftInterval);
      }

      update() {
        // Movimento orgânico de corrente de ar
        this.driftTimer++;
        if (this.driftTimer >= this.driftInterval) {
          this.driftTimer = 0;
          this.targetVx = (Math.random() - 0.5) * this.maxDrift * 2;
          this.driftInterval = Math.floor(Math.random() * 80 + 60);
        }

        this.vx += (this.targetVx - this.vx) * 0.02;

        // Interação suave de afastamento com o mouse
        if (!isTouchDevice && isMouseOver) {
          const dx = this.x - mouseX;
          const dy = this.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const maxDist = this.repulsionRadius;

          if (dist < maxDist && dist > 0.01) {
            const force = (1 - dist / maxDist) * this.repulsionForce;
            const angle = Math.atan2(dy, dx);
            this.targetPushX = Math.cos(angle) * force * 16;
            this.targetPushY = Math.sin(angle) * force * 16;
          } else {
            this.targetPushX = 0;
            this.targetPushY = 0;
          }
        } else {
          this.targetPushX = 0;
          this.targetPushY = 0;
        }

        // Interpolação suave e amortecida do empurrão
        this.pushX += (this.targetPushX - this.pushX) * this.pushEase;
        this.pushY += (this.targetPushY - this.pushY) * this.pushEase;

        const currentSpeedY = Math.min(this.speedY + this.pushY * 0.03, -0.05);
        this.y += currentSpeedY;
        this.x += this.vx + this.pushX * 0.04;

        // Reposicionar quando sair da tela
        if (this.y < -50) this.reset(false);
        if (this.x < -50) this.x = width + 40;
        if (this.x > width + 50) this.x = -40;
      }

      draw() {
        if (!ctx) return;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);

        if (this.layer === 1) {
          // --- PRIMEIRO PLANO: Bokeh Desfocado Suave & Gradiente Expansivo ---
          const grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size);
          const colorCore = this.hue === 38
            ? `rgba(240, 215, 175, ${this.alpha * 0.85})`
            : `rgba(240, 160, 50, ${this.alpha * 0.80})`;
          const colorMid = this.hue === 38
            ? `rgba(200, 169, 126, ${this.alpha * 0.32})`
            : `rgba(217, 119, 6, ${this.alpha * 0.28})`;
          const colorOuter = 'rgba(200, 169, 126, 0)';

          grad.addColorStop(0, colorCore);
          grad.addColorStop(0.42, colorMid);
          grad.addColorStop(1, colorOuter);

          ctx.fillStyle = grad;
        } else if (this.layer === 2) {
          // --- PLANO MÉDIO: Partícula Nítida com Núcleo Brilhante e Halo Discreto ---
          const grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size);
          const colorCore = this.hue === 38
            ? `rgba(245, 225, 185, ${this.alpha})`
            : `rgba(240, 155, 55, ${this.alpha * 0.95})`;
          const colorEdge = this.hue === 38
            ? `rgba(200, 169, 126, ${this.alpha * 0.48})`
            : `rgba(217, 119, 6, ${this.alpha * 0.42})`;
          const colorOuter = 'rgba(200, 169, 126, 0.05)';

          grad.addColorStop(0, colorCore);
          grad.addColorStop(0.68, colorEdge);
          grad.addColorStop(1, colorOuter);

          ctx.fillStyle = grad;
        } else {
          // --- PLANO DE FUNDO: Ponto Luminoso Suave com Leve Difusão ---
          const grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size);
          const colorCore = this.hue === 38
            ? `rgba(215, 185, 140, ${this.alpha * 0.90})`
            : `rgba(220, 130, 25, ${this.alpha * 0.85})`;
          const colorOuter = 'rgba(200, 169, 126, 0)';

          grad.addColorStop(0, colorCore);
          grad.addColorStop(0.65, `rgba(200, 169, 126, ${this.alpha * 0.25})`);
          grad.addColorStop(1, colorOuter);

          ctx.fillStyle = grad;
        }

        ctx.fill();
      }
    }

    // Quantidade calibrada: elegante, discreta e profunda (~76 desktop, ~38 mobile)
    const PARTICLE_COUNT = isTouchDevice ? 38 : 76;
    const particles: DepthEmberParticle[] = [];
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      particles.push(new DepthEmberParticle());
    }

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.update();
      }
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.draw();
      }

      currentAnimId = requestAnimationFrame(render);
    }

    render();
  }

  setupBackgroundParticles();
  document.addEventListener("astro:page-load", setupBackgroundParticles);
</script>

