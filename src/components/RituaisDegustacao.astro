    highlightLabel: "Abertura Aromática",
    highlightText: "O abacaxi desprende nuances de cravo-da-índia, o maracujá equilibra acidez e doçura viva, e as folhas de figueira liberam notas verdes e florais de bosque.",
    suggestedPotions: [
      { name: "Poção Tropical", sabor: "Abacaxi", id: "9e6a58a9-8d88-4613-9ce7-2dfb8afca29e", badge: "16.5°GL · Cravo & Cítrico" },
      { name: "Poção da Serenidade", sabor: "Maracujá", id: "b679b884-73a2-48cc-81af-2bc99abecee1", badge: "15°GL · Refrescante" },
      { name: "Poção da Conexão", sabor: "Figo", id: "f57e85ca-3e25-4885-a9b8-8febeac0421a", badge: "21°GL · Notas Herbáceas" }
    ]
  },
  {
    id: "a-mesa",
    numeral: "III",
    title: "À MESA & HARMONIZAÇÃO",
