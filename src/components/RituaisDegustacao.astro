---
// Rituais de Degustação — Grimório Interativo Alquímico
interface Ritual {
  id: string;
  numeral: string;
  title: string;
  shortDesc: string;
  image: string;
  alt: string;
  glyph: string;
  badgeTag: string;
  mainText: string;
  highlightLabel: string;
  highlightText?: string;
  highlightItems?: string[];
  suggestedPotions: { name: string; id: string }[];
}

const RITUALS: Ritual[] = [
  {
    id: "puro-gelado",
    numeral: "I",
    title: "PURO & GELADO",
    shortDesc: "A forma mais pura de revelar aromas, textura e sabor.",
    image: "/assets/rituals/ritual-puro-gelado.jpg",
    alt: "Ritual Puro e Gelado — Licor servido em cálice de cristal resfriado",
    glyph: "🜄",
    badgeTag: "Servir gelado · Taça pequena",
    mainText: "Deguste sem misturas, em pequenos goles. O frio realça a textura e preserva os aromas, deixando cada poção se revelar por inteiro.",
    highlightLabel: "DICA DO RITUAL",
    highlightText: "Poções frutadas ficam especialmente refrescantes quando bem geladas; as mais cremosas e especiadas podem ser servidas apenas levemente frias.",
    suggestedPotions: [
      { name: "Poção da Prosperidade", id: "af94b5a9-33d4-4a6b-abb1-0e59a49d3ec7" },
      { name: "Poção Néctar Místico", id: "6fe04098-9cd1-4cb7-a903-1e3ae1147671" },
      { name: "Poção Silvestre", id: "37758861-8dc5-4a9d-8995-b341c91ba200" }
    ]
  },
  {
    id: "com-gelo",
    numeral: "II",
    title: "COM GELO",
    shortDesc: "O gelo suaviza a intensidade e revela novas camadas da poção.",
    image: "/assets/rituals/ritual-sobre-gelo.jpg",
    alt: "Ritual Com Gelo — Licor servido sobre gelo em copo baixo",
    glyph: "🜃",
    badgeTag: "Servir com gelo · Copo baixo",
    mainText: "Adicione algumas pedras de gelo e deixe a poção evoluir lentamente no copo. A temperatura suaviza o álcool e destaca o frescor das notas frutadas.",
    highlightLabel: "DICA DO RITUAL",
    highlightText: "Use pouco gelo para refrescar sem diluir demais os aromas e sabores.",
    suggestedPotions: [
      { name: "Poção Tropical", id: "9e6a58a9-8d88-4613-9ce7-2dfb8afca29e" },
      { name: "Poção da Serenidade", id: "b679b884-73a2-48cc-81af-2bc99abecee1" },
      { name: "Poção da Conexão", id: "f57e85ca-3e25-4885-a9b8-8febeac0421a" }
    ]
  },
  {
    id: "com-sobremesas",
    numeral: "III",
    title: "COM SOBREMESAS",
    shortDesc: "Doçura, cremosidade e contraste para encerrar a experiência.",
    image: "/assets/rituals/ritual-a-mesa.jpg",
    alt: "Ritual Com Sobremesas — Licor harmonizado com chocolate, café e sobremesas",
    glyph: "🜁",
    badgeTag: "Sirva junto à sobremesa · Ou use como complemento",
    mainText: "O licor pode acompanhar a sobremesa ou entrar como calda, acrescentando uma nova camada de sabor.",
    highlightLabel: "DICA DO RITUAL",
    highlightText: "Sobremesas como brownies, sorvetes e tiramisu realçam o sabor dos licores cremosos, já frutas e doces mais leves, harmonizam com poções frutadas.",
    suggestedPotions: [
      { name: "Poção do Doce Deleite", id: "03b9242c-50a5-4c7d-bb5e-0211b266b421" },
      { name: "Poção do Desejo", id: "d5941952-c8de-4cfa-a2d5-9ca89b0cf19a" },
      { name: "Poção da Alegria", id: "b0d77291-b5ed-4548-8837-887f674c1b4c" }
    ]
  },
  {
    id: "em-coqueteis",
    numeral: "IV",
    title: "EM COQUETÉIS",
    shortDesc: "Transforme cada poção em novas combinações e experiências.",
    image: "/assets/rituals/ritual-em-alquimia.jpg",
    alt: "Ritual Em Coquetéis — Coquetelaria autoral e releituras clássicas com poções",
    glyph: "🜂",
    badgeTag: "Combine · Bata · Misture",
    mainText: "Use as poções como protagonistas de coquetéis clássicos ou autorais. Frutas, café, especiarias e destilados criam combinações que ampliam o perfil de cada licor.",
    highlightLabel: "INSPIRAÇÕES",
    highlightItems: [
      "Poção da Inspiração — Espresso Martini ou drinks de café",
      "Poção do Aconchego — Canela Sour ou vinho quente",
      "Poção do Doce Sossego — batidas e coquetéis tropicais"
    ],
    suggestedPotions: [
      { name: "Poção da Inspiração", id: "c1245fd9-cb5b-43e8-bf20-1495ff5c1aee" },
      { name: "Poção do Aconchego", id: "631512a9-16dc-4e4f-8f07-98278a207c0a" },
      { name: "Poção do Doce Sossego", id: "4a8abdb5-e5d4-4ab6-9fd8-4db419c17ed9" }
    ]
  }
];
---

<section id="rituais" class="rituals-section relative z-10 py-20 md:py-32 bg-transparent scroll-mt-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    
    <!-- 1. SECTION HEADER (REVEAL ENTRANCE) -->
    <div class="text-center mb-16 md:mb-20 rituals-header reveal-item">
      <div class="inline-flex items-center justify-center gap-3 mb-3">
        <span class="w-8 md:w-12 h-px bg-[var(--gold)]/40"></span>
        <span class="font-mono font-medium text-[11px] md:text-xs tracking-[0.3em] uppercase text-[var(--gold)]">
          Grimório de Servir
        </span>
        <span class="w-8 md:w-12 h-px bg-[var(--gold)]/40"></span>
      </div>

      <h2 class="text-3xl md:text-5xl lg:text-6xl font-medium text-[var(--cream)] tracking-wide font-display">
        RITUAIS DE DEGUSTAÇÃO
      </h2>
    </div>

    <!-- 2. ASYMMETRIC SPLIT COMPOSITION (IMAGE LEFT / LIST RIGHT) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      
      <!-- LEFT: CINEMATIC IMAGE FRAME WITH DELICATE ALCHEMICAL CORNER MARKS -->
      <div class="lg:col-span-6 xl:col-span-6 relative reveal-item" style="transition-delay: 150ms;">
        <div class="ritual-frame-container" id="ritualFrame">
          
          <!-- Delicate Antique Corner Brackets -->
          <span class="corner-bracket corner-tl" aria-hidden="true"></span>
          <span class="corner-bracket corner-tr" aria-hidden="true"></span>
          <span class="corner-bracket corner-bl" aria-hidden="true"></span>
          <span class="corner-bracket corner-br" aria-hidden="true"></span>

          <!-- Image Visual Canvas -->
          <div class="ritual-image-deck aspect-[3/4] sm:aspect-[4/3] lg:aspect-[3/4] rounded-md overflow-hidden relative">
            
            <!-- Vignette & Glow Overlay -->
            <div class="absolute inset-0 z-10 pointer-events-none ritual-inner-vignette"></div>

            <!-- Preloaded Layered Image Stack for Smooth Crossfade -->
            {RITUALS.map((ritual, index) => (
              <img
                src={ritual.image}
                alt={ritual.alt}
                data-ritual-index={index}
                class={`ritual-deck-img absolute inset-0 w-full h-full object-cover will-change-transform ${
                  index === 0 ? "is-active" : ""
                }`}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            ))}

            <!-- Discreet Alchemical Watermark & Seal -->
            <div class="absolute bottom-4 left-4 z-20 pointer-events-none flex items-center gap-2.5 px-3 py-1.5 rounded-md bg-black/40 backdrop-blur-md border border-[var(--gold)]/20">
              <span id="activeGlyph" class="text-[var(--gold-bright)] text-sm font-serif transition-all duration-500">🜄</span>
              <span id="activeBadgeText" class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--gold-light)] font-light transition-all duration-500">
                Ritual I · Puro & Gelado
              </span>
            </div>

          </div>
        </div>
      </div>

      <!-- RIGHT: VERTICAL INTERACTIVE RITUALS LIST -->
      <div class="lg:col-span-6 xl:col-span-6 space-y-4 md:space-y-5">
        
        {RITUALS.map((ritual, index) => (
          <div
            class={`ritual-card group cursor-pointer transition-all duration-500 relative p-5 md:p-6 rounded-md border border-transparent reveal-item ${
              index === 0 ? "is-active" : ""
            }`}
            data-index={index}
            role="button"
            tabindex="0"
            aria-label={`Selecionar ${ritual.title}`}
            style={`transition-delay: ${200 + index * 90}ms;`}
          >
            <!-- Background Subtle Aura on Active -->
            <div class="ritual-active-highlight" aria-hidden="true"></div>

            <!-- Top Row: Roman Numeral + Dash + Title + Glyph -->
            <div class="flex items-center justify-between gap-3 mb-1.5">
              <div class="flex items-center gap-2 md:gap-3 flex-nowrap min-w-0">
                <span class="ritual-numeral font-decorative text-lg md:text-xl font-bold shrink-0 transition-colors duration-300">
                  {ritual.numeral}
                </span>
                <span class="text-[var(--gold)]/50 font-light text-sm select-none shrink-0">—</span>
                <h3 class="ritual-title font-display text-base sm:text-lg md:text-xl font-semibold tracking-wide transition-colors duration-300">
                  {ritual.title}
                </h3>
              </div>
              <span class="ritual-glyph font-serif text-sm opacity-50 shrink-0 transition-opacity duration-300">
                {ritual.glyph}
              </span>
            </div>

            <!-- Thin Expanding Gold Underline -->
            <div class="ritual-ornament-line mb-2" aria-hidden="true"></div>

            <!-- Short Main Description (Visible in Collapsed & Active) -->
            <p class="ritual-quote font-serif italic text-sm md:text-base text-[var(--cream)]/90 leading-relaxed mt-1 transition-all duration-400">
              “{ritual.shortDesc}”
            </p>

            <!-- Expanded Details & Suggested Potions (Smooth Grid Accordion) -->
            <div class="ritual-expanded-wrapper">
              <div class="ritual-expanded-inner">
                <!-- Practical Line / Badge -->
                <div class="flex flex-wrap items-center gap-2 mt-3.5 mb-3">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-sm bg-[var(--gold)]/10 border border-[var(--gold)]/25 text-[11px] font-mono text-[var(--gold-light)] font-medium">
                    <span class="text-[var(--gold)]">✦</span> {ritual.badgeTag}
                  </span>
                </div>

                <!-- Main Paragraph -->
                <p class="text-xs md:text-sm text-[var(--cream)]/85 font-body font-light leading-relaxed mb-3">
                  {ritual.mainText}
                </p>

                <!-- Auxiliary Block (Dica / Inspirações) -->
                <div class="p-3 rounded-sm bg-black/30 border-l-2 border-[var(--gold)]/70 text-xs font-body mb-4">
                  <span class="text-[var(--gold-bright)] font-mono font-semibold uppercase tracking-wider text-[10px] block mb-1">
                    {ritual.highlightLabel}
                  </span>
                  {ritual.highlightItems ? (
                    <div class="space-y-1 text-[var(--text-soft)] font-light leading-relaxed">
                      {ritual.highlightItems.map((item) => (
                        <div class="flex items-start gap-1.5">
                          <span class="text-[var(--gold)] text-[10px] mt-0.5">•</span>
                          <span>{item}</span>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p class="text-[var(--text-soft)] font-light leading-relaxed">
                      {ritual.highlightText}
                    </p>
                  )}
                </div>

                <!-- Suggested Potions Strip with Modal Trigger Buttons -->
                <div class="ritual-potions-strip pt-3 pb-1 border-t border-[var(--gold)]/15">
                  <span class="text-[9.5px] md:text-[10px] uppercase font-mono tracking-[0.18em] text-[var(--gold)]/75 font-medium block mb-2">
                    Poções do Ritual:
                  </span>
                  <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 md:gap-2">
                    {ritual.suggestedPotions.map((potion) => (
                      <button
                        type="button"
                        class="potion-suggestion-link text-[10.5px] lg:text-[11px] px-2 lg:px-2.5 py-1 rounded-sm bg-[var(--surface-elevated)]/50 hover:bg-[var(--gold)]/20 border border-[var(--gold)]/25 hover:border-[var(--gold)] text-[var(--cream)] hover:text-[var(--gold-bright)] transition-all flex items-center justify-center gap-1 group/link font-sans shrink-0 whitespace-nowrap"
                        data-potion-id={potion.id}
                        title={`Ver detalhes de ${potion.name}`}
                      >
                        <span class="font-medium font-display">{potion.name}</span>
                        <span class="text-[var(--gold)] text-[9.5px] transform group-hover/link:translate-x-0.5 transition-transform">→</span>
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>

          </div>
        ))}

      </div>

    </div>

  </div>
</section>

<style>
  /* ==========================================================================
     RITUAIS DE DEGUSTAÇÃO — PURE TRANSPARENCY & ALCHEMICAL REFINEMENT
     ========================================================================== */
  .rituals-section {
    background: transparent !important;
  }

  /* 1. Corner Marks / Moldura Ornamental Sutil */
  .ritual-frame-container {
    position: relative;
    padding: 10px;
  }

  .corner-bracket {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--gold);
    opacity: 0.45;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 25;
  }
  .corner-tl { top: 0; left: 0; border-top: 1.5px solid var(--gold); border-left: 1.5px solid var(--gold); }
  .corner-tr { top: 0; right: 0; border-top: 1.5px solid var(--gold); border-right: 1.5px solid var(--gold); }
  .corner-bl { bottom: 0; left: 0; border-bottom: 1.5px solid var(--gold); border-left: 1.5px solid var(--gold); }
  .corner-br { bottom: 0; right: 0; border-bottom: 1.5px solid var(--gold); border-right: 1.5px solid var(--gold); }

  .ritual-frame-container:hover .corner-bracket {
    opacity: 0.85;
  }

  /* 2. Image Stack & Static Crossfade (Pure Opacity Fade In/Out) */
  .ritual-image-deck {
    border: 1px solid rgba(200, 169, 126, 0.22);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), 0 0 30px rgba(200, 169, 126, 0.08);
  }

  .ritual-inner-vignette {
    background: radial-gradient(circle at center, transparent 45%, rgba(0, 0, 0, 0.45) 90%),
                linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 35%);
  }

  .ritual-deck-img {
    opacity: 0;
    transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
    pointer-events: none;
  }

  .ritual-deck-img.is-active {
    opacity: 1;
    z-index: 2;
  }

  /* 3. Interactive Ritual Item Card */
  .ritual-card {
    background: transparent;
    border-left: 1.5px solid rgba(200, 169, 126, 0.15);
    padding-left: 1.25rem;
    cursor: pointer;
    outline: none;
    position: relative;
    user-select: none;
    transition: border-color 0.45s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .ritual-card:focus-visible {
    border-left-color: var(--gold-bright);
    outline: 1px dashed rgba(200, 169, 126, 0.5);
    outline-offset: 4px;
  }

  .ritual-active-highlight {
    position: absolute;
    inset: 0;
    left: -1px;
    background: linear-gradient(90deg, rgba(200, 169, 126, 0.06) 0%, transparent 100%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    border-radius: 0 4px 4px 0;
  }

  /* Inactive typography defaults */
  .ritual-numeral {
    color: rgba(200, 169, 126, 0.55);
  }

  .ritual-title {
    color: var(--text-soft);
    transition: color 0.35s ease;
  }

  .ritual-glyph {
    color: var(--gold);
    opacity: 0.35;
    transition: opacity 0.4s ease, color 0.4s ease;
  }

  .ritual-ornament-line {
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--gold) 0%, rgba(200, 169, 126, 0) 100%);
    box-shadow: 0 0 6px rgba(200, 169, 126, 0.4);
    transition: width 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .ritual-quote {
    color: var(--text-faded);
    transition: color 0.4s ease;
  }

  /* Ultra-smooth CSS Grid Transition for Expansion & Collapse */
  .ritual-expanded-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.55s cubic-bezier(0.25, 1, 0.5, 1),
                opacity 0.45s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .ritual-expanded-inner {
    overflow: hidden;
    min-height: 0;
  }

  /* Hover state */
  .ritual-card:hover .ritual-title {
    color: var(--gold-light);
  }
  .ritual-card:hover .ritual-numeral {
    color: var(--gold);
  }

  /* Active state */
  .ritual-card.is-active {
    border-left-color: var(--gold);
  }

  .ritual-card.is-active .ritual-active-highlight {
    opacity: 1;
  }

  .ritual-card.is-active .ritual-numeral {
    color: var(--gold-bright);
  }

  .ritual-card.is-active .ritual-title {
    color: #FFFFFF;
    text-shadow: 0 0 14px rgba(200, 169, 126, 0.45);
  }

  .ritual-card.is-active .ritual-glyph {
    opacity: 0.9;
    color: var(--gold-bright);
    text-shadow: 0 0 10px rgba(200, 169, 126, 0.5);
  }

  .ritual-card.is-active .ritual-ornament-line {
    width: 100%;
  }

  .ritual-card.is-active .ritual-quote {
    color: var(--cream);
  }

  .ritual-card.is-active .ritual-expanded-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* 4. Reveal Animation */
  .reveal-item {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal-item.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-item {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .ritual-deck-img {
      transition: opacity 0.2s ease !important;
    }
    .ritual-expanded-wrapper {
      transition: none !important;
    }
  }
</style>

<script>
  function setupRituaisSection() {
    const section = document.getElementById("rituais");
    if (!section) return;

    const cards = section.querySelectorAll<HTMLElement>(".ritual-card");
    const images = section.querySelectorAll<HTMLImageElement>(".ritual-deck-img");
    const activeGlyph = document.getElementById("activeGlyph");
    const activeBadgeText = document.getElementById("activeBadgeText");

    const badges = [
      { glyph: "🜄", text: "Ritual I · Puro & Gelado" },
      { glyph: "🜃", text: "Ritual II · Com Gelo" },
      { glyph: "🜁", text: "Ritual III · Com Sobremesas" },
      { glyph: "🜂", text: "Ritual IV · Em Coquetéis" }
    ];

    let currentIndex = 0;

    function activateRitual(index: number) {
      if (index === currentIndex) return;
      currentIndex = index;

      // Update active cards
      cards.forEach((card, idx) => {
        if (idx === index) {
          card.classList.add("is-active");
          card.setAttribute("aria-selected", "true");
        } else {
          card.classList.remove("is-active");
          card.setAttribute("aria-selected", "false");
        }
      });

      // Pure crossfade images (fade-in / fade-out without translation/scale)
      images.forEach((img, idx) => {
        if (idx === index) {
          img.classList.add("is-active");
        } else {
          img.classList.remove("is-active");
        }
      });

      // Update watermark badge
      if (activeGlyph && activeBadgeText && badges[index]) {
        activeGlyph.textContent = badges[index].glyph;
        activeBadgeText.textContent = badges[index].text;
      }
    }

    // Event listeners on cards (Hover, Click, Touch & Keyboard)
    cards.forEach((card, index) => {
      // Desktop hover
      card.addEventListener("mouseenter", () => {
        activateRitual(index);
      });

      // Click / Touch
      card.addEventListener("click", () => {
        activateRitual(index);
      });

      // Keyboard
      card.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          activateRitual(index);
        } else if (e.key === "ArrowDown" || e.key === "ArrowRight") {
          e.preventDefault();
          const nextIndex = (index + 1) % cards.length;
          cards[nextIndex]?.focus();
          activateRitual(nextIndex);
        } else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
          e.preventDefault();
          const prevIndex = (index - 1 + cards.length) % cards.length;
          cards[prevIndex]?.focus();
          activateRitual(prevIndex);
        }
      });
    });

    // Suggested potions click -> opens product modal or navigates
    const potionButtons = section.querySelectorAll<HTMLButtonElement>(".potion-suggestion-link");
    potionButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const potionId = btn.getAttribute("data-potion-id");
        if (potionId) {
          window.dispatchEvent(
            new CustomEvent("open-product-modal", {
              detail: { productId: potionId, originElement: btn }
            })
          );
        }
      });
    });

    // Scroll Entrance Observer
    const revealElements = section.querySelectorAll(".reveal-item");
    if (typeof IntersectionObserver !== "undefined") {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
      );

      revealElements.forEach((el) => observer.observe(el));
    } else {
      revealElements.forEach((el) => el.classList.add("is-revealed"));
    }
  }

  setupRituaisSection();
  document.addEventListener("astro:page-load", setupRituaisSection);
</script>
