  id: string;
  numeral: string;
  title: string;
  subtitle: string;
  desc: string;
  image: string;
  alt: string;
  glyph: string;
  element: string;
  idealTemp: string;
  technique: string;
  ambientNotes: string;
  highlightLabel: string;
  highlightText: string;
  suggestedPotions: { name: string; sabor: string; id: string; badge: string }[];
}

const RITUALS: Ritual[] = [
  {
