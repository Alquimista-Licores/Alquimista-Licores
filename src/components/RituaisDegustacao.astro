      { name: "Poção da Prosperidade", sabor: "Ouro Especial", id: "af94b5a9-33d4-4a6b-abb1-0e59a49d3ec7", badge: "12.5°GL · Cacau & Especiarias" },
      { name: "Poção Néctar Místico", sabor: "Butiá", id: "6fe04098-9cd1-4cb7-a903-1e3ae1147671", badge: "16°GL · Acidez Tropical" },
      { name: "Poção Silvestre", sabor: "Jabuticaba", id: "37758861-8dc5-4a9d-8995-b341c91ba200", badge: "15°GL · Frutado Aveludado" }
    ]
  },
  {
