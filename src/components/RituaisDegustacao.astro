      { name: "Poção do Desejo", sabor: "Chocolate Cremoso", id: "d5941952-c8de-4cfa-a2d5-9ca89b0cf19a", badge: "11.5°GL · Cacau 50%" },
      { name: "Poção da Alegria", sabor: "Banana", id: "b0d77291-b5ed-4548-8837-887f674c1b4c", badge: "22.5°GL · Canela & Mascavo" }
