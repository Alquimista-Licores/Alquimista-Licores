---
import CauldronIcon from './CauldronIcon.astro';

const currentPath = Astro.url.pathname;

const NAV = [
  { href: "/", label: "Início" },
  { href: "/pocoes", label: "As Poções" },
  { href: "/kits", label: "Kits & Presentes" },
  { href: "/monte-seu-kit", label: "Monte seu Kit" },
  { href: "/sobre", label: "Sobre" },
  { href: "/sobre#jornada", label: "Jornada" },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-40 transition-all duration-500 bg-transparent border-b border-transparent select-none"
>
  <!-- Interactive Hover Spotlight Layers (Cursor follower) -->
  <div class="header-spotlight-bg pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300" aria-hidden="true"></div>
  <div class="header-spotlight-border pointer-events-none absolute bottom-0 inset-x-0 h-px opacity-0 transition-opacity duration-300" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 h-14 lg:h-16 flex items-center justify-between gap-6">
    <!-- LOGO -->
    <a href="/" class="flex items-center group">
      <img
        src="/assets/logo-alquimista.png"
        alt="Alquimista Licores"
        class="h-6 md:h-7 lg:h-8 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
      />
    </a>

    <!-- DESKTOP NAV -->
    <nav class="hidden lg:flex items-center gap-7">
      {NAV.map((n) => {
        const isActive = currentPath === n.href || (n.href !== '/' && currentPath.startsWith(n.href));
        return (
          <a
            href={n.href}
            class={`header-nav-link relative py-0.5 transition-colors duration-300 ${
              isActive ? "active text-[var(--gold-light)]" : "text-[var(--text-soft)] hover:text-[var(--gold-light)]"
            }`}
          >
            {n.label}
          </a>
        );
      })}
    </nav>

    <!-- ACTIONS -->
    <div class="flex items-center gap-3">
      <!-- CALDEIRÃO CART BUTTON -->
      <button
        id="cart-toggle-btn"
        title="Meu Caldeirão"
        class="relative p-2 text-[var(--cream)] hover:text-[var(--gold)] transition-colors flex items-center justify-center"
        aria-label="Meu Caldeirão"
      >
        <CauldronIcon className="w-5 h-5" />
        <span
          id="cart-badge"
          class="hidden absolute -top-1 -right-1 w-5 h-5 rounded-full bg-[var(--gold)] text-[var(--background)] text-[10px] font-bold items-center justify-center shadow-md animate-pulse"
        >
          0
        </span>
      </button>

      <!-- MOBILE HAMBURGER -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-[var(--cream)] hover:text-[var(--gold)] transition-colors"
        aria-label="Abrir Menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- MOBILE MENU DRAWER -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[var(--background)]/95 backdrop-blur-lg border-t border-[var(--gold)]/15 shadow-2xl">
    <nav class="flex flex-col px-6 py-4 space-y-1">
      {NAV.map((n) => {
        const isActive = currentPath === n.href || (n.href !== '/' && currentPath.startsWith(n.href));
        return (
          <a
            href={n.href}
            class={`header-nav-link py-3 border-b border-[var(--gold)]/10 last:border-0 transition-colors ${
              isActive ? "text-[var(--gold)]" : "text-[var(--text-soft)] hover:text-[var(--gold)]"
            }`}
          >
            {n.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<style>
  #site-header {
    --mouse-x: 50%;
    --mouse-y: 50%;
  }

  /* Scrolled State: Dark Semi-transparent Glass + Blur */
  #site-header.is-scrolled {
    background-color: rgba(10, 10, 10, 0.78);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: rgba(200, 169, 126, 0.18);
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.75);
  }

  /* Interactive Hover: Spotlight background centered at cursor */
  #site-header:hover .header-spotlight-bg {
    opacity: 1;
    background: radial-gradient(
      450px circle at var(--mouse-x) var(--mouse-y),
      rgba(200, 169, 126, 0.14),
      transparent 80%
    );
  }

  /* Interactive Hover: Bottom border lights up near cursor */
  #site-header:hover .header-spotlight-border {
    opacity: 1;
    background: radial-gradient(
      320px circle at var(--mouse-x) 50%,
      rgba(212, 178, 58, 0.95) 0%,
      rgba(200, 169, 126, 0.5) 45%,
      transparent 80%
    );
  }

  .header-nav-link {
    font-family: 'Lato', var(--font-body), sans-serif;
    letter-spacing: 0.22em;
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .header-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--gold);
    box-shadow: 0 0 5px rgba(200, 169, 126, 0.6);
    transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header-nav-link:hover::after,
  .header-nav-link.active::after {
    width: 100%;
  }
</style>

<script>
  function setupHeader() {
    const header = document.getElementById("site-header");
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");
    const cartBtn = document.getElementById("cart-toggle-btn");

    if (!header) return;

    // 1. Scroll State Management
    function handleScroll() {
      if (window.scrollY > 15) {
        header?.classList.add("is-scrolled");
      } else {
        header?.classList.remove("is-scrolled");
      }
    }

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    // 2. Cursor Spotlight Tracking for Background and Border Glow
    header.addEventListener("mousemove", (e) => {
      const rect = header.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      header.style.setProperty("--mouse-x", `${x}px`);
      header.style.setProperty("--mouse-y", `${y}px`);
    });

    // 3. Mobile Menu Toggle
    mobileBtn?.addEventListener("click", () => {
      const isHidden = mobileMenu?.classList.contains("hidden");
      if (isHidden) {
        mobileMenu?.classList.remove("hidden");
        hamburgerIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
      } else {
        mobileMenu?.classList.add("hidden");
        hamburgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      }
    });

    // 4. Cart Open Dispatch
    cartBtn?.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("open-cart"));
    });

    // 5. Update cart badge from local storage
    function updateBadge() {
      try {
        const raw = localStorage.getItem("alquimista-cart");
        const items = raw ? JSON.parse(raw) : [];
        const count = items.reduce((acc: number, item: any) => acc + (item.qty || 1), 0);
        const badge = document.getElementById("cart-badge");
        if (badge) {
          badge.textContent = String(count);
          if (count > 0) {
            badge.classList.remove("hidden");
            badge.classList.add("flex");
          } else {
            badge.classList.add("hidden");
            badge.classList.remove("flex");
          }
        }
      } catch (e) {}
    }

    window.addEventListener("cart-updated", updateBadge);
    updateBadge();
  }

  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
</script>
