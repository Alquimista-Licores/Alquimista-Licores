---
import { SITE, waUrl } from '../lib/data';
---

<footer class="border-t border-[var(--gold)]/15 bg-[var(--surface)]/40 mt-20 relative z-10">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-12 flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
    <!-- BRAND / ORIGIN -->
    <div class="flex flex-col items-center md:items-start shrink-0">
      <a href="/" class="logo-shimmer-wrapper inline-flex items-center mb-2 group relative">
        <img
          src="/assets/logo-alquimista.png"
          alt="Alquimista Licores"
          class="h-8 md:h-9 w-auto object-contain"
        />
        <span class="logo-shimmer-sheen" aria-hidden="true"></span>
      </a>
      <p class="font-sans italic text-[var(--text-soft)] text-xs">Feito com (c)alma.</p>
      <p class="text-[11px] text-[var(--text-faded)] mt-1">Produção artesanal em Criciúma, Santa Catarina.</p>
    </div>

    <!-- QUICK NAV -->
    <nav class="flex flex-wrap md:flex-nowrap justify-center items-center gap-x-5 lg:gap-x-7 gap-y-3 text-xs font-sans tracking-widest uppercase text-[var(--cream)]/80 whitespace-nowrap">
      <a href="/" class="hover:text-[var(--gold)] transition-colors">Início</a>
      <a href="/pocoes" class="hover:text-[var(--gold)] transition-colors">As Poções</a>
      <a href="/monte-seu-kit" class="hover:text-[var(--gold)] transition-colors">Monte seu Kit</a>
      <a href="/sobre" class="hover:text-[var(--gold)] transition-colors">Sobre</a>
      <a href="/contato" class="hover:text-[var(--gold)] transition-colors">Contato</a>
      <a href="/sobre#jornada" class="hover:text-[var(--gold)] transition-colors">Jornada</a>
    </nav>

    <!-- SOCIAL & CONTACT -->
    <div class="flex justify-center md:justify-end gap-4 shrink-0">
      <a
        href={SITE.instagram}
        target="_blank"
        rel="noreferrer"
        class="p-2.5 border border-[var(--gold)]/30 rounded-full text-[var(--gold)] hover:bg-[var(--gold)] hover:text-[var(--background)] transition-all"
        aria-label="Instagram do Alquimista"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
        </svg>
      </a>

      <a
        href={waUrl(SITE.whatsappMsg)}
        target="_blank"
        rel="noreferrer"
        class="p-2.5 border border-[var(--gold)]/30 rounded-full text-[var(--gold)] hover:bg-[var(--gold)] hover:text-[var(--background)] transition-all"
        aria-label="WhatsApp do Alquimista"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="border-t border-[var(--gold)]/10 px-6 py-4 text-center text-xs text-[var(--text-faded)] tracking-wider">
    ⚠️ Venda e consumo proibidos para menores de 18 anos. Beba com moderação.
  </div>
</footer>
