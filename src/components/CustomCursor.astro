---
// Custom Cursor in #B28C46
// - Central dot: Always visible at mouse coordinate (0 lag) across all states
// - OS native cursor: Strictly hidden (no native pointer hand)
// - Transparent enclosing: No background color alteration (transparent fill), only 1px #B28C46 contour + soft glow
// - Header, Footer & Ritual card background: Does NOT enclose (smooth 50% opacity fade-in/out)
// - Ritual Potion Buttons, Product Cards & CTAs: Encloses exactly flush to borders (0 padding)
// - WhatsApp FAB & Header Cauldron button: Encloses with perfect circular shape (9999px border-radius)
// - Desktop only: Disabled on touch devices

interface Props {
  color?: string;
  circleSize?: number;
  dotSize?: number;
  borderWidth?: number;
  delayFactor?: number;
}

const {
  color = "#B28C46",
  circleSize = 40,
  dotSize = 6,
  borderWidth = 1,
  delayFactor = 0.14,
} = Astro.props;
---

<div
  id="reactbits-cursor-root"
  class="pointer-events-none fixed inset-0 z-[99999] hidden select-none md:block opacity-0 transition-opacity duration-300"
  data-color={color}
  data-circle-size={circleSize}
  data-dot-size={dotSize}
  data-border-width={borderWidth}
  data-delay-factor={delayFactor}
  style={`--cursor-color: ${color};`}
  aria-hidden="true"
>
  <!-- Central Dot (Always visible, 0 lag tracking) -->
  <div
    id="reactbits-cursor-dot"
    class="fixed top-0 left-0 rounded-full pointer-events-none will-change-transform z-10"
    style={`width: ${dotSize}px; height: ${dotSize}px; background-color: var(--cursor-color); box-shadow: 0 0 8px rgba(178, 140, 70, 0.9); transform: translate3d(-50%, -50%, 0);`}
  ></div>

  <!-- Outer Morphing Circle (Transparent background, glowing 1px contour) -->
  <div
    id="reactbits-cursor-circle"
    class="fixed top-0 left-0 pointer-events-none will-change-transform transition-[width,height,border-radius,background-color,border-color,box-shadow,opacity] duration-200 ease-out"
    style={`width: ${circleSize}px; height: ${circleSize}px; border-radius: 9999px; border: ${borderWidth}px solid var(--cursor-color); box-shadow: 0 0 12px rgba(178, 140, 70, 0.22); transform: translate3d(-50%, -50%, 0); mix-blend-mode: normal; opacity: 1; background-color: transparent;`}
  ></div>
</div>

<style>
  /* Strictly hide native cursor everywhere on fine pointer devices */
  @media (hover: hover) and (pointer: fine) {
    *,
    *::before,
    *::after,
    html,
    body,
    a,
    button,
    [role="button"],
    [role="link"],
    summary,
    label,
    select,
    input,
    textarea,
    .cursor-pointer,
    .cursor-default {
      cursor: none !important;
    }
  }

  /* Soft fade state: Header / Footer links & logos, and Ritual card background */
  #reactbits-cursor-circle.cursor-soft {
    opacity: 0.5 !important;
    background-color: transparent !important;
    box-shadow: 0 0 8px rgba(178, 140, 70, 0.2);
  }

  /* Morph enclosing state: Pure transparent background, 1px contour with soft glow */
  #reactbits-cursor-circle.cursor-enclosing {
    background-color: transparent !important;
    border-color: var(--cursor-color);
    box-shadow: 0 0 18px rgba(178, 140, 70, 0.45);
    opacity: 1 !important;
  }

  /* Active / Click press state */
  #reactbits-cursor-circle.cursor-active {
    box-shadow: 0 0 14px rgba(178, 140, 70, 0.6);
  }
</style>

<script>
  function initCustomCursor() {
    // Only run on desktop devices with mouse (fine pointer)
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      return;
    }

    const root = document.getElementById("reactbits-cursor-root");
    const dot = document.getElementById("reactbits-cursor-dot");
    const circle = document.getElementById("reactbits-cursor-circle");

    if (!root || !dot || !circle) return;

    const baseCircleSize = parseFloat(root.getAttribute("data-circle-size") || "40");
    const delay = parseFloat(root.getAttribute("data-delay-factor") || "0.14");

    let mouseX = -100;
    let mouseY = -100;
    let circleX = -100;
    let circleY = -100;
    let isVisible = false;
    let hoveredEncloseEl: HTMLElement | null = null;
    let isSoftHover = false;
    let isActive = false;
    let animId: number | null = null;

    // Selectors for round circular targets (WhatsApp button and Cauldron icon)
    const roundCircularSelector = `
      #cart-toggle-btn, button[aria-label*="Caldeirão"], button[title*="Caldeirão"],
      a[aria-label*="WhatsApp"], a[href*="wa.me"], a[href*="whatsapp.com"], .whatsapp-fab
    `;

    // Selectors for Header & Footer links, logos, and ritual card accordion area (Soft 50% opacity, no enclose)
    const softLinksSelector = `
      header a:not(${roundCircularSelector}),
      header nav a,
      .header-nav-link,
      footer a,
      footer button:not(.btn-primary),
      .ritual-card
    `;

    // Selectors for Enclosing targets (Buttons, Potion suggestion badges in rituals, Product cards, CTAs, Inputs)
    const enclosingSelector = `
      .potion-suggestion-link,
      button:not(#cart-toggle-btn):not(.ritual-card),
      a.btn-primary, a.btn-ghost, a.btn-shimmer, a.btn-outline,
      .product-card, .filter-tab-btn,
      input:not([type="hidden"]), select, textarea,
      [data-cursor-enclose], ${roundCircularSelector}
    `;

    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!isVisible) {
        isVisible = true;
        circleX = mouseX;
        circleY = mouseY;
        root.style.opacity = "1";
      }

      // Central dot stays strictly locked to mouse position with 0 lag and 100% visibility
      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate3d(-50%, -50%, 0) ${
        isActive ? "scale(1.3)" : "scale(1)"
      }`;

      const target = e.target as HTMLElement | null;
      if (!target) return;

      // 1. Check if hovering inside potion buttons inside ritual or specific buttons/cards
      const potionOrBtn = target.closest(".potion-suggestion-link, button, a.btn-primary, a.btn-ghost, a.btn-shimmer, a.btn-outline, .product-card, .filter-tab-btn") as HTMLElement | null;
      if (potionOrBtn) {
        isSoftHover = false;
        circle.classList.remove("cursor-soft");
        if (hoveredEncloseEl !== potionOrBtn) {
          hoveredEncloseEl = potionOrBtn;
          circle.classList.add("cursor-enclosing");
        }
        return;
      }

      // 2. Check if hovering Round Circular button (WhatsApp / Cauldron)
      const roundTarget = target.closest(roundCircularSelector) as HTMLElement | null;
      if (roundTarget) {
        isSoftHover = false;
        circle.classList.remove("cursor-soft");
        if (hoveredEncloseEl !== roundTarget) {
          hoveredEncloseEl = roundTarget;
          circle.classList.add("cursor-enclosing");
        }
        return;
      }

      // 3. Check if hovering Header / Footer links or Ritual Card area (Soft 50% opacity mode, no enclose)
      const softTarget = target.closest(softLinksSelector) as HTMLElement | null;
      if (softTarget) {
        if (hoveredEncloseEl) {
          hoveredEncloseEl = null;
          circle.classList.remove("cursor-enclosing");
          circle.style.width = `${baseCircleSize}px`;
          circle.style.height = `${baseCircleSize}px`;
          circle.style.borderRadius = "9999px";
        }
        if (!isSoftHover) {
          isSoftHover = true;
          circle.classList.add("cursor-soft");
        }
        return;
      } else if (isSoftHover) {
        isSoftHover = false;
        circle.classList.remove("cursor-soft");
      }

      // 4. General enclosing target check
      const encloseTarget = target.closest(enclosingSelector) as HTMLElement | null;
      if (encloseTarget) {
        if (hoveredEncloseEl !== encloseTarget) {
          hoveredEncloseEl = encloseTarget;
          circle.classList.add("cursor-enclosing");
        }
      } else if (hoveredEncloseEl) {
        hoveredEncloseEl = null;
        circle.classList.remove("cursor-enclosing");
        circle.style.width = `${baseCircleSize}px`;
        circle.style.height = `${baseCircleSize}px`;
        circle.style.borderRadius = "9999px";
      }
    }

    function onMouseDown() {
      isActive = true;
      circle.classList.add("cursor-active");
    }

    function onMouseUp() {
      isActive = false;
      circle.classList.remove("cursor-active");
    }

    function onMouseLeave() {
      isVisible = false;
      root.style.opacity = "0";
      hoveredEncloseEl = null;
      isSoftHover = false;
      circle.classList.remove("cursor-enclosing", "cursor-soft", "cursor-active");
      circle.style.width = `${baseCircleSize}px`;
      circle.style.height = `${baseCircleSize}px`;
      circle.style.borderRadius = "9999px";
    }

    function onMouseEnter() {
      isVisible = true;
      root.style.opacity = "1";
    }

    // Smooth Trailing & Morphing loop
    function loop() {
      if (isVisible) {
        if (hoveredEncloseEl && document.body.contains(hoveredEncloseEl)) {
          const rect = hoveredEncloseEl.getBoundingClientRect();
          const isRound = hoveredEncloseEl.matches(roundCircularSelector);

          const targetCenterX = rect.left + rect.width / 2;
          const targetCenterY = rect.top + rect.height / 2;

          // Smooth magnetic pull to target center
          circleX += (targetCenterX - circleX) * 0.24;
          circleY += (targetCenterY - circleY) * 0.24;

          if (isRound) {
            // Perfect circular shape for WhatsApp & Cauldron icon
            const roundDimension = Math.max(rect.width, rect.height, 40);
            circle.style.width = `${roundDimension}px`;
            circle.style.height = `${roundDimension}px`;
            circle.style.borderRadius = "9999px";
            circle.style.transform = `translate3d(${circleX}px, ${circleY}px, 0) translate3d(-50%, -50%, 0) ${
              isActive ? "scale(0.97)" : "scale(1)"
            }`;
          } else {
            // Exact border-flush fit for buttons & cards, matching 3D parallax tilt
            const computed = window.getComputedStyle(hoveredEncloseEl);
            const radius = computed.borderRadius || "6px";
            const w = hoveredEncloseEl.offsetWidth || rect.width;
            const h = hoveredEncloseEl.offsetHeight || rect.height;
            const elTransform = hoveredEncloseEl.style.transform || "";

            circle.style.width = `${w}px`;
            circle.style.height = `${h}px`;
            circle.style.borderRadius = radius;
            circle.style.transform = `translate3d(${circleX}px, ${circleY}px, 0) translate3d(-50%, -50%, 0) ${elTransform} ${
              isActive ? "scale(0.97)" : "scale(1)"
            }`;
          }
        } else {
          // Free-floating circle trailing the mouse
          circleX += (mouseX - circleX) * delay;
          circleY += (mouseY - circleY) * delay;

          circle.style.width = `${baseCircleSize}px`;
          circle.style.height = `${baseCircleSize}px`;
          circle.style.borderRadius = "9999px";
          circle.style.transform = `translate3d(${circleX}px, ${circleY}px, 0) translate3d(-50%, -50%, 0) ${
            isActive ? "scale(0.85)" : "scale(1)"
          }`;
        }
      }

      animId = requestAnimationFrame(loop);
    }

    window.addEventListener("mousemove", onMouseMove, { passive: true });
    window.addEventListener("mousedown", onMouseDown, { passive: true });
    window.addEventListener("mouseup", onMouseUp, { passive: true });
    document.addEventListener("mouseleave", onMouseLeave);
    document.addEventListener("mouseenter", onMouseEnter);

    animId = requestAnimationFrame(loop);

    document.addEventListener("astro:before-swap", () => {
      if (animId) cancelAnimationFrame(animId);
      window.removeEventListener("mousemove", onMouseMove);
      window.removeEventListener("mousedown", onMouseDown);
      window.removeEventListener("mouseup", onMouseUp);
      document.removeEventListener("mouseleave", onMouseLeave);
      document.removeEventListener("mouseenter", onMouseEnter);
    }, { once: true });
  }

  initCustomCursor();
  document.addEventListener("astro:page-load", initCustomCursor);
</script>
