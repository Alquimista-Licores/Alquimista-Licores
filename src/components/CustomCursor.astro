---
// Custom Cursor in #B28C46
// - Central dot: Exactly follows mouse with 0 lag
// - Outer circle: Gentle delay (smooth follower), 1px border (half thickness), perfectly circular without distortion
// - Interactive hover: Subtle scale-up over clickable elements
// - Desktop only: Disabled on touch devices

interface Props {
  color?: string;
  circleSize?: number;
  dotSize?: number;
  borderWidth?: number;
  delayFactor?: number;
}

const {
  color = "#B28C46",
  circleSize = 40,
  dotSize = 6,
  borderWidth = 1,
  delayFactor = 0.12,
} = Astro.props;
---

<div
  id="reactbits-cursor-root"
  class="pointer-events-none fixed inset-0 z-[99999] hidden select-none md:block opacity-0 transition-opacity duration-300"
  data-color={color}
  data-circle-size={circleSize}
  data-dot-size={dotSize}
  data-border-width={borderWidth}
  data-delay-factor={delayFactor}
  style={`--cursor-color: ${color};`}
  aria-hidden="true"
>
  <!-- Dot (Tracks mouse instantaneously with 0 lag) -->
  <div
    id="reactbits-cursor-dot"
    class="fixed top-0 left-0 rounded-full pointer-events-none will-change-transform"
    style={`width: ${dotSize}px; height: ${dotSize}px; background-color: var(--cursor-color); box-shadow: 0 0 8px rgba(178, 140, 70, 0.7); transform: translate3d(-50%, -50%, 0);`}
  ></div>

  <!-- Outer Circle (Half thickness: 1px border, smooth trailing delay, no distortion) -->
  <div
    id="reactbits-cursor-circle"
    class="fixed top-0 left-0 rounded-full pointer-events-none will-change-transform transition-[background-color,box-shadow] duration-200 ease-out"
    style={`width: ${circleSize}px; height: ${circleSize}px; border: ${borderWidth}px solid var(--cursor-color); box-shadow: 0 0 12px rgba(178, 140, 70, 0.2); transform: translate3d(-50%, -50%, 0); mix-blend-mode: normal;`}
  ></div>
</div>

<style>
  /* Hide OS native cursor on fine pointer devices */
  @media (hover: hover) and (pointer: fine) {
    html,
    body,
    a,
    button,
    [role="button"],
    [role="link"],
    summary,
    label[for],
    select,
    input,
    textarea,
    .cursor-pointer,
    .cursor-default {
      cursor: none !important;
    }
  }

  /* Circle Hover and Active States */
  #reactbits-cursor-circle.cursor-hover {
    background-color: rgba(178, 140, 70, 0.12);
    box-shadow: 0 0 18px rgba(178, 140, 70, 0.45), inset 0 0 8px rgba(178, 140, 70, 0.1);
  }

  #reactbits-cursor-circle.cursor-active {
    background-color: rgba(178, 140, 70, 0.25);
  }

  #reactbits-cursor-dot.cursor-hover {
    opacity: 0.6;
  }
</style>

<script>
  function initCustomCursor() {
    // Only on fine pointer devices (desktop with mouse)
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      return;
    }

    const root = document.getElementById("reactbits-cursor-root");
    const dot = document.getElementById("reactbits-cursor-dot");
    const circle = document.getElementById("reactbits-cursor-circle");

    if (!root || !dot || !circle) return;

    const delay = parseFloat(root.getAttribute("data-delay-factor") || "0.12");

    let mouseX = -100;
    let mouseY = -100;
    let circleX = -100;
    let circleY = -100;
    let isVisible = false;
    let isHovering = false;
    let isActive = false;
    let animId: number | null = null;

    const interactiveSelector = `
      a, button, [role="button"], [role="link"], summary, label[for],
      select, input:not([type="hidden"]), textarea, .cursor-pointer,
      .product-card, .ritual-card, .filter-tab-btn, [tabindex="0"]
    `;

    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!isVisible) {
        isVisible = true;
        circleX = mouseX;
        circleY = mouseY;
        root.style.opacity = "1";
      }

      // Dot tracks the mouse coordinate INSTANTANEOUSLY (0 lag)
      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate3d(-50%, -50%, 0) ${
        isActive ? "scale(1.3)" : isHovering ? "scale(0.6)" : "scale(1)"
      }`;

      // Check interactive hover
      const target = e.target as HTMLElement | null;
      if (target && target.closest(interactiveSelector)) {
        if (!isHovering) {
          isHovering = true;
          circle.classList.add("cursor-hover");
          dot.classList.add("cursor-hover");
        }
      } else if (isHovering) {
        isHovering = false;
        circle.classList.remove("cursor-hover");
        dot.classList.remove("cursor-hover");
      }
    }

    function onMouseDown() {
      isActive = true;
      circle.classList.add("cursor-active");
    }

    function onMouseUp() {
      isActive = false;
      circle.classList.remove("cursor-active");
    }

    function onMouseLeave() {
      isVisible = false;
      root.style.opacity = "0";
    }

    function onMouseEnter() {
      isVisible = true;
      root.style.opacity = "1";
    }

    // Smooth trailing loop for the outer circle
    function loop() {
      if (isVisible) {
        // Smooth gentle delay (lerp)
        circleX += (mouseX - circleX) * delay;
        circleY += (mouseY - circleY) * delay;

        // Perfectly circular: No distortion, pure uniform scale
        const scale = isActive ? "scale(0.85)" : isHovering ? "scale(1.35)" : "scale(1)";
        circle.style.transform = `translate3d(${circleX}px, ${circleY}px, 0) translate3d(-50%, -50%, 0) ${scale}`;
      }

      animId = requestAnimationFrame(loop);
    }

    window.addEventListener("mousemove", onMouseMove, { passive: true });
    window.addEventListener("mousedown", onMouseDown, { passive: true });
    window.addEventListener("mouseup", onMouseUp, { passive: true });
    document.addEventListener("mouseleave", onMouseLeave);
    document.addEventListener("mouseenter", onMouseEnter);

    animId = requestAnimationFrame(loop);

    document.addEventListener("astro:before-swap", () => {
      if (animId) cancelAnimationFrame(animId);
      window.removeEventListener("mousemove", onMouseMove);
      window.removeEventListener("mousedown", onMouseDown);
      window.removeEventListener("mouseup", onMouseUp);
      document.removeEventListener("mouseleave", onMouseLeave);
      document.removeEventListener("mouseenter", onMouseEnter);
    }, { once: true });
  }

  initCustomCursor();
  document.addEventListener("astro:page-load", initCustomCursor);
</script>
