---
// Custom Cursor in #B28C46 with Magnetic Target Enclosing Morph
// - Central dot: Exactly follows mouse with 0 lag
// - Outer circle: Follows with smooth delay, 1px border (#B28C46)
// - Hover effect: Outer circle smoothly snaps & morphs to enclose the hovered clickable element (button, card, link), giving it a glowing golden contour (#B28C46)
// - Desktop only: Disabled on touch devices

interface Props {
  color?: string;
  circleSize?: number;
  dotSize?: number;
  borderWidth?: number;
  delayFactor?: number;
}

const {
  color = "#B28C46",
  circleSize = 40,
  dotSize = 6,
  borderWidth = 1,
  delayFactor = 0.14,
} = Astro.props;
---

<div
  id="reactbits-cursor-root"
  class="pointer-events-none fixed inset-0 z-[99999] hidden select-none md:block opacity-0 transition-opacity duration-300"
  data-color={color}
  data-circle-size={circleSize}
  data-dot-size={dotSize}
  data-border-width={borderWidth}
  data-delay-factor={delayFactor}
  style={`--cursor-color: ${color};`}
  aria-hidden="true"
>
  <!-- Dot (Tracks mouse instantaneously with 0 lag) -->
  <div
    id="reactbits-cursor-dot"
    class="fixed top-0 left-0 rounded-full pointer-events-none will-change-transform"
    style={`width: ${dotSize}px; height: ${dotSize}px; background-color: var(--cursor-color); box-shadow: 0 0 8px rgba(178, 140, 70, 0.8); transform: translate3d(-50%, -50%, 0);`}
  ></div>

  <!-- Outer Morphing Frame / Circle (Encloses hovered clickable target with 1px border and soft glow) -->
  <div
    id="reactbits-cursor-circle"
    class="fixed top-0 left-0 pointer-events-none will-change-transform transition-[width,height,border-radius,background-color,border-color,box-shadow] duration-250 ease-out"
    style={`width: ${circleSize}px; height: ${circleSize}px; border-radius: 9999px; border: ${borderWidth}px solid var(--cursor-color); box-shadow: 0 0 12px rgba(178, 140, 70, 0.2); transform: translate3d(-50%, -50%, 0); mix-blend-mode: normal;`}
  ></div>
</div>

<style>
  /* Hide OS native cursor on fine pointer devices */
  @media (hover: hover) and (pointer: fine) {
    html,
    body,
    a,
    button,
    [role="button"],
    [role="link"],
    summary,
    label[for],
    select,
    input,
    textarea,
    .cursor-pointer,
    .cursor-default {
      cursor: none !important;
    }
  }

  /* Morph state: Enclosing clickable target */
  #reactbits-cursor-circle.cursor-enclosing {
    background-color: rgba(178, 140, 70, 0.12);
    border-color: var(--cursor-color);
    box-shadow: 0 0 20px rgba(178, 140, 70, 0.45), inset 0 0 10px rgba(178, 140, 70, 0.15);
  }

  /* Active / Click press state */
  #reactbits-cursor-circle.cursor-active {
    background-color: rgba(178, 140, 70, 0.25);
    box-shadow: 0 0 15px rgba(178, 140, 70, 0.6);
  }

  #reactbits-cursor-dot.cursor-enclosing {
    opacity: 0.7;
    transform: translate3d(-50%, -50%, 0) scale(0.85) !important;
  }
</style>

<script>
  function initCustomCursor() {
    // Only on fine pointer devices (desktop with mouse)
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      return;
    }

    const root = document.getElementById("reactbits-cursor-root");
    const dot = document.getElementById("reactbits-cursor-dot");
    const circle = document.getElementById("reactbits-cursor-circle");

    if (!root || !dot || !circle) return;

    const baseCircleSize = parseFloat(root.getAttribute("data-circle-size") || "40");
    const delay = parseFloat(root.getAttribute("data-delay-factor") || "0.14");

    let mouseX = -100;
    let mouseY = -100;
    let circleX = -100;
    let circleY = -100;
    let isVisible = false;
    let hoveredElement: HTMLElement | null = null;
    let isActive = false;
    let animId: number | null = null;

    const interactiveSelector = `
      a, button, [role="button"], [role="link"], summary, label[for],
      select, input:not([type="hidden"]), textarea, .cursor-pointer,
      .product-card, .ritual-card, .filter-tab-btn, [tabindex="0"]
    `;

    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!isVisible) {
        isVisible = true;
        circleX = mouseX;
        circleY = mouseY;
        root.style.opacity = "1";
      }

      // Dot tracks mouse coordinate INSTANTANEOUSLY (0 lag)
      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate3d(-50%, -50%, 0) ${
        isActive ? "scale(1.3)" : hoveredElement ? "scale(0.85)" : "scale(1)"
      }`;

      // Check if hovering a clickable element
      const target = e.target as HTMLElement | null;
      const matched = target ? (target.closest(interactiveSelector) as HTMLElement | null) : null;

      if (matched && matched !== hoveredElement) {
        hoveredElement = matched;
        circle.classList.add("cursor-enclosing");
        dot.classList.add("cursor-enclosing");
      } else if (!matched && hoveredElement) {
        hoveredElement = null;
        circle.classList.remove("cursor-enclosing");
        dot.classList.remove("cursor-enclosing");

        // Reset circle dimensions back to round default
        circle.style.width = `${baseCircleSize}px`;
        circle.style.height = `${baseCircleSize}px`;
        circle.style.borderRadius = "9999px";
      }
    }

    function onMouseDown() {
      isActive = true;
      circle.classList.add("cursor-active");
    }

    function onMouseUp() {
      isActive = false;
      circle.classList.remove("cursor-active");
    }

    function onMouseLeave() {
      isVisible = false;
      root.style.opacity = "0";
      hoveredElement = null;
      circle.classList.remove("cursor-enclosing");
      dot.classList.remove("cursor-enclosing");
      circle.style.width = `${baseCircleSize}px`;
      circle.style.height = `${baseCircleSize}px`;
      circle.style.borderRadius = "9999px";
    }

    function onMouseEnter() {
      isVisible = true;
      root.style.opacity = "1";
    }

    // Trailing & Morphing loop
    function loop() {
      if (isVisible) {
        if (hoveredElement && document.body.contains(hoveredElement)) {
          const rect = hoveredElement.getBoundingClientRect();
          const computed = window.getComputedStyle(hoveredElement);
          const rawRadius = computed.borderRadius || "6px";

          // Target center & dimensions (enclosing the element with a clean 4px padding)
          const pad = 4;
          const targetX = rect.left + rect.width / 2;
          const targetY = rect.top + rect.height / 2;
          const targetW = rect.width + pad * 2;
          const targetH = rect.height + pad * 2;

          // Smoothly magnetic pull towards target center
          circleX += (targetX - circleX) * 0.22;
          circleY += (targetY - circleY) * 0.22;

          circle.style.width = `${targetW}px`;
          circle.style.height = `${targetH}px`;
          circle.style.borderRadius = rawRadius === "9999px" || rawRadius === "50%" ? "9999px" : `calc(${rawRadius} + 2px)`;
          circle.style.transform = `translate3d(${circleX}px, ${circleY}px, 0) translate3d(-50%, -50%, 0) ${
            isActive ? "scale(0.96)" : "scale(1)"
          }`;
        } else {
          // Free-floating circle trailing the mouse
          circleX += (mouseX - circleX) * delay;
          circleY += (mouseY - circleY) * delay;

          circle.style.width = `${baseCircleSize}px`;
          circle.style.height = `${baseCircleSize}px`;
          circle.style.borderRadius = "9999px";
          circle.style.transform = `translate3d(${circleX}px, ${circleY}px, 0) translate3d(-50%, -50%, 0) ${
            isActive ? "scale(0.85)" : "scale(1)"
          }`;
        }
      }

      animId = requestAnimationFrame(loop);
    }

    window.addEventListener("mousemove", onMouseMove, { passive: true });
    window.addEventListener("mousedown", onMouseDown, { passive: true });
    window.addEventListener("mouseup", onMouseUp, { passive: true });
    document.addEventListener("mouseleave", onMouseLeave);
    document.addEventListener("mouseenter", onMouseEnter);

    animId = requestAnimationFrame(loop);

    document.addEventListener("astro:before-swap", () => {
      if (animId) cancelAnimationFrame(animId);
      window.removeEventListener("mousemove", onMouseMove);
      window.removeEventListener("mousedown", onMouseDown);
      window.removeEventListener("mouseup", onMouseUp);
      document.removeEventListener("mouseleave", onMouseLeave);
      document.removeEventListener("mouseenter", onMouseEnter);
    }, { once: true });
  }

  initCustomCursor();
  document.addEventListener("astro:page-load", initCustomCursor);
</script>
