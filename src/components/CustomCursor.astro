---
// Custom Cursor in #B28C46 with 20px Magnetic Attraction
// - Central dot: Always visible at mouse coordinate (0 lag) across all states
// - OS native cursor: Strictly hidden (no native pointer hand)
// - Magnetic attraction: Pulls outer circle like a magnet when within 20px of encloseable elements
// - Transparent enclosing: No background color alteration (transparent fill), only 1px #B28C46 contour + soft glow
// - Header, Footer & Ritual card background: Does NOT enclose (smooth 50% opacity fade-in/out)
// - Ritual Potion Buttons, Product Cards & CTAs: Encloses exactly flush to borders (0 padding), tilts with 3D parallax
// - WhatsApp FAB & Header Cauldron button: Encloses with perfect circular shape (9999px border-radius)
// - Desktop only: Disabled on touch devices

interface Props {
  color?: string;
  circleSize?: number;
  dotSize?: number;
  borderWidth?: number;
  delayFactor?: number;
  proximity?: number;
}

const {
  color = "#B28C46",
  circleSize = 40,
  dotSize = 6,
  borderWidth = 1,
  delayFactor = 0.14,
  proximity = 100,
} = Astro.props;
---

<div
  id="reactbits-cursor-root"
  class="pointer-events-none fixed inset-0 z-[99999] hidden select-none md:block opacity-0 transition-opacity duration-300"
  data-color={color}
  data-circle-size={circleSize}
  data-dot-size={dotSize}
  data-border-width={borderWidth}
  data-delay-factor={delayFactor}
  data-proximity={proximity}
  style={`--cursor-color: ${color};`}
  aria-hidden="true"
>
  <!-- Central Dot (Always visible, 0 lag tracking) -->
  <div
    id="reactbits-cursor-dot"
    class="fixed top-0 left-0 rounded-full pointer-events-none will-change-transform z-10"
    style={`width: ${dotSize}px; height: ${dotSize}px; background-color: var(--cursor-color); box-shadow: 0 0 8px rgba(178, 140, 70, 0.9); transform: translate3d(-50%, -50%, 0);`}
  ></div>

  <!-- Outer Morphing Circle (Magnetic 20px snap, transparent background, glowing 1px contour) -->
  <div
    id="reactbits-cursor-circle"
    class="fixed top-0 left-0 pointer-events-none will-change-transform transition-[width,height,border-radius,background-color,border-color,box-shadow,opacity] duration-200 ease-out"
    style={`width: ${circleSize}px; height: ${circleSize}px; border-radius: 9999px; border: ${borderWidth}px solid var(--cursor-color); box-shadow: 0 0 12px rgba(178, 140, 70, 0.22); transform: translate3d(-50%, -50%, 0); mix-blend-mode: normal; background-color: transparent;`}
  ></div>
</div>

<style is:global>
  /* Strictly hide native cursor everywhere on fine pointer devices */
  @media (hover: hover) and (pointer: fine) {
    html,
    html body,
    html body *,
    html body *::before,
    html body *::after {
      cursor: none !important;
    }
  }

  /* Base cursor outer circle */
  #reactbits-cursor-circle {
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  /* Soft fade state: Header / Footer links & logos, and Ritual card background */
  #reactbits-cursor-circle.cursor-soft {
    opacity: 0.5 !important;
    background-color: transparent !important;
    box-shadow: 0 0 8px rgba(178, 140, 70, 0.2) !important;
  }

  /* Morph enclosing state: Pure transparent background, 1px contour with soft glow */
  #reactbits-cursor-circle.cursor-enclosing {
    background-color: transparent !important;
    border-color: var(--cursor-color) !important;
    box-shadow: 0 0 18px rgba(178, 140, 70, 0.45) !important;
  }

  /* Card / Mini card hover state: Outer circle continues englobing in background, but instantly becomes 0% opacity (completely invisible) */
  #reactbits-cursor-circle.cursor-hidden {
    opacity: 0 !important;
    visibility: hidden !important;
    transition: opacity 0s, visibility 0s !important;
  }

  /* Active / Click press state */
  #reactbits-cursor-circle.cursor-active {
    box-shadow: 0 0 14px rgba(178, 140, 70, 0.6) !important;
  }
</style>

<script>
  function initCustomCursor() {
    // Only run on desktop devices with mouse (fine pointer)
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      return;
    }

    const root = document.getElementById("reactbits-cursor-root");
    const dot = document.getElementById("reactbits-cursor-dot");
    const circle = document.getElementById("reactbits-cursor-circle");

    if (!root || !dot || !circle) return;

    const baseCircleSize = parseFloat(root.getAttribute("data-circle-size") || "40");
    const delay = parseFloat(root.getAttribute("data-delay-factor") || "0.14");
    const magneticProximity = 70; // 70px magnetic pull radius

    let mouseX = -100;
    let mouseY = -100;
    let circleX = -100;
    let circleY = -100;
    let isVisible = false;
    let hoveredEncloseEl: HTMLElement | null = null;
    let isDirectlyHovered = false;
    let isSoftHover = false;
    let isActive = false;
    let animId: number | null = null;

    // Helper to calculate exact untransformed center layout for elements
    function getUntransformedLayout(el: HTMLElement) {
      const rect = el.getBoundingClientRect();
      const style = window.getComputedStyle(el);
      const transform = style.transform;
      const w = el.offsetWidth || rect.width;
      const h = el.offsetHeight || rect.height;

      if (!transform || transform === "none") {
        return {
          cx: rect.left + rect.width / 2,
          cy: rect.top + rect.height / 2,
          w,
          h,
          radius: style.borderRadius && style.borderRadius !== "0px" ? style.borderRadius : "6px",
          transform: el.style.transform || "",
        };
      }

      try {
        const matrix = new DOMMatrix(transform);
        return {
          cx: rect.left + rect.width / 2 - (matrix.isIdentity ? 0 : matrix.m41),
          cy: rect.top + rect.height / 2 - (matrix.isIdentity ? 0 : matrix.m42),
          w,
          h,
          radius: style.borderRadius && style.borderRadius !== "0px" ? style.borderRadius : "6px",
          transform: el.style.transform || "",
        };
      } catch {
        return {
          cx: rect.left + rect.width / 2,
          cy: rect.top + rect.height / 2,
          w,
          h,
          radius: style.borderRadius && style.borderRadius !== "0px" ? style.borderRadius : "6px",
          transform: el.style.transform || "",
        };
      }
    }

    // Selectors for round circular targets (icons, FABs, close & qty buttons)
    const roundCircularSelector = `
      #modal-qty-minus, #modal-qty-plus, #modal-close-desktop, #modal-close-mobile, button[aria-label*="Fechar"], button[aria-label*="fechar"],
      .cart-item-minus, .cart-item-plus, .cart-item-remove, .cart-qty-btn, #cart-drawer-close,
      #cart-toggle-btn, .whatsapp-fab, .btn-icon-round, .deg-remove-trio-btn, .pres-remove-single-btn,
      footer a[aria-label*="WhatsApp"], footer a[aria-label*="Instagram"]
    `;

    // Selectors for soft links (Header & Footer text links and nav items -> 50% opacity fade, no rectangular enclose)
    const softLinksSelector = `
      header a:not(${roundCircularSelector}),
      header nav a,
      .header-nav-link,
      footer nav a,
      footer a:not(${roundCircularSelector}):not(.btn-primary),
      footer button:not(.btn-primary)
    `;

    // Selectors for Cards (Product cards, Kit cards, Wizard mini cards, Trio cards) -> Transparent fill on direct hover (0% opacity)
    const cardsSelector = `
      .product-card,
      .kit-mode-card,
      .deg-product-pick,
      .deg-trio-card,
      .pres-liquor-pick,
      .pres-single-card,
      .pres-acomp-pick,
      .pres-box-pick
    `;

    // Selectors for Enclosing targets (Buttons, CTAs, Inputs, Selects, Marked elements)
    const enclosingSelector = `
      button:not(#cart-toggle-btn):not(.ritual-card):not(.deg-product-pick):not(.pres-liquor-pick):not(.pres-acomp-pick):not(.pres-box-pick):not(#pick-degustacao-btn):not(#pick-presenteavel-btn),
      a.btn-primary, a.btn-ghost, a.btn-shimmer, a.btn-outline, a.btn-liquid, #modal-wa-btn,
      .glass-cta-button, .potion-suggestion-link,
      .filter-tab-btn,
      input:not([type="hidden"]), select, textarea,
      [data-cursor-enclose], ${roundCircularSelector}
    `;

    // Helper to detect if an overlay/modal (Cart Drawer, Product Modal, Admin Modals, Dialogs) is currently active/open
    function getActiveOverlayOrModal(): HTMLElement | null {
      const cartOverlay = document.getElementById("cart-drawer-overlay");
      if (cartOverlay && !cartOverlay.classList.contains("hidden") && window.getComputedStyle(cartOverlay).display !== "none") {
        return cartOverlay;
      }

      const productModal = document.getElementById("product-modal-container");
      if (productModal && !productModal.classList.contains("hidden") && window.getComputedStyle(productModal).display !== "none") {
        return productModal;
      }

      const ageGate = document.getElementById("age-gate");
      if (ageGate && !ageGate.classList.contains("hidden") && window.getComputedStyle(ageGate).display !== "none") {
        return ageGate;
      }

      const adminModals = document.querySelectorAll<HTMLElement>(
        "#modal-produto, #modal-pedido, #modal-kit, #modal-depoimento, .modal-overlay, .admin-modal, dialog[open], [role='dialog']"
      );

      for (let i = 0; i < adminModals.length; i++) {
        const el = adminModals[i];
        if (el.classList.contains("hidden")) continue;
        const style = window.getComputedStyle(el);
        if (style.display !== "none" && style.visibility !== "hidden" && style.opacity !== "0") {
          return el;
        }
      }

      return null;
    }

    // Helper to check if an element is strictly visible and not disabled
    function isTargetActuallyVisible(el: HTMLElement): boolean {
      if (el.hasAttribute('disabled') || (el as HTMLButtonElement).disabled || el.getAttribute('aria-disabled') === 'true' || el.getAttribute('data-stock') === '0') {
        return false;
      }

      // Exclude FAQ / Perguntas Frequentes elements from magnetic enclosing
      if (el.closest('.faq-trigger, .faq-item, [class*="faq-"]')) {
        return false;
      }

      const activeModal = getActiveOverlayOrModal();
      if (activeModal && !activeModal.contains(el)) {
        return false;
      }

      const rect = el.getBoundingClientRect();
      if (rect.width <= 2 || rect.height <= 2) return false;

      const style = window.getComputedStyle(el);
      if (style.display === 'none' || style.visibility === 'hidden' || style.opacity === '0' || style.pointerEvents === 'none') {
        return false;
      }

      // Check if element is completely underneath the sticky/fixed header (when no modal is active)
      if (!activeModal) {
        const header = document.querySelector('header, #site-header') as HTMLElement | null;
        if (header && !header.contains(el)) {
          const headerRect = header.getBoundingClientRect();
          if (headerRect.height > 0 && rect.bottom <= headerRect.bottom + 2) {
            return false;
          }
        }
      }

      return true;
    }

    // Helper to detect if mouse position is within the fixed/sticky header
    function isMouseOverHeader(x: number, y: number): boolean {
      const header = document.querySelector('header, #site-header') as HTMLElement | null;
      if (!header) return false;
      const rect = header.getBoundingClientRect();
      return x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;
    }

    // Magnetic proximity detection within range
    function findMagneticTarget(x: number, y: number, proximity = 70): HTMLElement | null {
      const activeModal = getActiveOverlayOrModal();
      const overHeader = isMouseOverHeader(x, y);

      // 1. Direct hit check under point
      const elUnderPoint = document.elementFromPoint(x, y) as HTMLElement | null;
      if (elUnderPoint) {
        if (activeModal && !activeModal.contains(elUnderPoint)) {
          return null;
        }
        if (overHeader && !elUnderPoint.closest('header, #site-header')) {
          return null;
        }
        if (elUnderPoint.closest(cardsSelector)) {
          return null;
        }
        if (elUnderPoint.closest(softLinksSelector)) {
          return null;
        }
        const directHit = elUnderPoint.closest(enclosingSelector) as HTMLElement | null;
        if (directHit && isTargetActuallyVisible(directHit)) return directHit;
      }

      // 2. Proximity check within range
      const candidates = document.querySelectorAll<HTMLElement>(`${enclosingSelector}, ${cardsSelector}`);
      let closest: HTMLElement | null = null;
      let minDistance = Infinity;

      for (let i = 0; i < candidates.length; i++) {
        const el = candidates[i];
        if (activeModal && !activeModal.contains(el)) continue;
        if (overHeader && !el.closest('header, #site-header')) continue;
        if (el.closest(softLinksSelector)) continue;
        if (!isTargetActuallyVisible(el)) continue;

        const rect = el.getBoundingClientRect();
        if (rect.bottom < -proximity || rect.top > window.innerHeight + proximity) continue;

        const dx = Math.max(rect.left - x, 0, x - rect.right);
        const dy = Math.max(rect.top - y, 0, y - rect.bottom);
        const dist = Math.hypot(dx, dy);

        if (dist <= proximity && dist < minDistance) {
          minDistance = dist;
          closest = el;
        }
      }

      return closest;
    }

    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!isVisible) {
        isVisible = true;
        circleX = mouseX;
        circleY = mouseY;
        root.style.opacity = "1";
      }

      // Central dot stays locked to mouse with 0 lag
      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate3d(-50%, -50%, 0) ${
        isActive ? "scale(1.3)" : "scale(1)"
      }`;

      const target = e.target as HTMLElement | null;
      const activeModal = getActiveOverlayOrModal();
      const overHeader = isMouseOverHeader(mouseX, mouseY);

      // Release body element if mouse is over header
      if (overHeader && hoveredEncloseEl && !hoveredEncloseEl.closest('header, #site-header')) {
        hoveredEncloseEl = null;
        circle.classList.remove("cursor-enclosing");
      }

      if (activeModal && target && !activeModal.contains(target)) {
        if (hoveredEncloseEl) {
          hoveredEncloseEl = null;
          circle.classList.remove("cursor-enclosing", "cursor-soft", "cursor-hidden");
        }
        return;
      }

      if (target) {
        // PRIORITY 1: Direct hit on ANY Card -> Outer circle becomes transparent (0% opacity)
        const cardTarget = target.closest(cardsSelector) as HTMLElement | null;
        if (cardTarget && isTargetActuallyVisible(cardTarget) && !overHeader) {
          isSoftHover = false;
          isDirectlyHovered = true;
          if (hoveredEncloseEl !== cardTarget) {
            hoveredEncloseEl = cardTarget;
            circle.classList.add("cursor-enclosing");
          }
          circle.classList.add("cursor-hidden");
          return;
        }

        // PRIORITY 2: Direct hit on Enclosing target (Buttons, Inputs, Icons)
        const directEnclose = target.closest(enclosingSelector) as HTMLElement | null;
        if (directEnclose && isTargetActuallyVisible(directEnclose)) {
          if (!overHeader || directEnclose.closest('header, #site-header')) {
            isSoftHover = false;
            isDirectlyHovered = true;
            circle.classList.remove("cursor-hidden", "cursor-soft");
            if (hoveredEncloseEl !== directEnclose) {
              hoveredEncloseEl = directEnclose;
              circle.classList.add("cursor-enclosing");
            }
            return;
          }
        }

        // PRIORITY 3: Direct hit on Soft Hover element (Header/Footer text links) -> 50% opacity
        const softTarget = target.closest(softLinksSelector) as HTMLElement | null;
        if (softTarget && !activeModal) {
          isDirectlyHovered = false;
          circle.classList.remove("cursor-hidden");
          if (hoveredEncloseEl) {
            hoveredEncloseEl = null;
            circle.classList.remove("cursor-enclosing");
          }
          if (!isSoftHover) {
            isSoftHover = true;
            circle.classList.add("cursor-soft");
          }
          return;
        }
      }

      if (isSoftHover) {
        isSoftHover = false;
        circle.classList.remove("cursor-soft");
      }

      circle.classList.remove("cursor-hidden");

      // PRIORITY 4: Proximity check (Magnetic pull)
      const magneticTarget = findMagneticTarget(mouseX, mouseY, magneticProximity);

      if (magneticTarget) {
        isDirectlyHovered = false;
        circle.classList.remove("cursor-hidden", "cursor-soft");
        if (hoveredEncloseEl !== magneticTarget) {
          hoveredEncloseEl = magneticTarget;
          circle.classList.add("cursor-enclosing");
        }
      } else if (hoveredEncloseEl) {
        isDirectlyHovered = false;
        hoveredEncloseEl = null;
        circle.classList.remove("cursor-enclosing", "cursor-soft", "cursor-hidden");
      }
    }

    function onMouseDown() {
      isActive = true;
      circle.classList.add("cursor-active");
    }

    function onMouseUp() {
      isActive = false;
      circle.classList.remove("cursor-active");
    }

    function onMouseLeave() {
      isVisible = false;
      root.style.opacity = "0";
      hoveredEncloseEl = null;
      isDirectlyHovered = false;
      isSoftHover = false;
      circle.classList.remove("cursor-enclosing", "cursor-soft", "cursor-active", "cursor-hidden");
    }

    function onMouseEnter() {
      isVisible = true;
      root.style.opacity = "1";
    }

    // Smooth Trailing & Morphing loop
    function loop() {
      if (isVisible) {
        if (circle.classList.contains("cursor-hidden")) {
          circle.style.opacity = "0";
          circle.style.visibility = "hidden";
        } else if (circle.classList.contains("cursor-soft")) {
          circle.style.opacity = "0.5";
          circle.style.visibility = "visible";
        } else {
          circle.style.opacity = "1";
          circle.style.visibility = "visible";
        }

        if (hoveredEncloseEl && document.body.contains(hoveredEncloseEl) && isTargetActuallyVisible(hoveredEncloseEl)) {
          if (isMouseOverHeader(mouseX, mouseY) && !hoveredEncloseEl.closest('header, #site-header')) {
            hoveredEncloseEl = null;
            circle.classList.remove("cursor-enclosing");
            circle.style.width = `${baseCircleSize}px`;
            circle.style.height = `${baseCircleSize}px`;
            circle.style.borderRadius = "9999px";
            return;
          }

          const isRound = hoveredEncloseEl.matches(roundCircularSelector);
          const layout = getUntransformedLayout(hoveredEncloseEl);

          if (isDirectlyHovered) {
            circleX = layout.cx;
            circleY = layout.cy;
          } else {
            circleX += (layout.cx - circleX) * 0.28;
            circleY += (layout.cy - circleY) * 0.28;
          }

          if (isRound) {
            const roundDimension = Math.max(layout.w, layout.h, 40);
            circle.style.width = `${roundDimension}px`;
            circle.style.height = `${roundDimension}px`;
            circle.style.borderRadius = "9999px";
            circle.style.transform = `translate3d(${circleX}px, ${circleY}px, 0) translate3d(-50%, -50%, 0) ${
              isActive ? "scale(0.97)" : "scale(1)"
            }`;
          } else {
            circle.style.width = `${layout.w}px`;
            circle.style.height = `${layout.h}px`;
            circle.style.borderRadius = layout.radius;

            if (layout.transform && layout.transform !== "none") {
              circle.style.transform = `translate3d(${circleX}px, ${circleY}px, 0) ${layout.transform} translate3d(-50%, -50%, 0) ${
                isActive ? "scale(0.98)" : "scale(1)"
              }`;
            } else {
              circle.style.transform = `translate3d(${circleX}px, ${circleY}px, 0) translate3d(-50%, -50%, 0) ${
                isActive ? "scale(0.98)" : "scale(1)"
              }`;
            }
          }
        } else {
          if (hoveredEncloseEl) {
            hoveredEncloseEl = null;
            circle.classList.remove("cursor-enclosing");
          }

          circleX += (mouseX - circleX) * delay;
          circleY += (mouseY - circleY) * delay;

          circle.style.width = `${baseCircleSize}px`;
          circle.style.height = `${baseCircleSize}px`;
          circle.style.borderRadius = "9999px";
          circle.style.transform = `translate3d(${circleX}px, ${circleY}px, 0) translate3d(-50%, -50%, 0) ${
            isActive ? "scale(0.85)" : "scale(1)"
          }`;
        }
      }

      animId = requestAnimationFrame(loop);
    }

    window.addEventListener("mousemove", onMouseMove, { passive: true });
    window.addEventListener("mousedown", onMouseDown, { passive: true });
    window.addEventListener("mouseup", onMouseUp, { passive: true });
    document.addEventListener("mouseleave", onMouseLeave);
    document.addEventListener("mouseenter", onMouseEnter);

    animId = requestAnimationFrame(loop);

    document.addEventListener("astro:before-swap", () => {
      if (animId) cancelAnimationFrame(animId);
      window.removeEventListener("mousemove", onMouseMove);
      window.removeEventListener("mousedown", onMouseDown);
      window.removeEventListener("mouseup", onMouseUp);
      document.removeEventListener("mouseleave", onMouseLeave);
      document.removeEventListener("mouseenter", onMouseEnter);
    }, { once: true });
  }

  initCustomCursor();
  document.addEventListener("astro:page-load", initCustomCursor);
</script>
