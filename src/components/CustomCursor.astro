---
// Custom Cursor — Exact React Bits Configuration in #B28C46
// Settings from Configuration Panel:
// - Circle Size: 40px
// - Dot Size: 6px
// - Circle Border Width: 2px
// - Mix Blend Mode: normal
// - Circle Stiffness: 150
// - Circle Damping: 20
// - Dot Stiffness: 300
// - Dot Damping: 30
// - Target Padding: 0px
// - Elastic Stretch: enabled
// - Show on Touch: disabled
// - Show Custom Content: disabled
// - Color: #B28C46

interface Props {
  color?: string;
  circleSize?: number;
  dotSize?: number;
  borderWidth?: number;
  circleStiffness?: number;
  circleDamping?: number;
  dotStiffness?: number;
  dotDamping?: number;
  elasticStretch?: boolean;
}

const {
  color = "#B28C46",
  circleSize = 40,
  dotSize = 6,
  borderWidth = 2,
  circleStiffness = 150,
  circleDamping = 20,
  dotStiffness = 300,
  dotDamping = 30,
  elasticStretch = true,
} = Astro.props;
---

<div
  id="reactbits-cursor-root"
  class="pointer-events-none fixed inset-0 z-[99999] hidden select-none md:block opacity-0 transition-opacity duration-300"
  data-color={color}
  data-circle-size={circleSize}
  data-dot-size={dotSize}
  data-border-width={borderWidth}
  data-circle-stiffness={circleStiffness}
  data-circle-damping={circleDamping}
  data-dot-stiffness={dotStiffness}
  data-dot-damping={dotDamping}
  data-elastic-stretch={elasticStretch ? "true" : "false"}
  style={`--cursor-color: ${color};`}
  aria-hidden="true"
>
  <!-- Dot (6px, 300 stiffness, 30 damping) -->
  <div
    id="reactbits-cursor-dot"
    class="fixed top-0 left-0 rounded-full pointer-events-none will-change-transform"
    style={`width: ${dotSize}px; height: ${dotSize}px; background-color: var(--cursor-color); box-shadow: 0 0 8px rgba(178, 140, 70, 0.7); transform: translate3d(-50%, -50%, 0);`}
  ></div>

  <!-- Circle (40px, 2px border, 150 stiffness, 20 damping, elastic stretch) -->
  <div
    id="reactbits-cursor-circle"
    class="fixed top-0 left-0 rounded-full pointer-events-none will-change-transform transition-[background-color,border-color,box-shadow] duration-200 ease-out"
    style={`width: ${circleSize}px; height: ${circleSize}px; border: ${borderWidth}px solid var(--cursor-color); box-shadow: 0 0 14px rgba(178, 140, 70, 0.22); transform: translate3d(-50%, -50%, 0); mix-blend-mode: normal;`}
  ></div>
</div>

<style>
  /* Hide OS native cursor on fine pointer devices */
  @media (hover: hover) and (pointer: fine) {
    html,
    body,
    a,
    button,
    [role="button"],
    [role="link"],
    summary,
    label[for],
    select,
    input,
    textarea,
    .cursor-pointer,
    .cursor-default {
      cursor: none !important;
    }
  }

  /* Circle Hover and Active States */
  #reactbits-cursor-circle.cursor-hover {
    background-color: rgba(178, 140, 70, 0.16);
    box-shadow: 0 0 22px rgba(178, 140, 70, 0.5), inset 0 0 10px rgba(178, 140, 70, 0.12);
  }

  #reactbits-cursor-circle.cursor-active {
    background-color: rgba(178, 140, 70, 0.3);
  }

  #reactbits-cursor-dot.cursor-hover {
    opacity: 0.5;
  }
</style>

<script>
  class Spring {
    pos: number;
    vel: number;
    stiffness: number;
    damping: number;

    constructor(stiffness: number, damping: number, initial = 0) {
      this.pos = initial;
      this.vel = 0;
      this.stiffness = stiffness;
      this.damping = damping;
    }

    update(target: number, dt: number) {
      const force = -this.stiffness * (this.pos - target) - this.damping * this.vel;
      this.vel += force * dt;
      this.pos += this.vel * dt;
      return this.pos;
    }
  }

  function initReactBitsCursor() {
    // Only on fine pointer devices (desktop with mouse)
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      return;
    }

    const root = document.getElementById("reactbits-cursor-root");
    const dot = document.getElementById("reactbits-cursor-dot");
    const circle = document.getElementById("reactbits-cursor-circle");

    if (!root || !dot || !circle) return;

    const circleSize = parseFloat(root.getAttribute("data-circle-size") || "40");
    const cStiff = parseFloat(root.getAttribute("data-circle-stiffness") || "150");
    const cDamp = parseFloat(root.getAttribute("data-circle-damping") || "20");
    const dStiff = parseFloat(root.getAttribute("data-dot-stiffness") || "300");
    const dDamp = parseFloat(root.getAttribute("data-dot-damping") || "30");
    const isElastic = root.getAttribute("data-elastic-stretch") === "true";

    let targetX = -100;
    let targetY = -100;
    let isVisible = false;
    let isHovering = false;
    let isActive = false;
    let lastTime = performance.now();
    let animId: number | null = null;

    const dotSpringX = new Spring(dStiff, dDamp, targetX);
    const dotSpringY = new Spring(dStiff, dDamp, targetY);
    const circleSpringX = new Spring(cStiff, cDamp, targetX);
    const circleSpringY = new Spring(cStiff, cDamp, targetY);

    const interactiveSelector = `
      a, button, [role="button"], [role="link"], summary, label[for],
      select, input:not([type="hidden"]), textarea, .cursor-pointer,
      .product-card, .ritual-card, .filter-tab-btn, [tabindex="0"]
    `;

    function onMouseMove(e: MouseEvent) {
      targetX = e.clientX;
      targetY = e.clientY;

      if (!isVisible) {
        isVisible = true;
        dotSpringX.pos = targetX;
        dotSpringY.pos = targetY;
        circleSpringX.pos = targetX;
        circleSpringY.pos = targetY;
        root.style.opacity = "1";
      }

      const target = e.target as HTMLElement | null;
      if (target && target.closest(interactiveSelector)) {
        if (!isHovering) {
          isHovering = true;
          circle.classList.add("cursor-hover");
          dot.classList.add("cursor-hover");
        }
      } else if (isHovering) {
        isHovering = false;
        circle.classList.remove("cursor-hover");
        dot.classList.remove("cursor-hover");
      }
    }

    function onMouseDown() {
      isActive = true;
      circle.classList.add("cursor-active");
    }

    function onMouseUp() {
      isActive = false;
      circle.classList.remove("cursor-active");
    }

    function onMouseLeave() {
      isVisible = false;
      root.style.opacity = "0";
    }

    function onMouseEnter() {
      isVisible = true;
      root.style.opacity = "1";
    }

    function loop(time: number) {
      const dt = Math.min((time - lastTime) / 1000, 0.032);
      lastTime = time;

      if (isVisible) {
        const dotX = dotSpringX.update(targetX, dt);
        const dotY = dotSpringY.update(targetY, dt);
        const circX = circleSpringX.update(targetX, dt);
        const circY = circleSpringY.update(targetY, dt);

        dot.style.transform = `translate3d(${dotX}px, ${dotY}px, 0) translate3d(-50%, -50%, 0) ${
          isActive ? "scale(1.4)" : isHovering ? "scale(0.5)" : "scale(1)"
        }`;

        // Calculate Elastic Stretch based on circle velocity
        let stretchTransform = "";
        if (isElastic && !isActive) {
          const vx = circleSpringX.vel;
          const vy = circleSpringY.vel;
          const speed = Math.hypot(vx, vy);
          if (speed > 40) {
            const angle = Math.atan2(vy, vx) * (180 / Math.PI);
            const stretch = Math.min(speed / 900, 0.45);
            const scaleX = (1 + stretch) * (isHovering ? 1.35 : 1);
            const scaleY = (1 / (1 + stretch)) * (isHovering ? 1.35 : 1);
            stretchTransform = `rotate(${angle}deg) scale(${scaleX}, ${scaleY}) rotate(${-angle}deg)`;
          } else if (isHovering) {
            stretchTransform = "scale(1.35)";
          }
        } else if (isActive) {
          stretchTransform = "scale(0.8)";
        } else if (isHovering) {
          stretchTransform = "scale(1.35)";
        }

        circle.style.transform = `translate3d(${circX}px, ${circY}px, 0) translate3d(-50%, -50%, 0) ${stretchTransform}`;
      }

      animId = requestAnimationFrame(loop);
    }

    window.addEventListener("mousemove", onMouseMove, { passive: true });
    window.addEventListener("mousedown", onMouseDown, { passive: true });
    window.addEventListener("mouseup", onMouseUp, { passive: true });
    document.addEventListener("mouseleave", onMouseLeave);
    document.addEventListener("mouseenter", onMouseEnter);

    animId = requestAnimationFrame(loop);

    document.addEventListener("astro:before-swap", () => {
      if (animId) cancelAnimationFrame(animId);
      window.removeEventListener("mousemove", onMouseMove);
      window.removeEventListener("mousedown", onMouseDown);
      window.removeEventListener("mouseup", onMouseUp);
      document.removeEventListener("mouseleave", onMouseLeave);
      document.removeEventListener("mouseenter", onMouseEnter);
    }, { once: true });
  }

  initReactBitsCursor();
  document.addEventListener("astro:page-load", initReactBitsCursor);
</script>
