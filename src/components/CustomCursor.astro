---
// Custom Cursor Component — React Bits / Shadcn Specification in #B28C46
// Docs: https://pro.reactbits.dev/docs/components/custom-cursor

interface Props {
  color?: string;
  dotSize?: number;
  ringSize?: number;
  hoverScale?: number;
  smoothness?: number;
  hideNativeCursor?: boolean;
  className?: string;
}

const {
  color = "#B28C46",
  dotSize = 8,
  ringSize = 34,
  hoverScale = 1.6,
  smoothness = 0.18,
  hideNativeCursor = true,
  className = "",
} = Astro.props;
---

<div
  id="custom-cursor-root"
  class={`pointer-events-none fixed inset-0 z-[99999] hidden select-none md:block opacity-0 transition-opacity duration-300 ${className}`}
  data-color={color}
  data-dot-size={dotSize}
  data-ring-size={ringSize}
  data-hover-scale={hoverScale}
  data-smoothness={smoothness}
  data-hide-native={hideNativeCursor ? "true" : "false"}
  style={`--cursor-color: ${color};`}
  aria-hidden="true"
>
  <!-- Inner Precision Dot -->
  <div
    id="custom-cursor-dot"
    class="fixed top-0 left-0 rounded-full pointer-events-none will-change-transform"
    style={`width: ${dotSize}px; height: ${dotSize}px; background-color: var(--cursor-color); box-shadow: 0 0 10px rgba(178, 140, 70, 0.8); transform: translate3d(-50%, -50%, 0);`}
  ></div>

  <!-- Outer Spring / Follower Ring with Target Morphing -->
  <div
    id="custom-cursor-ring"
    class="fixed top-0 left-0 rounded-full pointer-events-none will-change-transform transition-[width,height,background-color,border-color,box-shadow,opacity,border-radius] duration-250 ease-out"
    style={`width: ${ringSize}px; height: ${ringSize}px; border: 1.5px solid rgba(178, 140, 70, 0.6); box-shadow: 0 0 14px rgba(178, 140, 70, 0.25); transform: translate3d(-50%, -50%, 0);`}
  >
    <span
      id="custom-cursor-label"
      class="absolute inset-0 flex items-center justify-center font-mono text-[9px] uppercase tracking-wider text-[var(--cream)] opacity-0 transition-opacity duration-200"
    ></span>
  </div>
</div>

<style>
  /* Hide native cursor globally on fine pointer devices when enabled */
  @media (hover: hover) and (pointer: fine) {
    html:has(#custom-cursor-root[data-hide-native="true"]),
    html:has(#custom-cursor-root[data-hide-native="true"]) * {
      cursor: none !important;
    }
  }

  /* Ring Interactive Morph States */
  #custom-cursor-ring.cursor-hover {
    background-color: rgba(178, 140, 70, 0.14);
    border-color: var(--cursor-color);
    box-shadow: 0 0 24px rgba(178, 140, 70, 0.5), inset 0 0 12px rgba(178, 140, 70, 0.1);
  }

  #custom-cursor-ring.cursor-active {
    transform: translate3d(-50%, -50%, 0) scale(0.8) !important;
    background-color: rgba(178, 140, 70, 0.28);
    border-color: var(--cursor-color);
  }

  #custom-cursor-ring.cursor-has-label {
    width: 4.5rem !important;
    height: 4.5rem !important;
    background-color: rgba(16, 13, 11, 0.85);
    border-color: var(--cursor-color);
    box-shadow: 0 0 30px rgba(178, 140, 70, 0.6);
  }

  #custom-cursor-ring.cursor-has-label #custom-cursor-label {
    opacity: 1;
  }

  #custom-cursor-dot.cursor-hover {
    transform: translate3d(-50%, -50%, 0) scale(0.4) !important;
    opacity: 0.5;
  }

  #custom-cursor-dot.cursor-active {
    transform: translate3d(-50%, -50%, 0) scale(1.5) !important;
    opacity: 1;
  }

  #custom-cursor-dot.cursor-hidden {
    opacity: 0 !important;
  }
</style>

<script>
  function setupCustomCursor() {
    // Check fine pointer media query (desktop with mouse)
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      return;
    }

    const root = document.getElementById("custom-cursor-root");
    const dot = document.getElementById("custom-cursor-dot");
    const ring = document.getElementById("custom-cursor-ring");
    const label = document.getElementById("custom-cursor-label");

    if (!root || !dot || !ring || !label) return;

    const baseRingSize = parseFloat(root.getAttribute("data-ring-size") || "34");
    const hoverScale = parseFloat(root.getAttribute("data-hover-scale") || "1.6");
    const smoothness = parseFloat(root.getAttribute("data-smoothness") || "0.18");

    let mouseX = -100;
    let mouseY = -100;
    let ringX = -100;
    let ringY = -100;
    let isVisible = false;
    let isHovering = false;
    let isActive = false;
    let hasLabel = false;
    let animId: number | null = null;

    const interactiveSelector = `
      a, button, [role="button"], [role="link"], summary, label[for],
      select, input:not([type="hidden"]), textarea, .cursor-pointer,
      .product-card, .ritual-card, .filter-tab-btn, [data-cursor], [tabindex="0"]
    `;

    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!isVisible) {
        isVisible = true;
        ringX = mouseX;
        ringY = mouseY;
        root.style.opacity = "1";
      }

      // Zero-latency Dot tracking
      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate3d(-50%, -50%, 0) ${
        isActive ? "scale(1.5)" : isHovering ? "scale(0.4)" : "scale(1)"
      }`;

      // Target Detection & Morphing
      const target = e.target as HTMLElement | null;
      const interactiveEl = target ? target.closest(interactiveSelector) as HTMLElement | null : null;

      if (interactiveEl) {
        if (!isHovering) {
          isHovering = true;
          ring.classList.add("cursor-hover");
          dot.classList.add("cursor-hover");
        }

        // Check custom label data attribute (e.g. data-cursor-text="Abrir")
        const customText = interactiveEl.getAttribute("data-cursor-text");
        if (customText) {
          label.textContent = customText;
          hasLabel = true;
          ring.classList.add("cursor-has-label");
          dot.classList.add("cursor-hidden");
        } else if (hasLabel) {
          hasLabel = false;
          label.textContent = "";
          ring.classList.remove("cursor-has-label");
          dot.classList.remove("cursor-hidden");
        }
      } else {
        if (isHovering) {
          isHovering = false;
          ring.classList.remove("cursor-hover");
          dot.classList.remove("cursor-hover");
        }
        if (hasLabel) {
          hasLabel = false;
          label.textContent = "";
          ring.classList.remove("cursor-has-label");
          dot.classList.remove("cursor-hidden");
        }
      }
    }

    function onMouseDown() {
      isActive = true;
      ring.classList.add("cursor-active");
      dot.classList.add("cursor-active");
    }

    function onMouseUp() {
      isActive = false;
      ring.classList.remove("cursor-active");
      dot.classList.remove("cursor-active");
    }

    function onMouseLeave() {
      isVisible = false;
      root.style.opacity = "0";
    }

    function onMouseEnter() {
      isVisible = true;
      root.style.opacity = "1";
    }

    // Spring/Lerp Loop for outer ring
    function render() {
      if (isVisible) {
        ringX += (mouseX - ringX) * smoothness;
        ringY += (mouseY - ringY) * smoothness;

        const currentScale = isHovering && !hasLabel ? hoverScale : 1;
        const width = baseRingSize * currentScale;
        const height = baseRingSize * currentScale;

        if (!hasLabel) {
          ring.style.width = `${width}px`;
          ring.style.height = `${height}px`;
        }

        ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate3d(-50%, -50%, 0) ${
          isActive ? "scale(0.8)" : ""
        }`;
      }

      animId = requestAnimationFrame(render);
    }

    window.addEventListener("mousemove", onMouseMove, { passive: true });
    window.addEventListener("mousedown", onMouseDown, { passive: true });
    window.addEventListener("mouseup", onMouseUp, { passive: true });
    document.addEventListener("mouseleave", onMouseLeave);
    document.addEventListener("mouseenter", onMouseEnter);

    animId = requestAnimationFrame(render);

    document.addEventListener("astro:before-swap", () => {
      if (animId) cancelAnimationFrame(animId);
      window.removeEventListener("mousemove", onMouseMove);
      window.removeEventListener("mousedown", onMouseDown);
      window.removeEventListener("mouseup", onMouseUp);
      document.removeEventListener("mouseleave", onMouseLeave);
      document.removeEventListener("mouseenter", onMouseEnter);
    }, { once: true });
  }

  setupCustomCursor();
  document.addEventListener("astro:page-load", setupCustomCursor);
</script>
