---
import type { Product } from '../lib/data';
import { fmtPrice, categoriaLabel, needsPrep } from '../lib/data';
import CauldronIcon from './CauldronIcon.astro';
import Badge from './Badge.astro';

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
const isOutOfStock = p.estoque <= 0;
const hasPrep = needsPrep(p);
---

<div
  class="product-card group relative flex flex-col md:block aspect-auto md:aspect-[4/5] bg-[var(--surface)] border border-[rgba(178,140,70,0.2)] rounded-md overflow-hidden hover:border-[#B28C46] cursor-pointer select-none"
  data-product={JSON.stringify(p)}
>
  <!-- Dynamic Glare Light on Hover -->
  <div class="product-glare pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 rounded-md z-30"></div>

  <!-- IMAGE LAYER -->
  <div
    class={`relative w-full aspect-square md:absolute md:inset-x-0 md:top-0 md:h-[70%] md:aspect-auto md:w-auto bg-gradient-to-b from-[var(--surface-elevated)] to-[var(--background)] overflow-hidden transition-[height,opacity] duration-700 ease-out md:group-hover:h-full md:group-hover:opacity-35 ${
      isOutOfStock ? "opacity-80" : ""
    }`}
  >
    <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 bg-[radial-gradient(circle_at_50%_0%,_rgba(184,111,42,0.35)_0%,_transparent_60%)] z-10"></div>
    
    {p.foto_url ? (
      <img
        src={p.foto_url}
        alt={p.nome}
        loading="lazy"
        decoding="async"
        class="product-img w-full h-full object-cover transition-transform duration-700"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-[var(--gold)]/30 text-7xl">⚗</div>
    )}

    {/* Top Badges */}
    <div class="hidden md:flex absolute top-3 left-3 z-20 gap-1.5 pointer-events-none">
      <Badge variant="gold" size="sm">
        {categoriaLabel(p.categoria)}
      </Badge>
    </div>

    {hasPrep && !isOutOfStock && (
      <div class="absolute top-3 right-3 z-20 pointer-events-none">
        <Badge variant="ember" size="sm">
          Sob Encomenda
        </Badge>
      </div>
    )}

    {isOutOfStock && (
      <div class="absolute inset-0 z-20 flex items-center justify-center bg-black/35 backdrop-blur-[0.5px]">
        <Badge variant="ember" size="md" class="shadow-2xl font-bold uppercase tracking-widest scale-105">
          Lote Esgotado
        </Badge>
      </div>
    )}

    <!-- MOBILE: Overlay inside image square -->
    <div class="md:hidden absolute inset-x-0 bottom-0 pt-8 px-3 pb-2 bg-gradient-to-t from-black/90 via-black/60 to-transparent pointer-events-none">
      <div class="font-mono text-[10px] text-[var(--gold)] tracking-widest uppercase">
        {categoriaLabel(p.categoria)}
      </div>
      <div class="font-serif text-sm text-[var(--cream)] mt-0.5 leading-tight font-medium">
        {p.sabor}
      </div>
    </div>
  </div>

  <!-- MOBILE: Bottom bar with price & quick add -->
  <div class="md:hidden relative h-11 px-3 flex items-center justify-between bg-[var(--surface)] border-t border-[var(--gold)]/15">
    <div class="font-display font-semibold text-sm sm:text-base text-[var(--gold)]">{fmtPrice(p.preco)}</div>
    {!isOutOfStock && (
      <button
        type="button"
        class="quick-add-btn w-7.5 h-7.5 flex items-center justify-center border border-[var(--gold)]/40 text-[var(--gold)] hover:bg-[var(--gold)] hover:text-[var(--background)] transition-colors rounded-md"
        title="Adicionar ao caldeirão"
        aria-label="Adicionar ao caldeirão"
        data-id={p.id}
      >
        <CauldronIcon className="w-3.5 h-3.5" />
      </button>
    )}
  </div>

  <!-- DESKTOP: Bottom Info Layer -->
  <div class="hidden md:block absolute inset-x-0 bottom-0 p-4 pt-2.5 bg-[var(--surface)] transition-colors duration-700 md:group-hover:bg-transparent">
    <h3 class="font-display font-semibold text-base lg:text-lg text-[var(--gold)] tracking-wider leading-tight">
      {p.nome}
    </h3>
    <div class="font-serif italic text-sm text-[var(--gold-soft)] mt-0.5 font-medium">{p.sabor}</div>
    <div class="flex items-end justify-between mt-2 pt-2 border-t border-[var(--gold)]/15">
      <div class="font-display font-bold text-lg lg:text-xl text-[var(--gold)]">{fmtPrice(p.preco)}</div>
      {!isOutOfStock && (
        <button
          type="button"
          class="quick-add-btn w-8.5 h-8.5 flex items-center justify-center border border-[var(--gold)]/40 text-[var(--gold)] bg-[var(--surface)]/80 hover:bg-[var(--gold)] hover:text-[var(--background)] transition-colors rounded-md backdrop-blur-sm shadow-md"
          title="Adicionar ao caldeirão"
          aria-label="Adicionar ao caldeirão"
          data-id={p.id}
        >
          <CauldronIcon className="w-4 h-4" />
        </button>
      )}
    </div>
  </div>
</div>

<style>
  .product-card {
    transform-style: preserve-3d;
    perspective: 900px;
    will-change: transform, box-shadow, border-color;
    transition: transform 0.4s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.4s cubic-bezier(0.2, 0, 0.2, 1), border-color 0.35s ease;
  }
  .product-card:hover {
    border-color: #B28C46 !important;
    transition: transform 0.12s ease-out, box-shadow 0.12s ease-out, border-color 0s !important;
  }
  .product-card .product-img {
    will-change: transform;
  }
</style>

<script>
  function initProductCardParallax() {
    // Enable only on desktop pointer devices
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;

    const cards = document.querySelectorAll<HTMLElement>(".product-card");

    cards.forEach((card) => {
      if (card.dataset.parallaxInit === "true") return;
      card.dataset.parallaxInit = "true";

      const img = card.querySelector<HTMLElement>(".product-img");
      const glare = card.querySelector<HTMLElement>(".product-glare");

      let rafId = 0;

      function onMouseMove(e: MouseEvent) {
        cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          const rect = card.getBoundingClientRect();
          const normX = (e.clientX - rect.left) / rect.width - 0.5; // -0.5 to 0.5
          const normY = (e.clientY - rect.top) / rect.height - 0.5; // -0.5 to 0.5

          const rotX = (-normY * 11).toFixed(2);
          const rotY = (normX * 11).toFixed(2);

          card.style.borderColor = "#B28C46";
          card.style.transform = `perspective(900px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-6px)`;
          card.style.boxShadow = `${(-normX * 18).toFixed(1)}px ${(-normY * 18 + 18).toFixed(1)}px 32px -5px rgba(0, 0, 0, 0.75), 0 0 18px rgba(178, 140, 70, 0.42)`;

          if (img) {
            img.style.transform = `translate3d(${(-normX * 10).toFixed(1)}px, ${(-normY * 10).toFixed(1)}px, 0px) scale(1.08)`;
          }

          if (glare) {
            glare.style.opacity = "1";
            glare.style.background = `radial-gradient(circle 130px at ${((normX + 0.5) * 100).toFixed(1)}% ${((normY + 0.5) * 100).toFixed(1)}%, rgba(212, 178, 58, 0.16) 0%, rgba(200, 169, 126, 0.04) 40%, transparent 80%)`;
          }
        });
      }

      function onMouseEnter() {
        card.style.borderColor = "#B28C46";
        card.style.boxShadow = "0 0 18px rgba(178, 140, 70, 0.42)";
        card.style.transition = "transform 0.12s ease-out, box-shadow 0.12s ease-out, border-color 0s";
        if (img) img.style.transition = "transform 0.12s ease-out";
      }

      function onMouseLeave() {
        cancelAnimationFrame(rafId);
        card.style.transition = "transform 0.5s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.5s cubic-bezier(0.2, 0, 0.2, 1), border-color 0.4s ease";
        card.style.transform = "perspective(900px) rotateX(0deg) rotateY(0deg) translateY(0)";
        card.style.boxShadow = "";
        card.style.borderColor = "";

        if (img) {
          img.style.transition = "transform 0.5s cubic-bezier(0.2, 0, 0.2, 1)";
          img.style.transform = "translate3d(0, 0, 0) scale(1)";
        }

        if (glare) {
          glare.style.opacity = "0";
        }
      }

      card.addEventListener("mousemove", onMouseMove);
      card.addEventListener("mouseenter", onMouseEnter);
      card.addEventListener("mouseleave", onMouseLeave);
    });
  }

  initProductCardParallax();
  document.addEventListener("astro:page-load", initProductCardParallax);
  window.addEventListener("products-rendered", initProductCardParallax);
</script>
